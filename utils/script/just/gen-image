#!/usr/bin/env bash
# 构建 NixOS 镜像并同步到 pve；用法: gen-image <host> <format>
set -e
host="${1:?用法: gen-image <host> <format>}"
format="${2:?用法: gen-image <host> <format>}"
nom build ".#nixosConfigurations.$host.config.system.build.images.$format"
d=$(readlink -f result)
suffix="${d##*.}"
ls -hl "$d"
rsync -avPL --checksum result "pve:/var/lib/vz/template/iso/$host-latest.$suffix"
