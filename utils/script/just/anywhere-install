#!/usr/bin/env bash
set -euo pipefail
host="${1:?用法: anywhere-install <主机> <目标地址> [extra-files 目录]}"
target="${2:?用法: anywhere-install <主机> <目标地址> [extra-files 目录]}"
extra="${3:-}"

command -v nixos-anywhere >/dev/null || { echo "PATH 里没有 nixos-anywhere：先 nix develop" >&2; exit 1; }
[[ -z "$extra" || -d "$extra" ]] || { echo "extra-files 目录不存在: $extra" >&2; exit 1; }
# Finder 打开过的目录会冒出 .DS_Store，不清就被拷进目标的 /、/etc 等处
[[ -z "$extra" ]] || find "$extra" -name .DS_Store -delete

eval_setting() {
    nix eval --raw ".#nixosConfigurations.${host}.config.nix.settings.$1" --apply 'builtins.concatStringsSep " "'
}
substituters=$(eval_setting substituters)
keys=$(eval_setting trusted-public-keys)
timeout=$(nix eval ".#nixosConfigurations.${host}.config.nix.settings.connect-timeout" 2>/dev/null || echo 5)

ssh_opts=(-o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -o LogLevel=ERROR)
ssh "${ssh_opts[@]}" "root@${target}" '[ "$(hostname)" = nixos-installer ]' ||
    { echo "$target 不在 nixos-anywhere 安装环境里：先跑阶段一 kexec" >&2; exit 1; }
ssh "${ssh_opts[@]}" "root@${target}" "mkdir -p ~/.config/nix && cat > ~/.config/nix/nix.conf" <<EOF
substituters = ${substituters}
trusted-public-keys = ${keys}
connect-timeout = ${timeout}
EOF
echo "安装环境 substituters: $(ssh "${ssh_opts[@]}" "root@${target}" 'nix config show substituters')" >&2

args=(-f ".#${host}" --target-host "root@${target}" --build-on remote
    --no-use-machine-substituters --phases "${PHASES:-disko,install,reboot}")
[[ -n "$extra" ]] && args+=(--extra-files "$extra")
exec nixos-anywhere "${args[@]}"
