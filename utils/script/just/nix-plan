#!/usr/bin/env python3
"""构建前摘要：统计待构建派生、待下载路径与工具链引入源。"""

import json
import os
import re
import subprocess
import sys

TOOLCHAIN_OUT_RE = re.compile(
    r"^(rustc|cargo|llvm|clang|gcc|go|ghc|swift|swiftc|swiftpm|swift-build|zig|cmake|meson|ninja|openjdk|jdk|nodejs)(-wrapper|-auditable)?-[0-9]"
)
NON_COMPILER_SUFFIX_RE = re.compile(r"-(lib|libgcc|doc|man|info|data)$")
CC_STDENV_RE = re.compile(r"^stdenv-(linux|darwin)(?!-no-cc)")
COMPILER_INPUT_RE = re.compile(
    r"^(rustc|cargo|go|ghc|swift|swiftc|swiftpm|zig|gcc|clang|nodejs|openjdk|jdk|gradle|maven|cmake|meson|ninja)(-wrapper)?-[0-9]"
)
TOOLCHAIN_DRV_RE = re.compile(
    r"^(rustc|cargo|llvm|clang|gcc|go|ghc|swift|swiftc|swiftpm|swift-build|zig|cmake|meson|ninja|openjdk|jdk|gradle|maven|nodejs|stdenv-(linux|darwin)(?!-no-cc))"
)
LANG_RULES: list[tuple[re.Pattern[str], str]] = [
    (re.compile(r"(^| )(rustc|cargo)-"), "rust"),
    (re.compile(r"(^| )go-[0-9]"), "go"),
    (re.compile(r"(^| )ghc-"), "haskell"),
    (re.compile(r"(^| )(swift|swiftc|swiftpm)-"), "swift"),
    (re.compile(r"(^| )zig-"), "zig"),
    (re.compile(r"(^| )(openjdk|jdk|gradle|maven)"), "java"),
    (re.compile(r"(^| )nodejs-"), "node"),
    (re.compile(r"(^| )(gcc|clang)(-wrapper)?-[0-9]"), "c/c++"),
    (re.compile(r"(^| )stdenv-(linux|darwin)(?!-no-cc)"), "c/c++"),
]
BUILD_TOOL_ATTRS = (
    "nativeBuildInputs",
    "depsBuildBuild",
    "depsBuildTarget",
    "propagatedNativeBuildInputs",
)


def strip_store_name(path: str) -> str:
    base = path.rsplit("/", 1)[-1]
    base = re.sub(r"^[a-z0-9]{32}-", "", base)
    return re.sub(r"\.drv$", "", base)


def to_store_path(path: str) -> str:
    return path if path.startswith("/nix/store/") else f"/nix/store/{path}"


def usage() -> None:
    print(
        "用法: nix-plan <主机> [system|home|deploy]\n"
        "      nix-plan --installable <flake 安装目标>\n\n"
        "  system  darwin 或 NixOS 系统（默认）\n"
        "  home    该主机的 Home Manager 激活包（just hm 构建的内容）\n"
        "  deploy  deploy-rs 部署 profile（含激活器）",
        file=sys.stderr,
    )


def resolve_installable(argv: list[str]) -> str:
    if not argv:
        usage()
        sys.exit(1)
    if argv[0] == "--installable":
        if len(argv) < 2 or not argv[1]:
            usage()
            sys.exit(1)
        return argv[1]

    host = argv[0]
    kind = argv[1] if len(argv) > 1 else "system"
    if kind == "system":
        res = subprocess.run(
            ["nix", "eval", "--json", ".#darwinConfigurations", "--apply", f'c: c ? "{host}"'],
            capture_output=True,
            text=True,
        )
        if res.returncode == 0 and res.stdout.strip() == "true":
            return f".#darwinConfigurations.{host}.system"
        return f".#nixosConfigurations.{host}.config.system.build.toplevel"
    if kind == "home":
        return f".#homeConfigurations.{host}.activationPackage"
    if kind == "deploy":
        return f".#deploy.nodes.{host}.profiles.system.path"

    usage()
    sys.exit(1)


def run_dry_run(installable: str) -> tuple[list[str], list[str], str]:
    print(f"求值 {installable} ...", file=sys.stderr)
    res = subprocess.run(["nix", "build", installable, "--dry-run"], capture_output=True, text=True)
    if res.returncode != 0:
        sys.stderr.write(res.stderr)
        sys.exit(res.returncode)

    built_drvs: list[str] = []
    fetched: list[str] = []
    fetch_summary = ""
    section = ""
    for line in res.stderr.splitlines():
        if line.endswith("will be built:"):
            section = "build"
            continue
        m = re.search(r"will be fetched \(([^)]+)\):", line)
        if m:
            fetch_summary = m.group(1)
            section = "fetch"
            continue
        if line.endswith("will be fetched:"):
            section = "fetch"
            continue
        stripped = line.strip()
        if stripped.startswith("/nix/store/"):
            if section == "build":
                built_drvs.append(stripped)
            elif section == "fetch":
                fetched.append(stripped)
        elif stripped == "":
            section = ""

    return built_drvs, fetched, fetch_summary


def load_derivations(drv_paths: list[str]) -> dict[str, dict]:
    existing = [p for p in dict.fromkeys(drv_paths) if os.path.exists(p)]
    if not existing:
        return {}
    res = subprocess.run(["nix", "derivation", "show", *existing], capture_output=True, text=True)
    if res.returncode != 0:
        return {}
    raw = json.loads(res.stdout)
    drvs = raw.get("derivations", raw)
    return {to_store_path(k): v for k, v in drvs.items()}


def get_input_drvs(drv: dict) -> list[str]:
    inputs = drv.get("inputs", {}).get("drvs")
    if inputs is None:
        inputs = drv.get("inputDrvs", {})
    return [to_store_path(k) for k in inputs.keys()]


def merge_attrs(drv: dict) -> dict:
    attrs = dict(drv.get("env") or {})
    if isinstance(drv.get("structuredAttrs"), dict):
        attrs.update(drv["structuredAttrs"])
    return attrs


def is_build_env(drv: dict, attrs: dict) -> bool:
    if attrs.get("paths") or attrs.get("pkgs"):
        return True
    return any("buildenv" in str(a) for a in (drv.get("args") or []))


def extract_build_tools(drv: dict, attrs: dict) -> list[str]:
    names: list[str] = []
    stdenv = attrs.get("stdenv")
    if isinstance(stdenv, str) and stdenv:
        names.append(strip_store_name(stdenv))
    for key in BUILD_TOOL_ATTRS:
        val = attrs.get(key)
        if isinstance(val, list):
            names.extend(strip_store_name(str(x)) for x in val if x)
        elif isinstance(val, str) and val.strip():
            names.extend(strip_store_name(x) for x in val.split())
    if not attrs.get("buildCommand") and not is_build_env(drv, attrs):
        val = attrs.get("buildInputs")
        if isinstance(val, list):
            names.extend(strip_store_name(str(x)) for x in val if x)
        elif isinstance(val, str) and val.strip():
            names.extend(strip_store_name(x) for x in val.split())
    return names


def detect_lang(tool_names: list[str]) -> str:
    joined = " ".join(tool_names)
    for pattern, lang in LANG_RULES:
        if pattern.search(joined):
            return lang
    return "其他"


def classify_built(drvs: dict[str, dict]) -> tuple[list[tuple[str, str]], dict[str, dict], int, int]:
    builds: list[tuple[str, str]] = []
    compile_drvs: dict[str, dict] = {}
    n_fetch = 0
    n_gen = 0
    for path, drv in drvs.items():
        attrs = merge_attrs(drv)
        if attrs.get("outputHash"):
            n_fetch += 1
            continue
        if is_build_env(drv, attrs):
            n_gen += 1
            continue

        tools = extract_build_tools(drv, attrs)
        has_compiler = any(
            COMPILER_INPUT_RE.match(name) or CC_STDENV_RE.match(name) for name in tools
        )
        if has_compiler:
            builds.append((detect_lang(tools), strip_store_name(path)))
            compile_drvs[path] = drv
        else:
            n_gen += 1
    return sorted(builds, key=lambda x: (x[0], x[1])), compile_drvs, n_fetch, n_gen


def trace_toolchain_causes(
    compile_drvs: dict[str, dict], fetched_toolchains: list[str]
) -> dict[str, list[str]]:
    if not compile_drvs or not fetched_toolchains:
        return {}

    target_outs = set(fetched_toolchains)
    out_to_roots: dict[str, set[str]] = {}
    drv_to_roots: dict[str, set[str]] = {}
    frontier: list[str] = []

    for drv_path, drv in compile_drvs.items():
        root_name = strip_store_name(drv_path)
        for in_drv in get_input_drvs(drv):
            if TOOLCHAIN_DRV_RE.match(strip_store_name(in_drv)):
                if in_drv not in drv_to_roots:
                    drv_to_roots[in_drv] = set()
                    frontier.append(in_drv)
                drv_to_roots[in_drv].add(root_name)

    visited: set[str] = set()
    for _ in range(5):
        batch = [p for p in frontier if p not in visited]
        if not batch:
            break
        visited.update(batch)
        loaded = load_derivations(batch)
        next_frontier: list[str] = []
        for drv_path, drv in loaded.items():
            roots = drv_to_roots.get(drv_path, set())
            for out_info in (drv.get("outputs") or {}).values():
                out_path = out_info.get("path")
                if out_path:
                    full_out = to_store_path(out_path)
                    if full_out in target_outs:
                        out_to_roots.setdefault(full_out, set()).update(roots)
            for in_drv in get_input_drvs(drv):
                if TOOLCHAIN_DRV_RE.match(strip_store_name(in_drv)):
                    if in_drv not in drv_to_roots:
                        drv_to_roots[in_drv] = set()
                    drv_to_roots[in_drv].update(roots)
                    if in_drv not in visited:
                        next_frontier.append(in_drv)
        frontier = next_frontier

    return {k: sorted(v) for k, v in out_to_roots.items()}


def format_causes(roots: list[str]) -> str:
    if not roots:
        return ""
    if len(roots) <= 3:
        return "  <- " + ", ".join(roots)
    return f"  <- {', '.join(roots[:3])} 等 {len(roots)} 个"


def main() -> None:
    installable = resolve_installable(sys.argv[1:])
    built_paths, fetched_paths, fetch_summary = run_dry_run(installable)

    if not built_paths and not fetched_paths:
        print("无需编译，无需下载")
        return

    built_drvs = load_derivations(built_paths)
    compile_drvs: dict[str, dict] = {}
    if built_paths:
        builds, compile_drvs, n_fetch, n_gen = classify_built(built_drvs)
        print(f"将构建 {len(built_paths)} 个派生：编译 {len(builds)}，源码下载 {n_fetch}，生成 {n_gen}")
        for lang, name in builds:
            print(f"  编译  {lang:<8s} {name}")
    else:
        print("将构建 0 个派生")

    if fetched_paths:
        summary = f"（{fetch_summary}）" if fetch_summary else ""
        print(f"将下载 {len(fetched_paths)} 个路径{summary}")
        toolchains = sorted(
            p
            for p in fetched_paths
            if TOOLCHAIN_OUT_RE.match(strip_store_name(p))
            and not NON_COMPILER_SUFFIX_RE.search(strip_store_name(p))
        )
        if toolchains:
            causes = trace_toolchain_causes(compile_drvs, toolchains)
            compile_tc = [p for p in toolchains if causes.get(p)]
            runtime_tc = [p for p in toolchains if not causes.get(p)]
            if compile_tc:
                print("  其中编译工具链（说明有东西要现编）：")
                for p in compile_tc:
                    print(f"    {strip_store_name(p)}{format_causes(causes[p])}")
            if runtime_tc:
                print("  其中运行时工具链（非本地编译触发）：")
                for p in runtime_tc:
                    print(f"    {strip_store_name(p)}")


if __name__ == "__main__":
    main()
