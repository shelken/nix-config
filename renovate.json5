{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard"],
  timezone: "Asia/Shanghai",
  schedule: ["before 4am"],
  labels: ["dependencies", "renovate"],
  commitMessagePrefix: "chore(deps):",
  commitMessageAction: "update",
  rebaseWhen: "conflicted",
  prConcurrentLimit: 10,
  prHourlyLimit: 0,

  nix: {
    enabled: true,
  },

  // pi 的插件清单没有内置 manager 认识；omp 的 plugins/package.json 由内置 npm manager 处理（支持 npm: 别名）
  customManagers: [
    {
      customType: "regex",
      description: "pi settings.json 中的 npm: 插件",
      managerFilePatterns: ["/(^|/)modules/features/ai/pi/settings\\.json$/"],
      matchStrings: ['"npm:(?<depName>@?[^@"\\s]+)@(?<currentValue>[^"\\s]+)"'],
      datasourceTemplate: "npm",
    },
  ],

  packageRules: [
    {
      matchManagers: ["github-actions"],
      // Actions 使用完整 SHA + major 标签注释（# vN），由 Renovate 更新版本和 digest。
      pinDigests: true,
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      groupName: "GitHub Actions Dependencies",
    },
    {
      matchManagers: ["nix"],
      matchDepNames: [
        "nixos/nixpkgs",
        "nixpkgs",
        "nixpkgs-darwin",
        "nixpkgs-unstable",
        "nix-darwin/nix-darwin",
        "nix-community/home-manager",
      ],
      groupName: "Nix Core Inputs",
      automerge: false,
    },
    {
      matchManagers: ["nix"],
      matchPackagePatterns: ["secrets", "dotfiles", "herdr"],
      enabled: false,
    },
    // 同一插件在 pi 与 omp 两份清单里各钉一次，按插件名合成一个 PR
    {
      description: "pi / omp 插件：两个宿主的同名插件同一个 PR",
      matchFileNames: [
        "modules/features/ai/pi/settings.json",
        "modules/features/ai/omp/plugins/package.json",
      ],
      groupName: "pi plugin {{packageName}}",
      commitMessageTopic: "{{packageName}}",
    },
    {
      description: "第三方 pi / omp 插件：发布满 3 天后自动合并非 major",
      matchFileNames: [
        "modules/features/ai/pi/settings.json",
        "modules/features/ai/omp/plugins/package.json",
      ],
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
      // 仓库没有 PR 级 CI，不等状态检查
      ignoreTests: true,
    },
    {
      description: "自有插件 @shelken/*：发布即合并 patch / minor",
      matchFileNames: [
        "modules/features/ai/pi/settings.json",
        "modules/features/ai/omp/plugins/package.json",
      ],
      matchPackageNames: ["@shelken/**"],
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: null,
      schedule: ["at any time"],
    },
  ],
}
