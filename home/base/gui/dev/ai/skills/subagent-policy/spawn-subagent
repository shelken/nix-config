function listAgents() {
  if (!existsSync(agentsDir)) return console.error(`agents 目录不存在: ${agentsDir}`);
  for (const f of readdirSync(agentsDir).filter((x) => x.endsWith(".md"))) {
    const g = resolveAgent(basename(f, ".md"));
    if (!g) {
      console.log(`${basename(f, ".md")}: <缺少 model/thinking/tools 字段，无法解析>`);
      continue;
    }
    console.log(`${g.name}: model=${g.model} thinking=${g.thinking} tools=[${g.tools}]`);
    console.log(`  description: ${g.description}`);
  }
}

function getSandvaultPaths(): { agentDir: string; subagentDir: string } {
  const user = process.env.USER || homedir().split("/").pop() || "shelken";
  const base = `/Users/Shared/sv-${user}/user/.pi`;
  const svAgentDir = join(base, "agent");
  const svSubagentDir = join(base, "agent-subagent");
  return { agentDir: svAgentDir, subagentDir: svSubagentDir };
}

// 子代理环境: agent-subagent 只隔离 settings/sessions/tmp, 其余链接回主目录;
// packages 里命中 exclude 的包加 "-" 前缀禁用。
function prepareEnv(
  exclude: string[],
  baseAgentDir: string = agentDir,
  baseSubagentDir: string = subagentDir,
) {
  mkdirSync(join(baseSubagentDir, "sessions"), { recursive: true });
  mkdirSync(join(baseSubagentDir, "tmp"), { recursive: true });
  for (const ent of readdirSync(baseAgentDir)) {
    if (["settings.json", "sessions", "tmp"].includes(ent)) continue;
    const src = join(baseAgentDir, ent), dst = join(baseSubagentDir, ent);
    try { rmSync(dst, { recursive: true, force: true }); } catch { /* 首次无 dst */ }
    symlinkSync(src, dst, lstatSync(src).isDirectory() ? "dir" : "file");
  }
  const pkgName = (p: any): string | null => {
    if (p && typeof p === "object") p = p.source;
    if (typeof p !== "string" || !p) return null;
    const s = p.replace(/^-/, "");
    const bare = s.includes(":") && !s.startsWith("/") ? s.split(":").slice(1).join(":") : s;
    return bare.split("/").filter(Boolean).at(-1) ?? null;
  };
  const settings = JSON.parse(readFileSync(join(baseAgentDir, "settings.json"), "utf8"));
  if (Array.isArray(settings.packages)) {
    settings.packages = settings.packages.map((p: any) => {
      const name = pkgName(p);
      if (name && exclude.includes(name)) {
        if (p && typeof p === "object") {
          const src = String(p.source);
          return src.startsWith("-") ? p : { ...p, source: "-" + src };
        }
        if (typeof p === "string" && !p.startsWith("-")) return "-" + p;
      }
      return p;
    });
  }
  writeFileSync(join(baseSubagentDir, "settings.json"), JSON.stringify(settings, null, 2) + "\n");
}

// 布局: 首个右侧分列(55%), 后续右列内向下堆叠并均分等高
function layoutPane(mainPane: string): string {
  const layout = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
  const main = layout.panes.find((p: any) => p.pane_id === mainPane);
  if (!main) throw new Error(`主窗格 '${mainPane}' 未在布局中找到`);
  const mainX = main.rect.x;
  const right = layout.panes
    .filter((p: any) => p.rect.x > mainX)
    .sort((a: any, b: any) => a.rect.y - b.rect.y);
  const target = right.at(-1)?.pane_id;
  const newPane = target
    ? herdr(["pane", "split", "--pane", target, "--direction", "down", "--ratio", "0.5", "--no-focus"]).result.pane.pane_id
    : herdr(["pane", "split", "--pane", mainPane, "--direction", "right", "--ratio", "0.55", "--no-focus"]).result.pane.pane_id;
  // 均分右列: 从下往上把同列 panes 逐步调成 1/(n-i) 占比
  for (let i = 0; i < 6; i++) {
    const l = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
    const panes = l.panes
      .filter((p: any) => p.rect.x === l.panes.find((q: any) => q.pane_id === newPane).rect.x)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    const n = panes.length;
    if (n < 2) break;
    const colX = l.panes.find((q: any) => q.pane_id === newPane).rect.x;
    const splits = l.splits
      .filter((s: any) => s.direction === "down" && Math.abs((s.rect?.x ?? -1) - colX) < 1)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    let changed = false;
    for (let k = n - 2; k >= 0; k--) {
      const cur = splits[k].ratio, want = 1 / (n - k);
      const delta = Math.round((want - cur) * 1e6) / 1e6;
      if (delta === 0) continue;
      const dir = delta > 0 ? "down" : "up";
      const pane = delta > 0 ? panes[k] : panes[k + 1];
      herdr(["pane", "resize", "--pane", pane.pane_id, "--direction", dir, "--amount", String(Math.abs(delta))]);
      changed = true;
    }
    if (!changed) break;
  }
  return newPane;
}

// 复用已有 agent（指定 pane）：注入新任务，不重启、不新建 pane。
// 首次 spawn 已注入回传协议；此处仅提醒回传给主代理 session
function resume(paneId: string, task: string) {
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!intercom) {
    console.error("spawn-subagent: resume 需要 PI_INTERCOM_SESSION_ID");
    process.exit(1);
  }
  const prompt = `（会话延续）新任务，完成后用 intercom 向主代理 session 回传结论（${intercom}），结论第一行标注 [${paneId}] 供对账:\n---\n${task}`;
  let prompted = false;
  for (let i = 0; i < 20 && !prompted; i++) {
    try {
      const out = execFileSync("herdr", ["agent", "prompt", paneId, prompt], { encoding: "utf8" });
      prompted = out.includes('"type":"agent_prompted"');
    } catch { /* 未就绪或 pane 已关闭, 重试 */ }
    if (!prompted) execSync("sleep 2");
  }
  if (!prompted) {
    console.error(`spawn-subagent: resume 注入失败（20 次重试后 pane '${paneId}' 未就绪或已关闭）`);
    process.exit(1);
  }
  console.log(paneId);
}

// ---------- 健康门 ----------

function sleep(ms: number) {
  return new Promise((r) => setTimeout(r, ms));
}

type SessionEvent = {
  type?: string;
  message?: { role?: string; stopReason?: string; errorMessage?: string };
};
type HealthObservation = { status: "none" | "healthy" | "error"; reason?: string };

function observeHealth(text: string): HealthObservation {
  let reason = "";
  for (const line of text.trim().split("\n")) {
    let event: SessionEvent;
    try { event = JSON.parse(line); } catch { continue; }
    const message = event.type === "message" ? event.message : null;
    if (message?.role !== "assistant") continue;
    if (message.stopReason !== "error") return { status: "healthy" };
    reason = message.errorMessage || "model error";
  }
  return reason ? { status: "error", reason } : { status: "none" };
}

function checkHealthParser() {
  const msg = (stopReason: string, errorMessage?: string) => JSON.stringify({ type: "message", message: { role: "assistant", stopReason, errorMessage } });
  if (observeHealth(msg("stop")).status !== "healthy") throw new Error("健康签名自检失败");
  if (observeHealth(`${msg("error", "503")}\n${msg("toolUse")}`).status !== "healthy") throw new Error("恢复签名自检失败");
  if (observeHealth(msg("error", "404")).status !== "error") throw new Error("失效签名自检失败");
}

// pi 自己负责瞬时错误重试。健康门只观察同一会话，避免脚本重启 session 造成双重重试。
// 4xx 配置/认证错误立即失败；其他错误等到总期限，期间出现新健康 assistant 即恢复。
async function healthGate(sessionFile: string, timeoutMs: number): Promise<{ healthy: boolean; reason?: string } | null> {
  const deadline = Date.now() + timeoutMs;
  let lastErrorText = "";
  while (Date.now() < deadline) {
    if (existsSync(sessionFile)) {
      const observation = observeHealth(readFileSync(sessionFile, "utf-8"));
      if (observation.status === "healthy") return { healthy: true };
      if (observation.status === "error") {
        lastErrorText = observation.reason ?? "model error";
        if (/400|401|403|404|auth|unauthorized|forbidden|not_found/i.test(lastErrorText)) {
          return { healthy: false, reason: lastErrorText };
        }
      }
    }
    await sleep(1000);
  }
  return lastErrorText ? { healthy: false, reason: lastErrorText } : null;
}

// ---------- 单 agent 派发（spawn / batch 共用）----------

type DispatchResult = {
  profile: string;
  pane: string;
  agentName: string;
  healthy: boolean;
  reason?: string;
};

type Launched = {
  profile: string;
  pane: string;
  agentName: string;
  sessionFile: string;
};

// 阶段一（同步串行）：布局 + 环境 + 启动 + 注入。返回派发信息，不等待模型响应
function launchAgent(profile: string, slug: string, task: string, sandvault: boolean = false): Launched {
  const g = resolveAgent(profile);
  if (!g) throw new Error(`profile '${profile}' 无法解析（agents 目录无对应 md，或缺少 model/thinking/tools 字段）`);
  if (!slug.match(/^[a-z0-9-]+$/)) throw new Error(`slug 只能含小写字母/数字/连字符: '${slug}'`);
  const mainPane = process.env.HERDR_PANE_ID;
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!mainPane || !intercom) throw new Error("需要 HERDR_PANE_ID 与 PI_INTERCOM_SESSION_ID");

  const ts = Date.now().toString(36);
  // herdr agent 名必须小写字母开头：profile 统一小写（如 Explore md → explore agent）
  const p = profile.toLowerCase();
  const slugBudget = 32 - 1 - ts.length - 1 - p.length;
  let agentName: string;
  if (slugBudget >= 1) {
    agentName = `${p}-${slug.slice(0, slugBudget).replace(/-$/, "")}-${ts}`;
  } else {
    agentName = `${p.slice(0, 32 - 1 - ts.length).replace(/-$/, "")}-${ts}`;
  }
  if (agentName.length > 32) throw new Error(`无法构造 32 字符内的 agent 名（profile='${profile}' slug='${slug}'）`);

  const targetAgentDir = sandvault ? getSandvaultPaths().agentDir : agentDir;
  const targetSubagentDir = sandvault ? getSandvaultPaths().subagentDir : subagentDir;
  if (!existsSync(targetAgentDir)) {
    throw new Error(`代理目录不存在: ${targetAgentDir}`);
  }

  let sessionFile: string | null = null;

  const newPane = layoutPane(mainPane);
  try {
    prepareEnv(g.exclude, targetAgentDir, targetSubagentDir);
    if (sandvault) {
      execFileSync("herdr", ["pane", "run", newPane, "sv shell"]);
    }
    execFileSync("herdr", ["pane", "run", newPane, `export PI_CODING_AGENT_DIR=${targetSubagentDir}`]);
    const startOut = herdr(["agent", "start", agentName, "--kind", "pi", "--pane", newPane, "--", "--model", g.model, "--thinking", g.thinking, "--tools", g.tools]);
    const sf = startOut?.result?.agent?.agent_session?.value;
    if (typeof sf === "string") {
      const m = sf.match(/(sessions\/--[^/]+\/[^/]+\.jsonl)/);
      if (m) sessionFile = targetSubagentDir + "/" + m[1];
    }
  } catch (e: any) {
    try { execFileSync("herdr", ["pane", "close", newPane]); } catch { /* 已关闭 */ }
    throw new Error(`启动失败: ${String(e.message ?? e)}`);
  }
  if (!sessionFile) {
    try { execFileSync("herdr", ["pane", "close", newPane]); } catch { /* 已关闭 */ }
    throw new Error("健康门不可用: herdr 未返回可解析的 agent session 路径");
  }

  const prompt = `你是通过 spawn-subagent 启动的 pi 子代理（profile: ${profile}）。

回传协议:
- 完成或受阻时，用 intercom 工具向主代理 session 发送一条结论消息:
  intercom({ action: "send", to: "${intercom}", message: "<结论>" })
- 结论消息第一行必须是 [${agentName}]（你的 agent 名），供主代理对账。
- 消息格式由下方任务描述，不设固定字段。
- 阻塞或失败时保留当前 pane 供主代理检查，不要自行关闭。

任务原文:
---
${task}
---`;
  let prompted = false;
  for (let i = 0; i < 20 && !prompted; i++) {
    try {
      const out = execFileSync("herdr", ["agent", "prompt", newPane, prompt], { encoding: "utf8" });
      prompted = out.includes('"type":"agent_prompted"');
    } catch { /* pane 未就绪, 重试 */ }
    if (!prompted) execSync("sleep 2");
  }
  if (!prompted) {
    try { execFileSync("herdr", ["pane", "close", newPane]); } catch { /* 已关闭 */ }
    throw new Error("prompt 注入失败（20 次重试后 pane 未就绪）");
  }

  return { profile, pane: newPane, agentName, sessionFile };
}

// 失效分类: 404/401/403/认证属配置错误（重试无意义），其余（503/超时等）为瞬时故障（可重试）
function classifyFailure(reason: string): string {
  return /400|401|403|404|auth|unauthorized|forbidden|not_found/i.test(reason)
    ? `config-error: ${reason}`
    : `transient: ${reason}`;
}

// 阶段二（可并发）：独立健康门，等本 agent 的 stopReason:error / 健康 assistant，超时 30s
// 失效时自动关闭 pane（模型失效的 pane 无检查价值，防残留）
async function gateAgent(l: Launched, timeoutMs: number): Promise<DispatchResult> {
  const gate = await healthGate(l.sessionFile, timeoutMs);
  const reason = gate && !gate.healthy ? classifyFailure(gate.reason ?? "") : (gate ? undefined : "transient: health-check timeout (no model response)");
  if (reason) {
    try { execFileSync("herdr", ["pane", "close", l.pane]); } catch { /* 已关闭 */ }
    return { profile: l.profile, pane: "-", agentName: l.agentName, healthy: false, reason };
  }
  return { profile: l.profile, pane: l.pane, agentName: l.agentName, healthy: true };
}

async function spawn(profile: string, slug: string, task: string, sandvault: boolean = false) {
  try {
    const r = await gateAgent(launchAgent(profile, slug, task, sandvault), 45000);
    if (!r.healthy) {
      console.error(`spawn-subagent: 模型失效（${r.reason}）`);
      process.exit(1);
    }
    console.log(r.pane);
  } catch (e: any) {
    console.error("spawn-subagent: 启动失败:", String(e.message ?? e));
    process.exit(1);
  }
}

// ---------- 任务组合 ----------

function composeTask(sharedTask: string, agentTask: string | undefined): string {
  if (!sharedTask) return agentTask ?? "";
  if (!agentTask) return sharedTask;
  return `${sharedTask}\n\n专项任务:\n---\n${agentTask}`;
}

function checkTaskComposition() {
  if (composeTask("共享背景", "专项分工") !== "共享背景\n\n专项任务:\n---\n专项分工") {
    throw new Error("任务组合自检失败: 共享背景与专项任务未正确组合");
  }
  if (composeTask("共享背景", undefined) !== "共享背景") {
    throw new Error("任务组合自检失败: 仅共享任务时内容发生变化");
  }
  if (composeTask("", "专项分工") !== "专项分工") {
    throw new Error("任务组合自检失败: 仅专项任务时内容发生变化");
  }
}

// ---------- batch 编排 ----------

async function batch(manifestPath: string) {
  let manifest: any;
  try {
    manifest = JSON.parse(readFileSync(manifestPath, "utf-8"));
  } catch (e: any) {
    console.error(`spawn-subagent: manifest 解析失败: ${e.message}`);
    process.exit(1);
  }
  const sharedTask = manifest.task ?? "";
  const defaultSandvault = Boolean(manifest.sandvault);
  const rawAgents = manifest.agents;
  if (!Array.isArray(rawAgents) || rawAgents.length === 0) {
    console.error("spawn-subagent: manifest 需要非空 agents 数组");
    process.exit(1);
  }

  // 校验先行：展开 agents 为 {profile, slug, task, sandvault}，任一无效整体拒绝（零 token）
  const entries: { profile: string; slug: string; task: string; sandvault: boolean }[] = [];
  const errors: string[] = [];
  for (const a of rawAgents) {
    const profile = typeof a === "string" ? a : a?.profile;
    if (!profile) { errors.push("缺少 profile"); continue; }
    const slugRaw = typeof a === "string" ? undefined : a?.slug;
    const task = typeof a === "string" ? composeTask(sharedTask, undefined) : composeTask(sharedTask, a?.task);
    const sandvault = typeof a === "object" && a !== null && typeof a.sandvault === "boolean"
      ? a.sandvault
      : defaultSandvault;
    const slug = slugRaw ?? profile.replace(/^reviewer-/i, "").replace(/[^a-z0-9-]/gi, "-");
    if (!resolveAgent(profile)) errors.push(`profile '${profile}' 无效`);
    if (!slug.match(/^[a-z0-9-]+$/)) errors.push(`slug '${slug}' 只能含小写/数字/连字符`);
    if (!task.trim()) errors.push(`profile '${profile}' 的 task 为空`);
    entries.push({ profile, slug, task, sandvault });
  }
  if (errors.length) {
    console.error(`spawn-subagent: manifest 校验失败（未派发任何 agent）:`);
    for (const err of errors) console.error(`  - ${err}`);
    process.exit(1);
  }

  // 两阶段：串行 launchAgent（布局是累积操作必须串行），再并发健康门（互不阻塞）
  console.log(`spawn-subagent: 派发 ${entries.length} 个 agent...`);
  const launched: { entry: { profile: string; slug: string; task: string; sandvault: boolean }; result: Launched | null; error?: string }[] = [];
  for (const entry of entries) {
    try {
      launched.push({ entry, result: launchAgent(entry.profile, entry.slug, entry.task, entry.sandvault) });
    } catch (e: any) {
      launched.push({ entry, result: null, error: String(e.message ?? e) });
    }
  }
  const results = await Promise.all(launched.map(async ({ entry, result, error }) => {
    if (!result) return { profile: entry.profile, pane: "-", agentName: "-", healthy: false, reason: `launch-error: ${error}` };
    return gateAgent(result, 45000);
  }));
  for (const r of results) {
    const line = `${r.profile}\t${r.pane}\t${r.healthy ? "ok" : "failed"}${r.reason ? `  (${r.reason})` : ""}`;
    (r.healthy ? console.log : console.error)(line);
  }
  const anyFailed = results.some((r) => !r.healthy);
  process.exit(anyFailed ? 1 : 0);
}

// ---------- main ----------
const rawArgs = process.argv.slice(2);
const c0 = rawArgs[0];

if (!c0 || c0 === "-h" || c0 === "--help") {
  usage();
} else if (c0 === "batch") {
  const c1 = rawArgs[1];
  if (!c1) {
    console.error("spawn-subagent: batch 需要 manifest 文件路径");
    process.exit(1);
  }
  await batch(c1);
} else if (c0 === "list") {
  listAgents();
} else if (c0 === "--check") {
  checkHealthParser();
  checkTaskComposition();
  prepareEnv(config.exclude ?? []);
  console.log("健康门签名自检通过");
  console.log(`宿主派生 settings.json 就绪: ${join(subagentDir, "settings.json")}`);
  const svPaths = getSandvaultPaths();
  if (existsSync(svPaths.agentDir)) {
    prepareEnv(config.exclude ?? [], svPaths.agentDir, svPaths.subagentDir);
    console.log(`沙盒派生 settings.json 就绪: ${join(svPaths.subagentDir, "settings.json")}`);
  }
  console.log(`全局排除 exclude(subagent-config.json 统一生效): ${JSON.stringify(config.exclude ?? [])}\n`);
  listAgents();
} else if (c0 === "close") {
  const c1 = rawArgs[1];
  if (!c1) {
    console.error("spawn-subagent: close 需要 pane-id 参数");
    process.exit(1);
  }
  try {
    execFileSync("herdr", ["pane", "close", c1]);
    execFileSync("herdr", ["agent", "focus", process.env.HERDR_PANE_ID!]);
    console.log(`closed ${c1}`);
  } catch (e: any) {
    console.error(`spawn-subagent: 关闭失败（pane 不存在或已关闭）: ${c1}`);
    process.exit(1);
  }
} else if (c0 === "resume") {
  const c1 = rawArgs[1];
  const sep = rawArgs.indexOf("--");
  const task = sep >= 0 ? rawArgs.slice(sep + 1).join(" ") : rawArgs.slice(2).join(" ");
  if (!c1 || !task.trim()) {
    usage();
    process.exit(1);
  }
  resume(c1, task);
} else {
  const sep = rawArgs.indexOf("--");
  const beforeSep = sep >= 0 ? rawArgs.slice(0, sep) : rawArgs;
  const task = sep >= 0 ? rawArgs.slice(sep + 1).join(" ") : "";

  const sandvault = beforeSep.includes("-s") || beforeSep.includes("--sandvault");
  const posArgs = beforeSep.filter((a) => a !== "-s" && a !== "--sandvault");

  const [profile, slug] = posArgs;
  if (!profile || !slug || !task.trim()) {
    usage();
    process.exit(1);
  }
  await spawn(profile, slug, task, sandvault);
}