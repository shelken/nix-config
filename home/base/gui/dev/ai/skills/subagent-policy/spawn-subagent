#!/usr/bin/env bun
// spawn-subagent.ts — 在 Herdr 窗格中启动/关闭 pi 子代理
// agent 真相源: ~/.pi/agent/agents/<profile>.md frontmatter; subagent-config.json 仅作全局默认。
// 用法: spawn-subagent <profile> <slug> -- <task> | close <pane-id> | list | --check | -h
import { execFileSync, execSync } from "node:child_process";
import {
  existsSync, lstatSync, mkdirSync, readdirSync, readFileSync,
  rmSync, symlinkSync, writeFileSync,
} from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const scriptDir = dirname(fileURLToPath(import.meta.url));
const agentsDir = join(homedir(), ".pi", "agent", "agents");
const config = JSON.parse(readFileSync(join(scriptDir, "subagent-config.json"), "utf8"));
const AGENT_FIELDS = ["description", "model", "thinking", "tools"];

type Agent = {
  name: string; model: string; thinking: string; tools: string;
  exclude: string[]; description: string; md?: string;
};

// ---------- 解析 ----------

// 轻量 frontmatter 解析: key: value 与缩进 "- item" 块, 注释/其余行忽略值保留在 md。
function parseFrontmatter(text: string): Record<string, string | string[]> {
  const m = text.match(/^---\n([\s\S]*?)\n---/);
  if (!m) return {};
  const f: Record<string, string | string[]> = {};
  let cur: string | null = null;
  for (const raw of m[1].split("\n")) {
    const line = raw.trimEnd();
    const kv = line.match(/^([A-Za-z0-9_-]+):(.*)$/);
    if (kv) { cur = kv[1]; f[cur] = kv[2].trim(); }
    else if (cur && /^\s+-\s+/.test(line)) {
      const item = line.trim().slice(2);
      f[cur] = Array.isArray(f[cur]) ? [...f[cur], item] : [item];
    }
  }
  return f;
}

// md 显式值 > config 预设; md 无对应文件时退回 config 预设。
function resolveAgent(profile: string): Agent | null {
  const preset = config.presets?.[profile.toLowerCase()] ?? {};
  const mdName = existsSync(agentsDir)
    ? readdirSync(agentsDir).find((f) => basename(f, ".md").toLowerCase() === profile.toLowerCase())
    : undefined;
  const f = mdName ? parseFrontmatter(readFileSync(join(agentsDir, mdName), "utf8")) : {};
  const has = (k: string) => Object.prototype.hasOwnProperty.call(f, k);
  const pick = (k: string, d: string) => (has(k) ? String(f[k]) : d);
  const model = pick("model", preset.model);
  const thinking = pick("thinking", preset.thinking);
  const tools = pick("tools", preset.tools);
  if (!model || !thinking || !tools) return null;
  // 插件排除全局统一：所有子代理共用一份派生 settings.json，per-md 无法生效
  return {
    name: profile, model, thinking, tools,
    exclude: (config.exclude ?? []) as string[], description: (f.description as string) ?? "",
    ...(mdName ? { md: join(agentsDir, mdName) } : {}),
  };
}

// ---------- 命令 ----------

function herdr(args: string[]): any {
  return JSON.parse(execFileSync("herdr", args, { encoding: "utf8" }));
}
function usage() {
  console.log(`spawn-subagent - 在 Herdr 窗格中启动/关闭 pi 子代理

用法:
  spawn-subagent <profile> <slug> -- <task>   启动单个子代理，输出 pane ID
  spawn-subagent batch <manifest.json>        按 manifest 并发编排多个子代理（共享 task）
  spawn-subagent resume <pane-id> -- <task>   复用已有 agent pane，注入新任务（不重启）
  spawn-subagent list                         列出所有 agent(name/model/thinking/tools/描述)
  spawn-subagent --check                      派生 settings + 打印所有 agent 生效值，不启动
  spawn-subagent close <pane-id>              关闭子代理 pane 并聚焦回主 pane
  spawn-subagent -h | --help                  显示本帮助

profile: 对应 ~/.pi/agent/agents/<profile>.md（文件名小写匹配）；frontmatter 的
         model/thinking/tools 为唯一真相源，缺字段时回退 subagent-config.json。
         插件排除由 subagent-config.json 的 exclude 全局统一，md 不支持单独声明。
slug:    任务语义标识（小写字母/数字/连字符，agent 名上限 32 字符）
task:    子代理任务描述，支持多行；派发后立即返回 pane ID，结论经 intercom 回传

manifest 格式 (batch):
  { "task": "共享任务", "agents": ["reviewer-gpt", {"profile": "reviewer-glm", "slug": "glm"}] }
  agents 为字符串时 slug 自动取 profile 去掉 reviewer- 前缀，可带 task 字段覆盖共享的
  校验先行：任一 profile 无效/语法错，整体拒绝，不派发任何 agent；每 agent 独立健康门

env: HERDR_PANE_ID, PI_INTERCOM_SESSION_ID`);
}

function listAgents() {
  if (!existsSync(agentsDir)) return console.error(`agents 目录不存在: ${agentsDir}`);
  for (const f of readdirSync(agentsDir).filter((x) => x.endsWith(".md"))) {
    const g = resolveAgent(basename(f, ".md"));
    if (!g) {
      console.log(`${basename(f, ".md")}: <缺少 model/thinking/tools 字段，无法解析>`);
      continue;
    }
    console.log(`${g.name}: model=${g.model} thinking=${g.thinking} tools=[${g.tools}]`);
    console.log(`  description: ${g.description}`);
  }
}

// 子代理环境: ~/.pi/agent-subagent 只隔离 settings/sessions/tmp, 其余链接回主目录;
// packages 里命中 exclude 的包加 "-" 前缀禁用。
function prepareEnv(exclude: string[]) {
  const main = join(homedir(), ".pi", "agent");
  const sub = join(homedir(), ".pi", "agent-subagent");
  mkdirSync(join(sub, "sessions"), { recursive: true });
  mkdirSync(join(sub, "tmp"), { recursive: true });
  for (const ent of readdirSync(main)) {
    if (["settings.json", "sessions", "tmp"].includes(ent)) continue;
    const src = join(main, ent), dst = join(sub, ent);
    try { rmSync(dst, { recursive: true, force: true }); } catch { /* 首次无 dst */ }
    symlinkSync(src, dst, lstatSync(src).isDirectory() ? "dir" : "file");
  }
  const pkgName = (p: any): string | null => {
    if (p && typeof p === "object") p = p.source;
    if (typeof p !== "string" || !p) return null;
    const s = p.replace(/^-/, "");
    const bare = s.includes(":") && !s.startsWith("/") ? s.split(":").slice(1).join(":") : s;
    return bare.split("/").filter(Boolean).at(-1) ?? null;
  };
  const settings = JSON.parse(readFileSync(join(main, "settings.json"), "utf8"));
  settings.packages = settings.packages.map((p: any) => {
    const name = pkgName(p);
    if (name && exclude.includes(name)) {
      if (p && typeof p === "object") {
        const src = String(p.source);
        return src.startsWith("-") ? p : { ...p, source: "-" + src };
      }
      if (typeof p === "string" && !p.startsWith("-")) return "-" + p;
    }
    return p;
  });
  writeFileSync(join(sub, "settings.json"), JSON.stringify(settings, null, 2) + "\n");
}

// 布局: 首个右侧分列(55%), 后续右列内向下堆叠并均分等高
function layoutPane(mainPane: string): string {
  const layout = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
  const mainX = layout.panes.find((p: any) => p.pane_id === mainPane).rect.x;
  const right = layout.panes
    .filter((p: any) => p.rect.x > mainX)
    .sort((a: any, b: any) => a.rect.y - b.rect.y);
  const target = right.at(-1)?.pane_id;
  const newPane = target
    ? herdr(["pane", "split", "--pane", target, "--direction", "down", "--ratio", "0.5", "--no-focus"]).result.pane.pane_id
    : herdr(["pane", "split", "--pane", mainPane, "--direction", "right", "--ratio", "0.55", "--no-focus"]).result.pane.pane_id;
  // 均分右列: 从下往上把同列 panes 逐步调成 1/(n-i) 占比
  for (let i = 0; i < 6; i++) {
    const l = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
    const panes = l.panes
      .filter((p: any) => p.rect.x === l.panes.find((q: any) => q.pane_id === newPane).rect.x)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    const n = panes.length;
    if (n < 2) break;
    const colX = l.panes.find((q: any) => q.pane_id === newPane).rect.x;
    const splits = l.splits
      .filter((s: any) => s.direction === "down" && Math.abs((s.rect?.x ?? -1) - colX) < 1)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    let changed = false;
    for (let k = n - 2; k >= 0; k--) {
      const cur = splits[k].ratio, want = 1 / (n - k);
      const delta = Math.round((want - cur) * 1e6) / 1e6;
      if (delta === 0) continue;
      const dir = delta > 0 ? "down" : "up";
      const pane = delta > 0 ? panes[k] : panes[k + 1];
      herdr(["pane", "resize", "--pane", pane.pane_id, "--direction", dir, "--amount", String(Math.abs(delta))]);
      changed = true;
    }
    if (!changed) break;
  }
  return newPane;
}

// 复用已有 agent（指定 pane）：注入新任务，不重启、不新建 pane。
// 首次 spawn 已注入回传协议；此处仅提醒回传给主代理 session
function resume(paneId: string, task: string) {
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!intercom) {
    console.error("spawn-subagent: resume 需要 PI_INTERCOM_SESSION_ID");
    process.exit(1);
  }
  const prompt = `（会话延续）新任务，完成后用 intercom 向主代理 session 回传结论（${intercom}）:\n---\n${task}`;
  let prompted = false;
  for (let i = 0; i < 20 && !prompted; i++) {
    try {
      const out = execFileSync("herdr", ["agent", "prompt", paneId, prompt], { encoding: "utf8" });
      prompted = out.includes('"type":"agent_prompted"');
    } catch { /* 未就绪或 pane 已关闭, 重试 */ }
    if (!prompted) execSync("sleep 2");
  }
  if (!prompted) {
    console.error(`spawn-subagent: resume 注入失败（20 次重试后 pane '${paneId}' 未就绪或已关闭）`);
    process.exit(1);
  }
  console.log(paneId);
}

// ---------- 健康门 ----------

function sleep(ms: number) {
  return new Promise((r) => setTimeout(r, ms));
}

// 阻塞等待健康/失效信号。pi 遇瞬时错误（503 等）会自动重试，实测同一会话可 error 后恢复
// （最快 2s、最慢 17s），因此首个 error 不能判死：
// - 首条信号是健康 assistant（无 error）→ 健康
// - error 后 15s 恢复窗口内出现新的健康 assistant（pi 重试成功）→ 健康
// - error 后窗口耗尽仍无恢复，或总超时 → 失效
async function healthGate(sessionFile: string | null, timeoutMs: number): Promise<{ healthy: boolean; reason?: string } | null> {
  const deadline = Date.now() + timeoutMs;
  let firstErrorAt: number | null = null;
  let lastErrorText = "";
  const RECOVERY_MS = 15000;
  while (Date.now() < deadline) {
    if (sessionFile && existsSync(sessionFile)) {
      const lines = readFileSync(sessionFile, "utf-8").trim().split("\n");
      let sawError = false;
      let healthyAfterError = false;
      for (const line of lines) {
        if (!line.includes('"role":"assistant"')) continue;
        const isErr = line.includes('"stopReason":"error"');
        if (isErr) {
          sawError = true;
          const m = line.match(/"errorMessage":"([^"]{0,120})/);
          if (m) lastErrorText = m[1];
          if (firstErrorAt === null) firstErrorAt = Date.now();
        } else if (sawError) {
          healthyAfterError = true;
        }
      }
      if (!sawError) {
        if (lines.some((l) => l.includes('"role":"assistant"'))) return { healthy: true };
      } else if (healthyAfterError) {
        return { healthy: true };
      } else if (firstErrorAt !== null && Date.now() - firstErrorAt > RECOVERY_MS) {
        return { healthy: false, reason: lastErrorText || "model error" };
      }
    }
    await sleep(1000);
  }
  return null;
}

// ---------- 单 agent 派发（spawn / batch 共用）----------

type DispatchResult = {
  profile: string;
  pane: string;
  agentName: string;
  healthy: boolean;
  reason?: string;
};

type Launched = {
  profile: string;
  pane: string;
  agentName: string;
  sessionFile: string | null;
};

// 阶段一（同步串行）：布局 + 环境 + 启动 + 注入。返回派发信息，不等待模型响应
function launchAgent(profile: string, slug: string, task: string): Launched {
  const g = resolveAgent(profile);
  if (!g) throw new Error(`profile '${profile}' 无法解析（agents 目录无对应 md，或缺少 model/thinking/tools 字段）`);
  if (!slug.match(/^[a-z0-9-]+$/)) throw new Error(`slug 只能含小写字母/数字/连字符: '${slug}'`);
  const mainPane = process.env.HERDR_PANE_ID;
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!mainPane || !intercom) throw new Error("需要 HERDR_PANE_ID 与 PI_INTERCOM_SESSION_ID");

  const ts = Date.now().toString(36);
  // herdr agent 名必须小写字母开头：profile 统一小写（如 Explore md → explore agent）
  const p = profile.toLowerCase();
  const slugBudget = 32 - 1 - ts.length - 1 - p.length;
  let agentName: string;
  if (slugBudget >= 1) {
    agentName = `${p}-${slug.slice(0, slugBudget).replace(/-$/, "")}-${ts}`;
  } else {
    agentName = `${p.slice(0, 32 - 1 - ts.length).replace(/-$/, "")}-${ts}`;
  }
  if (agentName.length > 32) throw new Error(`无法构造 32 字符内的 agent 名（profile='${profile}' slug='${slug}'）`);

  // 会话文件定位：从 herdr agent start 返回的 agent_session.value 提取 sessions/ 相对路径
  // value 形如 ~/.pi/agent/sessions/--cwd--/ts.jsonl；子代理实际写入 ~/.pi/agent-subagent/sessions/ 同相对段
  const agentsDir = homedir() + "/.pi/agent-subagent";
  let sessionFile: string | null = null;

  const newPane = layoutPane(mainPane);
  try {
    prepareEnv(g.exclude);
    execFileSync("herdr", ["pane", "run", newPane, `export PI_CODING_AGENT_DIR=${homedir()}/.pi/agent-subagent`]);
    const startOut = herdr(["agent", "start", agentName, "--kind", "pi", "--pane", newPane, "--", "--model", g.model, "--thinking", g.thinking, "--tools", g.tools]);
    const sf = startOut?.result?.agent?.agent_session?.value;
    if (typeof sf === "string") {
      const m = sf.match(/(sessions\/--[^/]+\/[^/]+\.jsonl)/);
      if (m) sessionFile = agentsDir + "/" + m[1];
    }
  } catch (e: any) {
    try { execFileSync("herdr", ["pane", "close", newPane]); } catch { /* 已关闭 */ }
    throw new Error(`启动失败: ${String(e.message ?? e)}`);
  }

  const prompt = `你是通过 spawn-subagent 启动的 pi 子代理（profile: ${profile}）。

回传协议:
- 完成或受阻时，用 intercom 工具向主代理 session 发送一条结论消息:
  intercom({ action: "send", to: "${intercom}", message: "<结论>" })
- 消息格式由下方任务描述，不设固定字段。
- 阻塞或失败时保留当前 pane 供主代理检查，不要自行关闭。

任务原文:
---
${task}
---`;
  let prompted = false;
  for (let i = 0; i < 20 && !prompted; i++) {
    try {
      const out = execFileSync("herdr", ["agent", "prompt", newPane, prompt], { encoding: "utf8" });
      prompted = out.includes('"type":"agent_prompted"');
    } catch { /* pane 未就绪, 重试 */ }
    if (!prompted) execSync("sleep 2");
  }
  if (!prompted) throw new Error("prompt 注入失败（20 次重试后 pane 未就绪）");

  return { profile, pane: newPane, agentName, sessionFile };
}

// 失效分类: 404/401/403/认证属配置错误（重试无意义），其余（503/超时等）为瞬时故障（可重试）
function classifyFailure(reason: string): string {
  return /404|401|403|auth|unauthorized|forbidden|not_found/i.test(reason)
    ? `config-error: ${reason}`
    : `transient: ${reason}`;
}

// 阶段二（可并发）：独立健康门，等本 agent 的 stopReason:error / 健康 assistant，超时 30s
// 失效时自动关闭 pane（模型失效的 pane 无检查价值，防残留）
async function gateAgent(l: Launched, timeoutMs: number): Promise<DispatchResult> {
  const gate = await healthGate(l.sessionFile, timeoutMs);
  const reason = gate && !gate.healthy ? classifyFailure(gate.reason ?? "") : (gate ? undefined : "transient: health-check timeout (no model response)");
  if (reason) {
    try { execFileSync("herdr", ["pane", "close", l.pane]); } catch { /* 已关闭 */ }
    return { profile: l.profile, pane: "-", agentName: l.agentName, healthy: false, reason };
  }
  return { profile: l.profile, pane: l.pane, agentName: l.agentName, healthy: true };
}

async function spawn(profile: string, slug: string, task: string) {
  try {
    const l = launchAgent(profile, slug, task);
    const r = await gateAgent(l, 30000);
    console.log(r.pane);
    if (!r.healthy) {
      console.error(`spawn-subagent: agent 已派发但模型失效（${r.reason}）`);
      process.exit(1);
    }
  } catch (e: any) {
    console.error("spawn-subagent: 启动失败:", String(e.message ?? e));
    process.exit(1);
  }
}

// ---------- batch 编排 ----------

async function batch(manifestPath: string) {
  let manifest: any;
  try {
    manifest = JSON.parse(readFileSync(manifestPath, "utf-8"));
  } catch (e: any) {
    console.error(`spawn-subagent: manifest 解析失败: ${e.message}`);
    process.exit(1);
  }
  const sharedTask = manifest.task ?? "";
  const rawAgents = manifest.agents;
  if (!Array.isArray(rawAgents) || rawAgents.length === 0) {
    console.error("spawn-subagent: manifest 需要非空 agents 数组");
    process.exit(1);
  }

  // 校验先行：展开 agents 为 {profile, slug, task}，任一无效整体拒绝（零 token）
  const entries: { profile: string; slug: string; task: string }[] = [];
  const errors: string[] = [];
  for (const a of rawAgents) {
    const profile = typeof a === "string" ? a : a?.profile;
    const slugRaw = typeof a === "string" ? undefined : a?.slug;
    const task = typeof a === "string" ? sharedTask : (a?.task ?? sharedTask);
    const slug = slugRaw ?? profile.replace(/^reviewer-/i, "").replace(/[^a-z0-9-]/gi, "-");
    if (!profile) errors.push("缺少 profile");
    else if (!resolveAgent(profile)) errors.push(`profile '${profile}' 无效`);
    if (!slug.match(/^[a-z0-9-]+$/)) errors.push(`slug '${slug}' 只能含小写/数字/连字符`);
    if (!task.trim()) errors.push(`profile '${profile}' 的 task 为空`);
    entries.push({ profile, slug, task });
  }
  if (errors.length) {
    console.error(`spawn-subagent: manifest 校验失败（未派发任何 agent）:`);
    for (const err of errors) console.error(`  - ${err}`);
    process.exit(1);
  }

  // 两阶段：串行 launchAgent（布局是累积操作必须串行），再并发健康门（互不阻塞）
  console.log(`spawn-subagent: 派发 ${entries.length} 个 agent...`);
  const launched: { entry: { profile: string; slug: string; task: string }; result: Launched | null; error?: string }[] = [];
  for (const entry of entries) {
    try {
      launched.push({ entry, result: launchAgent(entry.profile, entry.slug, entry.task) });
    } catch (e: any) {
      launched.push({ entry, result: null, error: String(e.message ?? e) });
    }
  }
  const results = await Promise.all(launched.map(async ({ entry, result, error }) => {
    if (!result) return { profile: entry.profile, pane: "-", agentName: "-", healthy: false, reason: error };
    return gateAgent(result, 30000);
  }));
  for (const r of results) {
    console.log(`${r.profile}\t${r.pane}\t${r.healthy ? "ok" : "failed"}${r.reason ? `  (${r.reason})` : ""}`);
  }
  const anyFailed = results.some((r) => !r.healthy);
  process.exit(anyFailed ? 1 : 0);
}

// ---------- main ----------
const [c0, c1, ...rest] = process.argv.slice(2);
if (!c0 || c0 === "-h" || c0 === "--help") {
  usage();
} else if (c0 === "batch") {
  if (!c1) {
    console.error("spawn-subagent: batch 需要 manifest 文件路径");
    process.exit(1);
  }
  await batch(c1);
} else if (c0 === "list") {
  listAgents();
} else if (c0 === "--check") {
  prepareEnv(config.exclude ?? []);
  console.log(`派生 settings.json 就绪: ${join(homedir(), ".pi", "agent-subagent", "settings.json")}`);
  console.log(`全局排除 exclude(subagent-config.json 统一生效): ${JSON.stringify(config.exclude ?? [])}\n`);
  listAgents();
} else if (c0 === "close") {
  if (!c1) {
    console.error("spawn-subagent: close 需要 pane-id 参数");
    process.exit(1);
  }
  try {
    execFileSync("herdr", ["pane", "close", c1]);
    execFileSync("herdr", ["agent", "focus", process.env.HERDR_PANE_ID!]);
    console.log(`closed ${c1}`);
  } catch (e: any) {
    console.error(`spawn-subagent: 关闭失败（pane 不存在或已关闭）: ${c1}`);
    process.exit(1);
  }
} else if (c0 === "resume") {
  const sep = process.argv.indexOf("--");
  const task = sep >= 0 ? process.argv.slice(sep + 1).join(" ") : rest.join(" ");
  if (!c1 || !task.trim()) {
    usage();
    process.exit(1);
  }
  resume(c1, task);
} else {
  const sep = process.argv.indexOf("--");
  const task = sep >= 0 ? process.argv.slice(sep + 1).join(" ") : rest.join(" ");
  if (!c1 || !task.trim()) {
    usage();
    process.exit(1);
  }
  await spawn(c0, c1, task);
}