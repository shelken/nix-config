#!/usr/bin/env bun
// spawn-subagent.ts — 在 Herdr 窗格或 Kitty 窗口中启动/关闭 pi 子代理
// agent 真相源: ~/.pi/agent/agents/<profile>.md（nix 按 omp 的 modelRoles 生成）: frontmatter 定模型/工具，正文作系统提示追加。
// 用法: spawn-subagent <profile> <slug> -- <task> | close <pane-id> | list | --check | -h
import { execFileSync, execSync } from "node:child_process";
import {
  existsSync, lstatSync, mkdirSync, readdirSync, readFileSync,
  rmSync, symlinkSync, writeFileSync,
} from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const scriptDir = dirname(fileURLToPath(import.meta.url));
const agentsDir = join(homedir(), ".pi", "agent", "agents");
const config = JSON.parse(readFileSync(join(scriptDir, "subagent-config.json"), "utf8"));
const AGENT_FIELDS = ["description", "model", "thinking", "tools"];
const subHome = join(homedir(), ".pi", "agent-subagent");

type Agent = {
  name: string; model: string; thinking: string; tools: string;
  exclude: string[]; description: string; body: string;
};

// ---------- 解析 ----------

// 轻量 frontmatter 解析: key: value 与缩进 "- item" 块, 注释/其余行忽略值保留在 md。
function parseFrontmatter(text: string): Record<string, string | string[]> {
  const m = text.match(/^---\n([\s\S]*?)\n---/);
  if (!m) return {};
  const f: Record<string, string | string[]> = {};
  let cur: string | null = null;
  for (const raw of m[1].split("\n")) {
    const line = raw.trimEnd();
    const kv = line.match(/^([A-Za-z0-9_-]+):(.*)$/);
    if (kv) { cur = kv[1]; f[cur] = kv[2].trim(); }
    else if (cur && /^\s+-\s+/.test(line)) {
      const item = line.trim().slice(2);
      f[cur] = Array.isArray(f[cur]) ? [...f[cur], item] : [item];
    }
  }
  return f;
}

// md 缺 model/thinking/tools 任一字段即视为无法解析。
function resolveAgent(profile: string): Agent | null {
  const mdName = existsSync(agentsDir)
    ? readdirSync(agentsDir).find((f) => basename(f, ".md").toLowerCase() === profile.toLowerCase())
    : undefined;
  if (!mdName) return null;
  const text = readFileSync(join(agentsDir, mdName), "utf8");
  const f = parseFrontmatter(text);
  const model = String(f.model ?? ""), thinking = String(f.thinking ?? ""), tools = String(f.tools ?? "");
  if (!model || !thinking || !tools) return null;
  // 插件排除全局统一：所有子代理共用一份派生 settings.json，per-md 无法生效
  return {
    name: profile, model, thinking, tools,
    exclude: (config.exclude ?? []) as string[], description: String(f.description ?? ""),
    body: text.replace(/^---\n[\s\S]*?\n---\n?/, "").trim(),
  };
}

// ---------- 命令 ----------

function herdr(args: string[]): any {
  return JSON.parse(execFileSync("herdr", args, { encoding: "utf8" }));
}
