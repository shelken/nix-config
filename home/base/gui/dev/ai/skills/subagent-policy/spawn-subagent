#!/usr/bin/env bash
# spawn-subagent: 在 Herdr 窗格中启动/关闭 pi 子代理
# 用法:
#   spawn-subagent <profile> -- <task>
#   spawn-subagent close <pane-id>
set -euo pipefail

# ---------- 预设数据 ----------
# 唯一真相源：本目录 subagent-config.json（presets + exclude），脚本每次启动读取。
# 详见 prepare_subagent_env 的派生逻辑与 --check 模式。

usage() {
  cat <<'EOF'
spawn-subagent - 在 Herdr 窗格中启动/关闭 pi 子代理

用法:
  spawn-subagent <profile> <slug> -- <task>   启动子代理，输出 pane ID
  spawn-subagent close <pane-id>              关闭子代理 pane 并聚焦回主 pane
  spawn-subagent --check                      派生 settings + 打印当前预设/排除，不启动
  spawn-subagent -h | --help                  显示本帮助

profile: explore | general-purpose | reviewer | general-purpose-review
         （默认模型/思考深度/工具见同目录 subagent-config.json，改配置即生效）
slug:    任务语义标识，只含小写字母/数字/连字符，超长自动截断（agent 名上限 32 字符）
task:    子代理任务描述（支持多行）
         派发后立即返回 pane ID，主代理结束当前回合，子代理结论经
         intercom 自动注入唤醒（见 SKILL.md 等待模式）

环境变量:
  HERDR_PANE_ID           当前 pane ID（Herdr 环境自动注入，缺失即退出）
  PI_INTERCOM_SESSION_ID  主代理 intercom session ID，子代理回传结论用

子代理环境:
  ~/.pi/agent 是持久状态唯一真相源；~/.pi/agent-subagent 仅隔离派生的
  settings.json、sessions 与 tmp，其余配置、provider 状态和缓存全部共享。

示例:
  spawn-subagent explore fix-parse-errors -- "排查 src/parser 的报错原因"
  spawn-subagent close w11:pK
  spawn-subagent --check
EOF
}

# ---------- 子代理环境（自动派生，零手动维护） ----------
# 主 ~/.pi/agent 是持久状态唯一真相源。子代理只隔离 settings.json、sessions、tmp：
# settings.json 负责插件黑名单；sessions/tmp 属于子进程运行时；其余配置、provider
# 状态与缓存全部链接回主目录，新增顶层状态也会自动继承。
# 脚本源目录（realpath 解析 symlink 到 nix-config 源），配置文件在此目录读取
script_dir="$(dirname "$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")")"

prepare_subagent_env() {
  python3 - "$HOME/.pi/agent" "$HOME/.pi/agent-subagent" "$script_dir/subagent-config.json" <<'PY'
import fcntl, json, os, shutil, sys, tempfile
from pathlib import Path

main_dir, sub_dir, config_path = map(Path, sys.argv[1:4])
sub_dir.mkdir(parents=True, exist_ok=True)
(sub_dir / "sessions").mkdir(exist_ok=True)
(sub_dir / "tmp").mkdir(exist_ok=True)

# 多个子代理可同时启动；目录映射与 settings 更新必须作为一次事务串行完成。
with open(sub_dir / "tmp" / "prepare.lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)

    for src in main_dir.iterdir():
        if src.name in {"settings.json", "sessions", "tmp"}:
            continue
        dst = sub_dir / src.name
        if dst.is_symlink() and dst.resolve() == src.resolve():
            continue
        if dst.is_symlink() or dst.is_file():
            dst.unlink()
        elif dst.is_dir():
            shutil.rmtree(dst)
        dst.symlink_to(src, target_is_directory=src.is_dir())

    with open(main_dir / "settings.json") as f:
        main = json.load(f)
    with open(config_path) as f:
        cfg = json.load(f)
    exclude = set(cfg.get("exclude", []))

    def pkg_name(package):
        # 任意形态（npm:/git:repo/本地路径/对象包）都按最后一段裸名匹配黑名单。
        if isinstance(package, dict):
            package = package.get("source")
        if not isinstance(package, str):
            return None
        source = package.lstrip("-")
        if ":" in source and not source.startswith("/"):
            source = source.split(":", 1)[1]
        parts = [part for part in source.split("/") if part]
        return parts[-1] if parts else None

    derived = {key: value for key, value in main.items() if key != "packages"}
    derived["packages"] = []
    for package in main.get("packages", []):
        name = pkg_name(package)
        disabled = isinstance(package, str) and package.startswith("-")
        derived["packages"].append("-" + package if name in exclude and not disabled else package)

    fd, tmp_path = tempfile.mkstemp(dir=sub_dir, prefix="settings.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(derived, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp_path, sub_dir / "settings.json")
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
PY
}

# ---------- --check / 帮助：零 pane 副作用，任何环境可用 ----------
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == "--check" ]]; then
  prepare_subagent_env
  python3 - "$script_dir/subagent-config.json" <<'PY'
import json, sys
cfg = json.load(open(sys.argv[1]))
for name, p in cfg.get("presets", {}).items():
    print(f"{name}: model={p['model']} thinking={p['thinking']} tools={p['tools']}")
print("exclude:", ", ".join(cfg.get("exclude", [])))
PY
  exit 0
fi

# ---------- 前置检查 ----------
require_env() {
  if [[ -z "${!1:-}" ]]; then
    echo "spawn-subagent: 环境变量 $1 缺失" >&2
    exit 1
  fi
}

# HERDR_PANE_ID 缺失 = 非 Herdr 环境（Kitty 等）
if [[ -z "${HERDR_PANE_ID:-}" ]]; then
  echo "spawn-subagent: 当前仅支持 Herdr（未检测到 HERDR_PANE_ID）" >&2
  exit 1
fi
require_env PI_INTERCOM_SESSION_ID

# ---------- close ----------
if [[ "${1:-}" == "close" ]]; then
  pane_id="${2:-}"
  if [[ -z "$pane_id" ]]; then
    echo "spawn-subagent: close 需要 pane-id 参数" >&2
    usage
    exit 1
  fi
  herdr pane close "$pane_id" >/dev/null
  herdr agent focus "$HERDR_PANE_ID" >/dev/null
  echo "closed $pane_id"
  exit 0
fi

if [[ "$#" -lt 4 ]]; then
  usage
  exit 1
fi

profile="$1"
slug="$2"
shift 2

[[ "${1:-}" == "--" ]] && shift
task="$*"

# ---------- slug 校验（herdr agent name 仅小写字母/数字/-/_） ----------
if [[ ! "$slug" =~ ^[a-z0-9-]+$ ]]; then
  echo "spawn-subagent: slug 只能含小写字母/数字/连字符: '$slug'" >&2
  exit 1
fi
# agent name 由 profile-slug-时间戳 组成,herdr 上限 32 字符,超长自动截断:
# 先截 slug(保留 profile 语义),profile 本身超预算才截 profile,时间戳保证唯一。
budget=$((32 - 12))  # 12 = 2 个连字符 + 10 位时间戳(到 2286 年)
if (( ${#profile} + 1 + ${#slug} > budget )); then
  max_slug=$((budget - ${#profile} - 1))
  if (( max_slug < 1 )); then
    profile="${profile:0:budget}"
    slug=""
  else
    slug="${slug:0:max_slug}"
    slug="${slug%-}"  # 截断后不以连字符结尾
  fi
fi
if [[ -n "$slug" ]]; then
  agent_name="${profile}-${slug}-$(date +%s)"
else
  agent_name="${profile}-$(date +%s)"
fi

# ---------- 读取预设（配置为唯一真相源） ----------
preset_json=$(python3 - "$script_dir/subagent-config.json" "$profile" <<'PY'
import json, sys
cfg = json.load(open(sys.argv[1]))
presets = cfg.get("presets", {})
if sys.argv[2] not in presets:
    print("__UNKNOWN__")
    sys.exit(0)
print(json.dumps(presets[sys.argv[2]]))
PY
)
if [[ "$preset_json" == "__UNKNOWN__" ]]; then
  echo "spawn-subagent: 未知 profile '$profile'，可用: $(python3 -c "import json,sys; print(', '.join(json.load(open(sys.argv[1])).get('presets',{}).keys()))" "$script_dir/subagent-config.json")" >&2
  exit 1
fi
model=$(jq -r '.model' <<<"$preset_json")
thinking=$(jq -r '.thinking' <<<"$preset_json")
tools=$(jq -r '.tools' <<<"$preset_json")

# ---------- 布局：首个右侧分列，后续在右列内向下堆叠 ----------
# 新增后重新均分右列（所有 pane 等高，自适应，不限制数量），
# 避免无限对半分割导致 pane 越分越小。
layout_json=$(herdr pane layout --pane "$HERDR_PANE_ID")
# 主 pane 的 x：作为右侧判断基准
main_x=$(jq -r --arg id "$HERDR_PANE_ID" '
  .result.layout.panes[] | select(.pane_id == $id) | .rect.x
' <<<"$layout_json")
# 右侧最底部 pane
right_panes=$(jq -r --arg main_x "$main_x" '
  [.result.layout.panes[] | select(.rect.x > ($main_x | tonumber))]
  | sort_by(.rect.y)
' <<<"$layout_json")
target_pane=$(jq -r 'last | .pane_id' <<<"$right_panes")

if [[ "$target_pane" == "null" || -z "$target_pane" ]]; then
  new_pane=$(herdr pane split --pane "$HERDR_PANE_ID" --direction right --ratio 0.55 --no-focus |
    jq -r '.result.pane.pane_id')
else
  new_pane=$(herdr pane split --pane "$target_pane" --direction down --ratio 0.5 --no-focus |
    jq -r '.result.pane.pane_id')
fi
# 后续任何命令失败(set -e 退出)时关闭已 split 的 pane,避免残留空 pane
trap 'herdr pane close "$new_pane" >/dev/null 2>&1 || true' ERR

# 均分右列：新增后把同一列的所有 pane 调整为等高（从下往上逐个 resize）
rebalance_column() {
  local layout col_x panes n col_top col_bot i
  layout=$(herdr pane layout --pane "$HERDR_PANE_ID")
  col_x=$(jq -r --arg id "$new_pane" '.result.layout.panes[] | select(.pane_id == $id) | .rect.x' <<<"$layout")
  mapfile -t panes < <(jq -r --argjson x "$col_x" \
    '[.result.layout.panes[] | select(.rect.x == $x)] | sort_by(.rect.y) | .[].pane_id' <<<"$layout")
  n=${#panes[@]}
  [[ "$n" -lt 2 ]] && return
  # 嵌套 split 的 ratio 目标:第 i 条 down split 的顶部 pane 占其父区域 1/(n-i)
  for ((i = n - 2; i >= 0; i--)); do
    local cur_ratio target_ratio delta dir
    cur_ratio=$(jq -r --argjson i "$i" \
      '[.result.layout.splits[] | select(.direction == "down")] | sort_by(.rect.y) | .[$i] | .ratio' <<<"$layout")
    target_ratio=$(python3 -c "print(1 / ($n - $i))")
    delta=$(python3 -c "print(round($target_ratio - $cur_ratio, 6))")
    if [[ "$delta" == "0" || "$delta" == "0.0" || "$delta" == "-0.0" ]]; then
      continue
    fi
    # 调整 pane_i 与其下方 pane 的边界 split:增大用 panes[i] down(+delta),
    # 减小用 panes[i+1] up(+|delta|)(herdr CLI 不接受负 amount,
    # 且 panes[i] up 会找上方边界而非本边界)
    if python3 -c "exit(0 if $delta > 0 else 1)"; then
      herdr pane resize --pane "${panes[$i]}" --direction down --amount "$delta" >/dev/null
    else
      delta=$(python3 -c "print(-$delta)")
      herdr pane resize --pane "${panes[$((i + 1))]}" --direction up --amount "$delta" >/dev/null
    fi
    layout=$(herdr pane layout --pane "$HERDR_PANE_ID")
  done
}
rebalance_column

# ---------- 协调 prompt ----------
prompt="你是通过 spawn-subagent 启动的 pi 子代理（profile: ${profile}）。

回传协议：
- 完成或受阻时，用 intercom 工具向主代理 session 发送一条结论消息：
  intercom({ action: \"send\", to: \"${PI_INTERCOM_SESSION_ID}\", message: \"<结论>\" })
- 消息格式由下方任务描述，不设固定字段。
- 阻塞或失败时保留当前 pane 供主代理检查，不要自行关闭。

任务原文：
---
${task}
---"

# ---------- 启动 ----------
prepare_subagent_env
# 等待 pane shell 就绪后注入 PI_CODING_AGENT_DIR（agent start 启动的 pi 继承该 env）
sleep 2
herdr pane run "$new_pane" "export PI_CODING_AGENT_DIR=$HOME/.pi/agent-subagent" >/dev/null
sleep 1
# 多行 prompt 无法安全编码进 agent start 的 shell 参数，分两步：
# 先启动空 pi，等待就绪后通过 agent prompt（socket API）提交协调 prompt。
# agent name 已在上方构造并校验长度;时间戳区分并发/重复 slug。
herdr agent start "$agent_name" --kind pi --pane "$new_pane" -- \
  --model "$model" \
  --thinking "$thinking" \
  --tools "$tools" >/dev/null

# 等待 pi 就绪并确认 prompt 送达：不带 --wait 时，pi 未就绪提交不注入
# （无 agent_prompted 事件，可安全重试）；就绪后注入即有 agent_prompted，
# 立即 break，与回合长度无关，绝不重发已送达的 prompt。
for _ in $(seq 1 20); do
  if herdr agent prompt "$new_pane" "$prompt" 2>/dev/null | grep -q '"type":"agent_prompted"'; then
    break
  fi
  sleep 2
done

# 验证 agent 真实启动（agent start 可能声称成功但会话未起来），失败即关 pane
if ! herdr agent get "$agent_name" >/dev/null 2>&1; then
  echo "spawn-subagent: agent $agent_name 未成功启动，已关闭 pane $new_pane" >&2
  herdr pane close "$new_pane" >/dev/null 2>&1 || true
  exit 1
fi

echo "$new_pane"
