#!/usr/bin/env bun
// spawn-subagent.ts — 在 Herdr 窗格中启动/关闭 pi 子代理
// agent 真相源: ~/.pi/agent/agents/<profile>.md frontmatter; subagent-config.json 仅作全局默认。
// 用法: spawn-subagent <profile> <slug> -- <task> | close <pane-id> | list | --check | -h
import { execFileSync, execSync } from "node:child_process";
import {
  existsSync, lstatSync, mkdirSync, readdirSync, readFileSync,
  rmSync, symlinkSync, writeFileSync,
} from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const scriptDir = dirname(fileURLToPath(import.meta.url));
const agentDir = process.env.PI_CODING_AGENT_DIR || join(homedir(), ".pi", "agent");
const subagentDir = join(dirname(agentDir), `${basename(agentDir)}-subagent`);
const agentsDir = join(agentDir, "agents");

function loadSubagentConfig(): any {
  const primary = join(agentDir, "subagent-config.json");
  if (existsSync(primary)) return JSON.parse(readFileSync(primary, "utf8"));
  const fallback = join(scriptDir, "subagent-config.json");
  if (existsSync(fallback)) return JSON.parse(readFileSync(fallback, "utf8"));
  throw new Error(`未找到 subagent-config.json（搜索路径: ${primary}, ${fallback}）`);
}

const config = loadSubagentConfig();
const AGENT_FIELDS = ["description", "model", "thinking", "tools"];

type Agent = {
  name: string; model: string; thinking: string; tools: string;
  exclude: string[]; description: string; md?: string;
};

// ---------- 解析 ----------

// 轻量 frontmatter 解析: key: value 与缩进 "- item" 块, 注释/其余行忽略值保留在 md。
function parseFrontmatter(text: string): Record<string, string | string[]> {
  const m = text.match(/^---\n([\s\S]*?)\n---/);
  if (!m) return {};
  const f: Record<string, string | string[]> = {};
  let cur: string | null = null;
  for (const raw of m[1].split("\n")) {
    const line = raw.trimEnd();
    const kv = line.match(/^([A-Za-z0-9_-]+):(.*)$/);
    if (kv) { cur = kv[1]; f[cur] = kv[2].trim(); }
    else if (cur && /^\s+-\s+/.test(line)) {
      const item = line.trim().slice(2);
      f[cur] = Array.isArray(f[cur]) ? [...f[cur], item] : [item];
    }
  }
  return f;
}

// md 显式值 > config 预设; md 无对应文件时退回 config 预设。
function resolveAgent(profile: string): Agent | null {
  const preset = config.presets?.[profile.toLowerCase()] ?? {};
  const mdName = existsSync(agentsDir)
    ? readdirSync(agentsDir).find((f) => basename(f, ".md").toLowerCase() === profile.toLowerCase())
    : undefined;
  const f = mdName ? parseFrontmatter(readFileSync(join(agentsDir, mdName), "utf8")) : {};
  const has = (k: string) => Object.prototype.hasOwnProperty.call(f, k);
  const pick = (k: string, d: string) => (has(k) ? String(f[k]) : d);
  const model = pick("model", preset.model);
  const thinking = pick("thinking", preset.thinking);
  const tools = pick("tools", preset.tools);
  if (!model || !thinking || !tools) return null;
  // 插件排除全局统一：所有子代理共用一份派生 settings.json，per-md 无法生效
  return {
    name: profile, model, thinking, tools,
    exclude: (config.exclude ?? []) as string[], description: (f.description as string) ?? "",
    ...(mdName ? { md: join(agentsDir, mdName) } : {}),
  };
}

// ---------- 命令 ----------

