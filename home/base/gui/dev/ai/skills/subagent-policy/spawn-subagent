#!/usr/bin/env bun
// spawn-subagent.ts — 在 Herdr 窗格中启动/关闭 pi 子代理
// agent 真相源: ~/.pi/agent/agents/<profile>.md frontmatter; subagent-config.json 仅作全局默认。
// 用法: spawn-subagent <profile> <slug> -- <task> | close <pane-id> | list | --check | -h
import { execFileSync, execSync } from "node:child_process";
import {
  existsSync, lstatSync, mkdirSync, readdirSync, readFileSync,
  rmSync, symlinkSync, writeFileSync,
} from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const scriptDir = dirname(fileURLToPath(import.meta.url));
const agentsDir = join(homedir(), ".pi", "agent", "agents");
const config = JSON.parse(readFileSync(join(scriptDir, "subagent-config.json"), "utf8"));
const AGENT_FIELDS = ["description", "model", "thinking", "tools", "exclude_extensions"];

type Agent = {
  name: string; model: string; thinking: string; tools: string;
  exclude: string[]; description: string; md?: string;
};

// ---------- 解析 ----------

// 轻量 frontmatter 解析: key: value 与缩进 "- item" 块, 注释/其余行忽略值保留在 md。
function parseFrontmatter(text: string): Record<string, string | string[]> {
  const m = text.match(/^---\n([\s\S]*?)\n---/);
  if (!m) return {};
  const f: Record<string, string | string[]> = {};
  let cur: string | null = null;
  for (const raw of m[1].split("\n")) {
    const line = raw.trimEnd();
    const kv = line.match(/^([A-Za-z0-9_-]+):(.*)$/);
    if (kv) { cur = kv[1]; f[cur] = kv[2].trim(); }
    else if (cur && /^\s+-\s+/.test(line)) {
      const item = line.trim().slice(2);
      f[cur] = Array.isArray(f[cur]) ? [...f[cur], item] : [item];
    }
  }
  return f;
}

// md 显式值 > config 预设; md 无对应文件时退回 config 预设。
function resolveAgent(profile: string): Agent | null {
  const preset = config.presets?.[profile.toLowerCase()] ?? {};
  const mdName = existsSync(agentsDir)
    ? readdirSync(agentsDir).find((f) => basename(f, ".md").toLowerCase() === profile.toLowerCase())
    : undefined;
  const f = mdName ? parseFrontmatter(readFileSync(join(agentsDir, mdName), "utf8")) : {};
  const has = (k: string) => Object.prototype.hasOwnProperty.call(f, k);
  const pick = (k: string, d: string) => (has(k) ? String(f[k]) : d);
  const model = pick("model", preset.model);
  const thinking = pick("thinking", preset.thinking);
  const tools = pick("tools", preset.tools);
  if (!model || !thinking || !tools) return null;
  const exclude = has("exclude_extensions")
    ? (Array.isArray(f.exclude_extensions) ? f.exclude_extensions : [])
    : (config.exclude ?? []);
  return {
    name: profile, model, thinking, tools,
    exclude: exclude as string[], description: (f.description as string) ?? "",
    ...(mdName ? { md: join(agentsDir, mdName) } : {}),
  };
}

// ---------- 命令 ----------

function herdr(args: string[]): any {
  return JSON.parse(execFileSync("herdr", args, { encoding: "utf8" }));
}
function usage() {
  console.log(`spawn-subagent - 在 Herdr 窗格中启动/关闭 pi 子代理

用法:
  spawn-subagent <profile> <slug> -- <task>   启动子代理，输出 pane ID
  spawn-subagent resume <pane-id> -- <task>   复用已有 agent pane，注入新任务（不重启）
  spawn-subagent list                         列出所有 agent(name/model/thinking/tools/描述)
  spawn-subagent --check                      派生 settings + 打印所有 agent 生效值，不启动
  spawn-subagent close <pane-id>              关闭子代理 pane 并聚焦回主 pane
  spawn-subagent -h | --help                  显示本帮助

profile: 对应 ~/.pi/agent/agents/<profile>.md（文件名小写匹配）；frontmatter 的
         model/thinking/tools/exclude_extensions 为唯一真相源，subagent-config.json
         仅作全局默认，被具体 md 显式值覆盖。
slug:    任务语义标识（小写字母/数字/连字符，agent 名上限 32 字符）
task:    子代理任务描述，支持多行；派发后立即返回 pane ID，结论经 intercom 回传

env: HERDR_PANE_ID, PI_INTERCOM_SESSION_ID`);
}

function listAgents() {
  if (!existsSync(agentsDir)) return console.error(`agents 目录不存在: ${agentsDir}`);
  for (const f of readdirSync(agentsDir).filter((x) => x.endsWith(".md"))) {
    const g = resolveAgent(basename(f, ".md"));
    if (!g) {
      console.log(`${basename(f, ".md")}: <缺少 model/thinking/tools 字段，无法解析>`);
      continue;
    }
    console.log(`${g.name}: model=${g.model} thinking=${g.thinking} tools=[${g.tools}]`);
    console.log(`  description: ${g.description}`);
  }
}

// 子代理环境: ~/.pi/agent-subagent 只隔离 settings/sessions/tmp, 其余链接回主目录;
// packages 里命中 exclude 的包加 "-" 前缀禁用。
function prepareEnv(exclude: string[]) {
  const main = join(homedir(), ".pi", "agent");
  const sub = join(homedir(), ".pi", "agent-subagent");
  mkdirSync(join(sub, "sessions"), { recursive: true });
  mkdirSync(join(sub, "tmp"), { recursive: true });
  for (const ent of readdirSync(main)) {
    if (["settings.json", "sessions", "tmp"].includes(ent)) continue;
    const src = join(main, ent), dst = join(sub, ent);
    try { rmSync(dst, { recursive: true, force: true }); } catch { /* 首次无 dst */ }
    symlinkSync(src, dst, lstatSync(src).isDirectory() ? "dir" : "file");
  }
  const pkgName = (p: any): string | null => {
    if (p && typeof p === "object") p = p.source;
    if (typeof p !== "string" || !p) return null;
    const s = p.replace(/^-/, "");
    const bare = s.includes(":") && !s.startsWith("/") ? s.split(":").slice(1).join(":") : s;
    return bare.split("/").filter(Boolean).at(-1) ?? null;
  };
  const settings = JSON.parse(readFileSync(join(main, "settings.json"), "utf8"));
  settings.packages = settings.packages.map((p: any) => {
    const name = pkgName(p);
    if (name && exclude.includes(name)) {
      if (p && typeof p === "object") {
        const src = String(p.source);
        return src.startsWith("-") ? p : { ...p, source: "-" + src };
      }
      if (typeof p === "string" && !p.startsWith("-")) return "-" + p;
    }
    return p;
  });
  writeFileSync(join(sub, "settings.json"), JSON.stringify(settings, null, 2) + "\n");
}

// 布局: 首个右侧分列(55%), 后续右列内向下堆叠并均分等高
function layoutPane(mainPane: string): string {
  const layout = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
  const mainX = layout.panes.find((p: any) => p.pane_id === mainPane).rect.x;
  const right = layout.panes
    .filter((p: any) => p.rect.x > mainX)
    .sort((a: any, b: any) => a.rect.y - b.rect.y);
  const target = right.at(-1)?.pane_id;
  const newPane = target
    ? herdr(["pane", "split", "--pane", target, "--direction", "down", "--ratio", "0.5", "--no-focus"]).result.pane.pane_id
    : herdr(["pane", "split", "--pane", mainPane, "--direction", "right", "--ratio", "0.55", "--no-focus"]).result.pane.pane_id;
  // 均分右列: 从下往上把同列 panes 逐步调成 1/(n-i) 占比
  for (let i = 0; i < 6; i++) {
    const l = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
    const panes = l.panes
      .filter((p: any) => p.rect.x === l.panes.find((q: any) => q.pane_id === newPane).rect.x)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    const n = panes.length;
    if (n < 2) break;
    const colX = l.panes.find((q: any) => q.pane_id === newPane).rect.x;
    const splits = l.splits
      .filter((s: any) => s.direction === "down" && Math.abs((s.rect?.x ?? -1) - colX) < 1)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    let changed = false;
    for (let k = n - 2; k >= 0; k--) {
      const cur = splits[k].ratio, want = 1 / (n - k);
      const delta = Math.round((want - cur) * 1e6) / 1e6;
      if (delta === 0) continue;
      const dir = delta > 0 ? "down" : "up";
      const pane = delta > 0 ? panes[k] : panes[k + 1];
      herdr(["pane", "resize", "--pane", pane.pane_id, "--direction", dir, "--amount", String(Math.abs(delta))]);
      changed = true;
    }
    if (!changed) break;
  }
  return newPane;
}

// 复用已有 agent（指定 pane）：注入新任务，不重启、不新建 pane。
// 首次 spawn 已注入回传协议；此处仅提醒回传给主代理 session
function resume(paneId: string, task: string) {
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!intercom) {
    console.error("spawn-subagent: resume 需要 PI_INTERCOM_SESSION_ID");
    process.exit(1);
  }
  const prompt = `（会话延续）新任务，完成后用 intercom 向主代理 session 回传结论（${intercom}）:\n---\n${task}`;
  let prompted = false;
  for (let i = 0; i < 20 && !prompted; i++) {
    try {
      const out = execFileSync("herdr", ["agent", "prompt", paneId, prompt], { encoding: "utf8" });
      prompted = out.includes('"type":"agent_prompted"');
    } catch { /* 未就绪或 pane 已关闭, 重试 */ }
    if (!prompted) execSync("sleep 2");
  }
  if (!prompted) {
    console.error(`spawn-subagent: resume 注入失败（20 次重试后 pane '${paneId}' 未就绪或已关闭）`);
    process.exit(1);
  }
  console.log(paneId);
}

function spawn(profile: string, slug: string, task: string) {
  const g = resolveAgent(profile);
  if (!g) {
    console.error(`spawn-subagent: profile '${profile}' 无法解析（agents 目录无对应 md，或缺少 model/thinking/tools 字段）`);
    process.exit(1);
  }
  if (!slug.match(/^[a-z0-9-]+$/)) {
    console.error(`spawn-subagent: slug 只能含小写字母/数字/连字符: '${slug}'`);
    process.exit(1);
  }
  const mainPane = process.env.HERDR_PANE_ID;
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!mainPane || !intercom) {
    console.error("spawn-subagent: 需要 HERDR_PANE_ID 与 PI_INTERCOM_SESSION_ID");
    process.exit(1);
  }
  const ts = Date.now().toString(36); // 唯一后缀，保证不被截断
  const slugBudget = 32 - 1 - ts.length - 1 - profile.length; // ${profile}-${slug}-${ts} 两个分隔符
  let agentName: string;
  if (slugBudget >= 1) {
    agentName = `${profile}-${slug.slice(0, slugBudget).replace(/-$/, "")}-${ts}`;
  } else {
    // slug 无空间：牺牲 profile 长度保时间戳
    agentName = `${profile.slice(0, 32 - 1 - ts.length).replace(/-$/, "")}-${ts}`;
  }
  if (agentName.length > 32) {
    console.error(`spawn-subagent: 无法构造 32 字符内的 agent 名（profile='${profile}' slug='${slug}'）`);
    process.exit(1);
  }
  const newPane = layoutPane(mainPane);
  try {
    prepareEnv(g.exclude);
    execFileSync("herdr", ["pane", "run", newPane, `export PI_CODING_AGENT_DIR=${homedir()}/.pi/agent-subagent`]);
    herdr(["agent", "start", agentName, "--kind", "pi", "--pane", newPane, "--", "--model", g.model, "--thinking", g.thinking, "--tools", g.tools]);
    const prompt = `你是通过 spawn-subagent 启动的 pi 子代理（profile: ${profile}）。

回传协议:
- 完成或受阻时，用 intercom 工具向主代理 session 发送一条结论消息:
  intercom({ action: "send", to: "${intercom}", message: "<结论>" })
- 消息格式由下方任务描述，不设固定字段。
- 阻塞或失败时保留当前 pane 供主代理检查，不要自行关闭。

任务原文:
---
${task}
---`;
    let prompted = false;
    for (let i = 0; i < 20 && !prompted; i++) {
      try {
        const out = execFileSync("herdr", ["agent", "prompt", newPane, prompt], { encoding: "utf8" });
        prompted = out.includes('"type":"agent_prompted"');
      } catch { /* pane 未就绪, 重试 */ }
      if (!prompted) execSync("sleep 2");
    }
    if (!prompted) throw new Error("prompt 注入失败（20 次重试后 pane 未就绪）");
    console.log(newPane);
  } catch (e: any) {
    try { execFileSync("herdr", ["pane", "close", newPane]); } catch { /* 已关闭 */ }
    console.error("spawn-subagent: 启动失败:", String(e.message ?? e));
    process.exit(1);
  }
}

// ---------- main ----------
const [c0, c1, ...rest] = process.argv.slice(2);
if (!c0 || c0 === "-h" || c0 === "--help") {
  usage();
} else if (c0 === "list") {
  listAgents();
} else if (c0 === "--check") {
  prepareEnv(config.exclude ?? []);
  console.log(`派生 settings.json 就绪: ${join(homedir(), ".pi", "agent-subagent", "settings.json")}`);
  console.log(`全局默认 exclude(仅当 md 未声明 exclude_extensions 时生效): ${JSON.stringify(config.exclude ?? [])}\n`);
  listAgents();
} else if (c0 === "close") {
  if (!c1) {
    console.error("spawn-subagent: close 需要 pane-id 参数");
    process.exit(1);
  }
  execFileSync("herdr", ["pane", "close", c1]);
  execFileSync("herdr", ["agent", "focus", process.env.HERDR_PANE_ID!]);
  console.log(`closed ${c1}`);
} else if (c0 === "resume") {
  const sep = process.argv.indexOf("--");
  const task = sep >= 0 ? process.argv.slice(sep + 1).join(" ") : rest.join(" ");
  if (!c1 || !task.trim()) {
    usage();
    process.exit(1);
  }
  resume(c1, task);
} else {
  const sep = process.argv.indexOf("--");
  const task = sep >= 0 ? process.argv.slice(sep + 1).join(" ") : rest.join(" ");
  if (!c1 || !task.trim()) {
    usage();
    process.exit(1);
  }
  spawn(c0, c1, task);
}