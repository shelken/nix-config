#!/usr/bin/env bash
# focus-guard 启动器：首次自动编译 swift 源码到 ~/.cache/computer-use/，之后直接调用
set -euo pipefail

CACHE_DIR="${HOME}/.cache/computer-use"
BIN="$CACHE_DIR/focus-guard"
SRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="$SRC_DIR/focus-guard.swift"

# --help/-h/无参 不需编译，直接显示帮助
if [ $# -eq 0 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
focus-guard <seconds>

在指定秒数内保护当前前台 app 不被其他 app 抢焦点。
先后台启动 guard，再启动目标 app；guard 退出前所有抢焦点的行为都会被切回原前台。

参数：
  seconds    保护时长（秒，正数）
  -h, --help 显示本帮助

示例：
  focus-guard 15 &       # 后台保护 15 秒
  open -a SomeApp        # 在保护窗口内启动抢焦点的 app

首次使用自动编译（约 30s，仅一次），产物缓存在 ~/.cache/computer-use/
EOF
    exit 0
fi

needs_compile() {
    [ ! -x "$BIN" ] || [ "$SRC" -nt "$BIN" ]
}

if needs_compile; then
    mkdir -p "$CACHE_DIR"
    echo "focus-guard: 编译中（约 30s，仅一次）..." >&2
    start=$(date +%s)
    if ! swiftc -O -o "$BIN" "$SRC" >&2; then
        echo "focus-guard: 编译失败。确保已装 Xcode Command Line Tools：xcode-select --install" >&2
        exit 1
    fi
    mkdir -p "$CACHE_DIR"
    echo "focus-guard: 编译完成（$(($(date +%s) - start))s）" >&2
fi

exec "$BIN" "$@"
