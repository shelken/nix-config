{
  log {
    level INFO
    output file /var/log/caddy/access.log {
     	roll_size 30MiB
     	roll_keep 10
    }
  }
  metrics {
    per_host
  }
  # Caddy 管理面无认证（GET /config/ 可读含已替换 CF token 的生效配置、POST /load 可重配整站），因此仅绑定容器内 unix socket
  admin unix//run/caddy-admin.sock
  servers {
    protocols h1 h2 h3
  }
  crowdsec {
    api_url {$CROWDSEC_LOCAL_API_URL}
    api_key {$CROWDSEC_CADDY_BOUNCER_API_KEY}
    ticker_interval 15s
    appsec_url http://crowdsec-agent:7422
    # 必须大于 crowdsec-agent 的 auth_timeout(2s)，否则内层认证耗尽外层预算
    appsec_timeout 5s
  }
}

# 注意：容器里想手动 reload 要用 caddy reload --address unix//run/caddy-admin.sock
http://:2019 {
  @readonly {
    method GET
    path /metrics /reverse_proxy/upstreams
  }
  handle @readonly {
    reverse_proxy unix//run/caddy-admin.sock {
      header_up Host localhost
    }
  }
  handle {
    respond "forbidden" 403
  }
}

(with-tls) {
   tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        # 本机 :53 不可信、certmagic 不支持 DoH：改由 LE 从公网侧直查 CF 权威校验，延迟用于等 CF 边缘发布
        propagation_timeout -1
        propagation_delay 30s
    }
}

(common_to_proxy_headers) {
  flush_interval -1
}

(common_header) {
  header {
    +My-Server "vps"
    -Server
    -via
  }
}

(empty) {

}

(reverse_template) {
  reverse_proxy {
    to {args[0]}
    import common_to_proxy_headers
    import {args[1]}
    header_up Host {http.request.host}
    transport http {
      import {args[2]}

      dial_timeout 10s
      response_header_timeout 30s

      keepalive 300s
      keepalive_idle_conns 100
      keepalive_interval 30s
    }
  }
}

(tls_common) {
  tls
  tls_server_name {http.request.host}
}

(to_external) {
  import reverse_template https://{$ENVOY_EXTERNAL_IP}:443 empty tls_common
}

(to_host) {
  import reverse_template http://172.20.0.1:{args[0]} empty empty
}

(skip-tls) {
  tls
  tls_insecure_skip_verify
}
(to_docker) {
  import reverse_template http://{args[0]}:{args[1]} empty empty
}

(robots_ban) {
  header /robots.txt {
    Content-Type "text/plain"
    X-Robots-Tag "noindex, nofollow"
  }
  respond /robots.txt <<HTML
  User-agent: *
  Disallow: /
  HTML 200
}

(service2) {
  @{args[0]} host {args[0]}.{$MAIN_DOMAIN}
  handle @{args[0]} {
    import {args[1]} {args[2]}
    import {args[3]}
    import common_header
  }
}

(service_docker) {
  @{args[0]} host {args[0]}.{$MAIN_DOMAIN}
  handle @{args[0]} {
    import to_docker {args[1]} {args[2]}
    import {args[3]}
    import common_header
  }
}

*.{$MAIN_DOMAIN} {
  import with-tls

  # 没有这条指令 Caddy 不产生访问日志，不经反代的请求（被封禁、被 Caddy 直接应答）也就看不到
  log

  route {
    crowdsec
    appsec

    import service_docker subs      sbtools-server 8080  robots_ban
    import service2       derp      to_host       8666  empty
    import service_docker dhp       dhp           5000 robots_ban
    import service_docker vdns      mosdns        9053 robots_ban

    handle {
      import to_external
      import common_header
    }
  }
}

# health 只能靠 filters 区分（Homepage 从 filter 推断 health），所以按 query 形状应答。
http://:2576 {
  root * /srv/homepage-docker

  @list path /containers/json
  handle @list {
    header Content-Type application/json

    @non_healthy expression query({'filters': '*'}) && {query.filters}.matches('"health"\\s*:\\s*\\[[^\\]]*"(unhealthy|starting)"')
    handle @non_healthy {
      respond "[]"
    }

    handle {
      file_server
    }
  }

  handle {
    respond 404
  }
}
