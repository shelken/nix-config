{
  "storage": {
    "type": "filesystem",
    "config": {
      "path": "/repo"
    }
  },
  "caching": {
    "maxCacheSize": 524288000,
    "contentCacheSizeLimitBytes": 1073741824,
    "maxMetadataCacheSize": 524288000,
    "metadataCacheSizeLimitBytes": 1073741824,
    "maxListCacheDuration": 30
  }
}
