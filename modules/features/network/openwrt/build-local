#!/usr/bin/env bash
set -euo pipefail
mode=$1 firmware=$2 uci=$3 imagebuilder=$4 lock=$5 dir=$6 builder=$7
keep=3

die() { echo "build-local: $*" >&2; exit 1; }
[[ $mode == update || $mode == build ]] || die "未知模式 $mode"

request=$(jq -n --slurpfile f "$firmware" --slurpfile u "$uci" '
  $f[0] | del(.server) + {
    packages: ($f[0].packages + $u[0].packages | unique),
    client: "nix-config"
  }')

if [[ $mode == build ]]; then
  [[ -f $lock ]] || die "没有锁文件，先 update"
  [[ $(jq -S .request "$lock") == "$(jq -S . <<<"$request")" ]] ||
    die "声明与锁文件的请求不一致，先 update 并审查锁文件的 diff"
fi

input=$(jq -n --argjson req "$request" --argjson ib "$imagebuilder" '{
  request: $req,
  imagebuilder: $ib
}')

echo "build-local: 在 $builder 上构建"
jq -c . <<<"$request"

payload=$(ssh -- "$builder" openwrt-imagebuild <<<"$input")
result=$(jq '.result' <<<"$payload")
remote_image=$(jq -r '.remote_image' <<<"$payload")

if [[ $mode == build ]]; then
  drift=$(jq -rn --slurpfile l "$lock" --argjson r "$result" '
    ($l[0].manifest) as $a | ($r.manifest) as $b
    | ($a + $b | keys[]) as $k | select($a[$k] != $b[$k])
    | "\($k): \($a[$k] // "-") -> \($b[$k] // "-")"')
  [[ -z $drift ]] || die "构建出的包版本与锁文件不一致，软件源已更新；要接受就 update：
$drift"
fi

if [[ $mode == build ]]; then
  lock_name=$(jq -r '.image.name' "$lock")
  lock_sha=$(jq -r '.image.sha256' "$lock")
  [[ -n $lock_name && $lock_name != null && -n $lock_sha && $lock_sha != null ]] ||
    die "锁文件缺少 image.name 或 image.sha256"
  target_name=$lock_name
  expected_sha=$lock_sha
else
  target_name=$(jq -r '.image.name' <<<"$result")
  expected_sha=$(jq -r '.image.sha256' <<<"$result")
fi

part=""
lock_tmp=""
cleanup() {
  if [[ -n $part ]]; then rm -f "$part"; fi
  if [[ -n $lock_tmp ]]; then rm -f "$lock_tmp"; fi
}
trap cleanup EXIT

mkdir -p "$dir"
if [[ $mode == build ]] || [[ ! -f $dir/$target_name ]] || [[ $(shasum -a 256 "$dir/$target_name" | cut -d' ' -f1) != "$expected_sha" ]]; then
  part=$(mktemp "$dir/${target_name}.part.XXXXXX")
  scp -- "${builder}:${remote_image}" "$part"
  actual_sha=$(shasum -a 256 "$part" | cut -d' ' -f1)
  if [[ $actual_sha != "$expected_sha" ]]; then
    if [[ $mode == build ]]; then
      die "构建镜像 sha256 与锁文件不符（换后端构建需先 update）: 期望 $expected_sha，实际 $actual_sha"
    fi
    die "sha256 不符: $target_name"
  fi
  mv -f "$part" "$dir/$target_name"
  part=""
fi

if [[ $mode == update ]]; then
  lock_tmp=$(mktemp "${lock}.tmp.XXXXXX")
  jq . <<<"$result" >"$lock_tmp"
  mv -f "$lock_tmp" "$lock"
  lock_tmp=""
fi

current=$(jq -r .image.name "$lock")
shopt -s nullglob
images=("$dir"/*-sysupgrade.bin)
if ((${#images[@]} > keep)); then
  for ((i = 1; i < ${#images[@]}; i++)); do
    cur=${images[i]}
    j=$((i - 1))
    while ((j >= 0)) && [[ $cur -nt ${images[j]} ]]; do
      images[j + 1]=${images[j]}
      j=$((j - 1))
    done
    images[j + 1]=$cur
  done
  for old in "${images[@]:keep}"; do
    if [[ $(basename "$old") != "$current" ]]; then
      rm -f "$old"
      echo "build-local: 清理 $(basename "$old")"
    fi
  done
fi

echo "build-local: $(jq -r '.version_code' <<<"$result") $dir/$target_name"
