# 桌面会话基础：xdg.portal、greetd 登录、默认 shell、thunar/gvfs、sudo 保留 terminfo
# NixOS 桌面机（gui / tui 之上的图形层）→ nixos.gui
{ config, ... }:
{
  flake.modules.nixos.gui.imports = [ config.flake.modules.nixos.desktop ];

  flake.modules.nixos.desktop =
    {
      lib,
      pkgs,
      myvars,
      ...
    }:
    {
      xdg.portal = {
        enable = true;

        config = {
          common = {
            # Use xdg-desktop-portal-gtk for every portal interface...
            default = [ "gtk" ];
            # except for the secret portal, which is handled by gnome-keyring
            "org.freedesktop.impl.portal.Secret" = [ "gnome-keyring" ];
          };
        };

        # Sets environment variable NIXOS_XDG_OPEN_USE_PORTAL to 1
        # This will make xdg-open use the portal to open programs,
        # which resolves bugs involving programs opening inside FHS envs or with unexpected env vars set from wrappers.
        # xdg-open is used by almost all programs to open a unknown file/uri
        xdgOpenUsePortal = true;

        # ls /run/current-system/sw/share/xdg-desktop-portal/portals/
        # mkOrder：保持迁移前 gtk portal 排在 niri 模块追加的 gnome portal 之前
        extraPortals = lib.mkOrder 500 (
          with pkgs;
          [
            xdg-desktop-portal-gtk # for provides file picker / OpenURI
          ]
        );
      };

      services = {
        xserver.enable = false; # disable xorg server
        # https://wiki.archlinux.org/title/Greetd
        greetd = {
          enable = true;
          settings.default_session = {
            # Wayland Desktop Manager is installed only for the user via home-manager!
            user = myvars.username;
            # .wayland-session is a script generated by home-manager, which links to the current wayland compositor.
            # with such a vendor-no-locking script, we can switch to another wayland compositor without modifying greetd's config here.
            command = "$HOME/.wayland-session"; # start a wayland session directly without a login manager
          };
        };
      };

      boot.loader.timeout = lib.mkForce 10; # wait for x seconds to select the boot entry

      # add user's shell into /etc/shells
      environment.shells = with pkgs; [
        bashInteractive
        nushell
      ];
      # set user's default shell system-wide
      users.defaultUserShell = pkgs.bashInteractive;

      # mkOrder：与迁移前一致——桌面包晚于基础工具与 qemu/fhs
      environment.systemPackages = lib.mkOrder 640 (
        with pkgs;
        [
          gnumake
          wl-clipboard
        ]
      );

      services.gvfs.enable = true; # Mount, trash, and other functionalities
      services.tumbler.enable = true; # Thumbnail support for images

      # dconf is a low-level configuration system.
      programs.dconf.enable = true;

      # thunar file manager(part of xfce) related options
      programs.thunar = {
        enable = true;
        plugins = with pkgs.xfce; [
          thunar-archive-plugin
          thunar-volman
        ];
      };

      # fix for `sudo xxx` in kitty/wezterm/foot and other modern terminal emulators
      security.sudo.keepTerminfo = true;
    };
}
