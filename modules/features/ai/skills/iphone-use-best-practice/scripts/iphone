#!/usr/bin/env python3
"""iphone: 通过 WebDriverAgent (WDA) 读取并操作 USB 连接的真实 iPhone。

只依赖标准库。HTTP 直接走 usbmuxd，不需要端口转发进程。
iphone up 按本机条件自动选路，把官方 Runner 装上手机并启动；用户不选路径（设计见 ../README.md）:
  已就绪 / 已装 Runner 直接起 / Xcode / plumesign / SideStore（未验证）
iphone 只下载固定版本并校验过的官方 Runner，不下载也不安装 go-ios、rcodesign、plumesign。
子命令: iphone --help
"""
import argparse
import hashlib
import http.client
import json
import os
import plistlib
