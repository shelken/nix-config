# ---------- 外部工具与错误翻译 ----------

TOOL_HELP = {
    "ios": "缺 go-ios（命令 ios）。用 nix 装，iphone 不会自己装",
    "rcodesign": "缺 rcodesign。用 nix 装，iphone 不会自己装",
    "plumesign": f"缺 plumesign。用 mise 装 {PLUMESIGN_MISE} {PLUMESIGN_VERSION}，iphone 不会自己装",
}
LOGIN_HELP = ("plumesign 没登录。你本人在终端运行 plumesign account login -u <邮箱>（密码与验证码自己输入）；"
              "登录后运行 chmod -R go-rwx ~/.config/PlumeImpactor，让令牌只有你能读")
REVOKED_HELP = ("同账号上其他侧载工具的证书已被吊销，这是证书上限导致的（免费账号最多 2 个开发证书）。"
                "plumesign 路径要用不与其他侧载工具共享的 Apple ID。不要反复重试")
TOOL_ERRORS = [
    (r"Revoked certificate", REVOKED_HELP),
    (r"(?i)anisette.*(fail|error|unreach|time.?out|refused|unavailable|connect)"
     r"|(fail|error|unreach|time.?out|refused|unavailable|connect).*anisette",
     "anisette 服务器不可用（plumesign 经第三方服务器登录）。检查网络，稍后重试"),
    (r"(?i)device is locked|PasswordProtected", "手机锁屏，请用户本人解锁后重试"),
]


def need_tool(name):
    if not shutil.which(name):
        raise Fail(TOOL_HELP[name])


def tool_hint(out):
    return next((msg for pattern, msg in TOOL_ERRORS if re.search(pattern, out)), "")


def run_tool(cmd, check=True):
    """完整输出落 cli/tools.log，屏幕上只给翻译后的短提示。"""
    if cmd[0] in TOOL_HELP:
        need_tool(cmd[0])
    CLI.mkdir(parents=True, exist_ok=True)
    try:
        r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace", timeout=900)
    except FileNotFoundError:
        raise Fail(f"找不到命令 {cmd[0]}")
    except subprocess.TimeoutExpired:
        raise Fail(f"{cmd[0]} 超过 15 分钟没结束，已放弃")
    out = r.stdout + r.stderr
    with open(TOOLLOG, "a") as f:
        f.write(f"$ {' '.join(cmd)}\n{out}\n")
    if r.returncode == 0 and "Revoked certificate" in out:
        print("注意: " + REVOKED_HELP, file=sys.stderr)  # plumesign 超限时直接吊销现有证书，成功了也要说
    if r.returncode and check:
        last = " | ".join([l.strip() for l in out.splitlines() if l.strip()][-3:])
        raise Fail(f"{cmd[0]} 失败: {tool_hint(out) or last}\n完整输出: {TOOLLOG}")
    return out


def ios_values(text):
    """go-ios 的 stdout 混有 JSON 日志行和 WARN。只取能解析的 JSON 行（以 [ { \" 开头），丢掉带 level 与 msg 的日志行。"""
    vals = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line[0] not in '[{"':
            continue
        try:
            v = json.loads(line)
        except ValueError:
            continue
        if isinstance(v, dict) and "level" in v and "msg" in v:
            continue
        vals.append(v)
    return vals


def image_mounted(text):
    """ios image list 把结果写成日志：没挂载时 msg 是 none，挂载了则每个镜像一行 signature。"""
    for line in text.splitlines():
        msg = line.strip()
        try:
            v = json.loads(msg)
            if isinstance(v, dict) and "msg" in v:
                msg = str(v["msg"])
        except ValueError:
            pass
        if "signature" in msg.lower() or re.fullmatch(r"[0-9a-f]{16,}", msg):
            return True
    return False


def vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v))


def need_usb(cfg):
    dev = usb_device(cfg["udid"])
    if not dev:
        raise Fail("iPhone 没有通过 USB 连接。接上数据线并解锁。")
    return dev


def require_team(cfg):
    if not cfg.get("team_id"):
        raise Fail("Xcode 路径需要 Team ID：iphone init --team <TeamID>")


# ---------- 官方 Runner：下载、校验、解包 ----------

def download_file(url, dest):
    req = urllib.request.Request(url, headers={"User-Agent": "iphone-cli"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r, open(dest, "wb") as f:
            shutil.copyfileobj(r, f)
    except OSError as e:
        dest.unlink(missing_ok=True)
        raise Fail(f"下载 Runner 失败: {e}。检查网络后重试")


def unpack_runner(zpath, sha256, dest):
    """sha256 通过才打开 zip；拒绝越界路径与符号链接（zip-slip）。解到 .part 再改名，失败不留半成品。"""
    h = hashlib.sha256()
    with open(zpath, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    if h.hexdigest() != sha256:
        raise Fail(f"Runner 的 sha256 不符，已拒绝解包。\n  期望 {sha256}\n  实际 {h.hexdigest()}")
    part = dest.with_name(dest.name + ".part")
    shutil.rmtree(part, ignore_errors=True)
    part.mkdir(parents=True)
    root = part.resolve()
    try:
        with zipfile.ZipFile(zpath) as z:
            for info in z.infolist():
                target = (part / info.filename).resolve()
                if target != root and root not in target.parents:
                    raise Fail(f"zip 里有越界路径 {info.filename!r}，已拒绝")
                mode = info.external_attr >> 16
                if stat.S_ISLNK(mode):
                    raise Fail(f"zip 里有符号链接 {info.filename!r}，已拒绝")
                if info.is_dir():
                    target.mkdir(parents=True, exist_ok=True)
                    continue
                target.parent.mkdir(parents=True, exist_ok=True)
                with z.open(info) as src, open(target, "wb") as out:
                    shutil.copyfileobj(src, out)
                if mode:
                    os.chmod(target, mode & 0o777)
        if not (part / RUNNER_APP).is_dir():
            raise Fail(f"zip 里没有 {RUNNER_APP}")
    except BaseException:
        shutil.rmtree(part, ignore_errors=True)
        raise
    shutil.rmtree(dest, ignore_errors=True)
    part.rename(dest)


def fetch_runner():
    app = OFFICIAL / RUNNER_APP
    if app.is_dir():
        return app
    ARTIFACTS.mkdir(parents=True, exist_ok=True)
    zpath = ARTIFACTS / f"wda-{WDA_RELEASE_TAG}.zip"
    print(f"下载官方 Runner {WDA_RELEASE_TAG}（一次性）...", flush=True)
    download_file(WDA_RUNNER_URL, zpath)
    try:
        unpack_runner(zpath, WDA_RUNNER_SHA256, OFFICIAL)
    finally:
        zpath.unlink(missing_ok=True)
    return app


def runner_min_os(app):
    """设备系统下限：Runner 与 .xctest 两个 Info.plist 的 MinimumOSVersion 取最大值。"""
    plists = [app / "Info.plist", *sorted(app.glob("PlugIns/*.xctest/Info.plist"))]
    if len(plists) < 2:
        raise Fail("Runner 包里没有 PlugIns 下的 .xctest")
    found = []
    for f in plists:
        try:
            found.append(str(plistlib.loads(f.read_bytes())["MinimumOSVersion"]))
        except (OSError, KeyError, ValueError):
            raise Fail(f"读不到 {f.relative_to(app)} 的 MinimumOSVersion")
    return max(found, key=vtuple)


def build_ipa(app, ipa):
    ipa.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(ipa, "w", zipfile.ZIP_DEFLATED) as z:
        for p in sorted(app.rglob("*")):
            if p.is_file():
                z.write(p, f"Payload/{app.name}/{p.relative_to(app).as_posix()}")


# ---------- 路径探测（顺序与理由见 ../README.md） ----------

ROUTE_NAMES = {"ready": "已就绪", "installed": "已装 Runner", "xcode": "Xcode", "plumesign": "plumesign",
               "sidestore": "SideStore（未验证）"}


def devicectl_serves(doc, udid):
    """Xcode 可服务该设备：devicectl 列出的物理设备里有这个 UDID。不比较版本号。"""
    devs = (doc.get("result") or {}).get("devices") or []
    return any((d.get("hardwareProperties") or {}).get("reality") == "physical"
               and (d.get("hardwareProperties") or {}).get("udid") == udid for d in devs)


def account_listed(text):
    return "Saved accounts:" in text and "No accounts found" not in text


def sidestore_id(apps):
    return next((a["CFBundleIdentifier"] for a in apps if str(a.get("CFBundleIdentifier", "")).startswith(SIDESTORE_ID)), None)


class Probes:
    """路径表用到的探测。每个方法对应一个条件；selftest 用假数据的对象替换它。"""

    def __init__(self, timeout=120, fetch=True):
        self.timeout, self.fetch, self._apps, self._ver = timeout, fetch, None, None

    def ready(self):
        return ready()

    def apps(self, cfg):
        if self._apps is None:
            self._apps = []
            if shutil.which("ios"):
                try:
                    for v in ios_values(run_tool(["ios", "apps", "--all", f"--udid={cfg['udid']}"])):
                        if isinstance(v, list):
                            self._apps = [x for x in v if isinstance(x, dict)]
                except Fail:
                    pass
        return self._apps

    def runner_installed(self, cfg):
        return find_runner(self.apps(cfg), cfg)

    def start(self, cfg, rid):
        d = days_left(signed_app()) if rid == runner_id(cfg) else None
        if d is not None and d <= 0:
            print("已装的 Runner 证书已过期，需要重新签名", flush=True)
            return False
        try:
            launch_runwda(cfg, self.timeout, rid)
        except Fail as e:
            print(f"已装的 Runner 没起来: {e}", flush=True)
            return False
        return True

    def device_version(self, cfg):
        """没有 go-ios 或读不到时返回 None，跳过系统检查（Xcode 路径不依赖 go-ios）。"""
        if self._ver is not None:
            return self._ver or None
        v = None
        if shutil.which("ios"):
            try:
                out = run_tool(["ios", "lockdown", "get", "ProductVersion", f"--udid={cfg['udid']}"])
            except Fail:
                out = ""
            v = next((v for v in ios_values(out) if isinstance(v, str) and re.fullmatch(r"\d+(\.\d+)*", v)), None)
            if v is None:
                print("没读到手机系统版本，跳过系统检查", file=sys.stderr)
        self._ver = v or ""
        return v

    def min_os(self):
        if not self.fetch and not (OFFICIAL / RUNNER_APP).is_dir():
            return None  # status 不下载；还没解包就不知道下限
        return runner_min_os(fetch_runner())

    def xcode_serves(self, cfg):
        with tempfile.TemporaryDirectory() as d:
            out = Path(d) / "devices.json"
            try:
                r = subprocess.run(["xcrun", "devicectl", "list", "devices", "--json-output", str(out)],
                                   capture_output=True, timeout=60)
                return r.returncode == 0 and devicectl_serves(json.loads(out.read_text()), cfg["udid"])
            except (OSError, subprocess.TimeoutExpired, ValueError):
                return False  # 没有完整 Xcode 时命令失败，按「否」

    def plumesign_state(self):
        """空串表示 plumesign 路径可用；否则是不可用的原因（含怎么补）。"""
        missing = [TOOL_HELP[t] for t in ("plumesign", "rcodesign") if not shutil.which(t)]
        if missing:
            return "；".join(missing)
        try:
            r = subprocess.run(["plumesign", "account", "list"], stdin=subprocess.DEVNULL, capture_output=True,
                               text=True, errors="replace", timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            return LOGIN_HELP
        return "" if account_listed(r.stdout + r.stderr) else LOGIN_HELP

    def sidestore(self, cfg):
        return sidestore_id(self.apps(cfg)) is not None


def no_route_text(plume_why):
    return ("没有可用的安装路径。任选其一:\n"
            "  Xcode: 本机装完整 Xcode，且它认得这台手机（系统太旧的手机通常不行）\n"
            f"  plumesign: {plume_why}\n"
            "  SideStore: 在手机上装 SideStore（未验证）")


def install_route(cfg, p):
    """已就绪、已装 Runner 之后的探测：该用哪条路把 Runner 装上手机。renew 与 status 也用它。"""
    have, floor = p.device_version(cfg), p.min_os()
    if have and floor and vtuple(have) < vtuple(floor):
        raise Fail(f"手机系统 {have} 低于下限 {floor}，官方 Runner 装不上。先升级手机系统")
    if p.xcode_serves(cfg):
        return "xcode"
    if have and vtuple(have) >= (GOIOS_TUNNEL_MIN_OS,):
        raise Fail(f"iOS {GOIOS_TUNNEL_MIN_OS} 及以上需要 Xcode 路径（go-ios 需要 tunnel，未验证）。\n"
                   "Xcode 要满足: 本机装完整 Xcode；xcrun devicectl list devices 里能看到这台手机；已 iphone init --team <TeamID>")
    why = p.plumesign_state()
    if not why:
        return "plumesign"
    if p.sidestore(cfg):
        return "sidestore"
    raise Fail(no_route_text(why))


def choose_route(cfg, p):
    """路径表自上而下探测，开头打印一行「路径: 名称」。已装 Runner 这一档会真的去启动。"""
    if p.ready():
        print(f"路径: {ROUTE_NAMES['ready']}")
        return "ready"
    have = p.device_version(cfg)
    rid = None if have and vtuple(have) >= (GOIOS_TUNNEL_MIN_OS,) else p.runner_installed(cfg)
    if rid:
        print(f"路径: {ROUTE_NAMES['installed']}", flush=True)
        if p.start(cfg, rid):
            return "installed"
        print("继续往下探测", flush=True)
    route = install_route(cfg, p)
    print(f"路径: {ROUTE_NAMES[route]}", flush=True)
    return route


# ---------- 启动与签名 ----------

def wait_ready(proc, what, timeout, hints, stall=None):
    """轮询 ready()；日志里命中 hints 就提示或中止；进程提前退出或超时则报错。"""
    told, start = set(), time.time()
    while time.time() - start < timeout:
        if ready():
            return
        text = UPLOG.read_text(errors="replace")
        for pattern, msg, fatal in hints:
            if re.search(pattern, text):
                if fatal:
                    stop_wda()
                    raise Fail(msg)
                if msg not in told:
                    print(msg, flush=True)
                    told.add(msg)
        if proc.poll() is not None:
            raise Fail(f"{what} 已退出，见 {UPLOG}")
        if stall and stall not in told and time.time() - start > 20:
            print(stall, flush=True)
            told.add(stall)
        time.sleep(2)
    stop_wda()
    raise Fail(f"{timeout}s 内 WDA 没就绪，见 {UPLOG}")


def launch_runwda(cfg, timeout, rid):
    """ios runwda 是前台常驻进程：独立会话启动、写 pidfile、轮询就绪。DDI 在这里准备，已装直启与 plumesign 路径共用。"""
    need_tool("ios")
    ensure_ddi(cfg)
    CLI.mkdir(parents=True, exist_ok=True)
    with open(UPLOG, "w") as log:
        proc = subprocess.Popen(runwda_cmd(cfg, rid), stdout=log, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, start_new_session=True)
    PIDFILE.write_text(str(proc.pid))
    wait_ready(proc, "ios runwda", timeout, RUNWDA_HINTS, RUNWDA_STALL)


def ensure_ddi(cfg):
    out = run_tool(["ios", "image", "list", f"--udid={cfg['udid']}"], check=False)
    if image_mounted(out):
        return
    print("挂载开发者磁盘镜像（go-ios 会下载，首次较慢）...", flush=True)
    IMAGES.mkdir(parents=True, exist_ok=True)
    run_tool(["ios", "image", "auto", f"--basedir={IMAGES}", f"--udid={cfg['udid']}"])


def extract_signing_pems(app, tmp, run):
    """不读 accounts.json（含令牌）：证书取自已签名的主程序，私钥按证书 OU（TeamID）定位。"""
    exe = app / plistlib.loads((app / "Info.plist").read_bytes())["CFBundleExecutable"]
    run(["codesign", "-d", f"--extract-certificates={tmp / 'cert'}", str(exe)])
    der = tmp / "cert0"
    if not der.exists():
        raise Fail("没能从主程序取到签名证书，第一遍 plumesign 可能没生效")
    pem = tmp / "cert.pem"
    run(["openssl", "x509", "-inform", "der", "-in", str(der), "-out", str(pem)])
    m = re.search(r"\bOU\s*=\s*([A-Za-z0-9]+)", run(["openssl", "x509", "-in", str(pem), "-noout", "-subject"]))
    if not m:
        raise Fail("签名证书里没有 OU（TeamID），定位不到私钥")
    key = PLUME_KEYS / m.group(1) / "key.pem"
    if not key.exists():
        raise Fail("找不到 plumesign 的私钥 ~/.config/PlumeImpactor/keys/<TeamID>/key.pem")
    return pem, key


def sign_runner(cfg, device_id, run=None):
    """官方 Runner 复制一份到临时位置，签完装上手机，成品留在 artifacts/signed/。
    顺序不能变：plumesign 不签 .xctest，必须先让 plumesign 建好证书并签主 app，
    再用 rcodesign 补签 .xctest，最后第二遍 plumesign 把 .xctest 一并封进主 app 并安装。
    plumesign 的 --udid 比较的是 usbmuxd 的数字 DeviceID，不是 UDID。
    每次调用 plumesign 都可能向 Apple 申请证书（超限会吊销别的证书），所以不循环、不重试。"""
    run = run or run_tool
    rid = runner_id(cfg)
    official = fetch_runner()
    with tempfile.TemporaryDirectory(prefix="iphone-sign-") as tmp:
        tmp = Path(tmp)
        app = tmp / RUNNER_APP
        shutil.copytree(official, app, symlinks=True)
        xctests = sorted(app.glob("PlugIns/*.xctest"))
        if not xctests:
            raise Fail("Runner 包里没有 PlugIns 下的 .xctest")
        print("签名 Runner：第一遍，主 app（不带设备）...", flush=True)
        run(["plumesign", "sign", "--apple-id", "--custom-identifier", rid, "--package", str(app)])
        pem, key = extract_signing_pems(app, tmp, run)
        print("补签 .xctest...", flush=True)
        for x in xctests:
            run(["rcodesign", "sign", "--pem-file", str(pem), "--pem-file", str(key), str(x)])
        print("签名并安装：第二遍...", flush=True)
        run(["plumesign", "sign", "--apple-id", "--register-and-install", "--udid", str(device_id),
             "--custom-identifier", rid, "--package", str(app)])
        shutil.rmtree(SIGNED, ignore_errors=True)
        SIGNED.mkdir(parents=True)
        shutil.copytree(app, signed_app(), symlinks=True)
    return signed_app()


def install_plumesign(cfg, device_id):
    TOOLLOG.unlink(missing_ok=True)
    d = days_left(sign_runner(cfg, device_id))
    print(f"已签名并安装，证书剩余 {d:.1f} 天" if d is not None
          else "已签名并安装（没读到 embedded.mobileprovision，过期时间未知）")


def up_plumesign(cfg, a):
    for t in ("ios", "plumesign", "rcodesign"):
        need_tool(t)
    install_plumesign(cfg, need_usb(cfg)[0])  # 进到这条路径就是要签名并安装；失败直接报错，不重试
    launch_runwda(cfg, a.timeout, runner_id(cfg))


def up_sidestore(cfg, p):
    """未验证：IPA 推到 SideStore 的 Documents，之后由用户在 SideStore 里安装并自行管理。"""
    need_tool("ios")
    sid = sidestore_id(p.apps(cfg))
    ipa = ARTIFACTS / f"WebDriverAgentRunner-{WDA_RELEASE_TAG}.ipa"
    build_ipa(fetch_runner(), ipa)
    run_tool(["ios", "fsync", f"--app={sid}", "push", f"--srcPath={ipa}", f"--dstPath=Documents/{ipa.name}",
              f"--udid={cfg['udid']}"])
    print(f"SideStore 路径（未验证）：已把 {ipa.name} 推到 SideStore 的 Documents。\n"
          "手机上接着做:\n"
          "  1. 打开 SideStore，添加这个 IPA 并安装\n"
          "  2. 之后签名与刷新由 SideStore 管理\n"
          f"装好后运行 iphone status 确认 WDA 是否可用。iphone up 会把 bundle id 以 {OFFICIAL_RUNNER_ID} 开头的 App 当作已装的 Runner 直接启动"
          "（SideStore 是否给 id 加后缀未验证）。\n"
          "风险: 有报告称 SideStore 重签会移除 .xctest，若属实 Runner 起不来。")


# ---------- Xcode 路径 ----------

def ensure_source():
    """WDA 源码只有 Xcode 路径需要，所以延后到这里才拉。"""
    if (SOURCE / "WebDriverAgent.xcodeproj").exists():
        head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=SOURCE, capture_output=True, text=True).stdout.strip()
        if head == WDA_COMMIT:
            return
    if not shutil.which("git"):
        raise Fail("Xcode 路径要用 git 拉 WDA 源码，没找到 git")
    print("拉取 WDA 源码（固定版本）...", flush=True)
    SOURCE.mkdir(parents=True, exist_ok=True)
    if not (SOURCE / ".git").exists():
        subprocess.run(["git", "init", "-q"], cwd=SOURCE, check=True)
        subprocess.run(["git", "remote", "add", "origin", WDA_REPO], cwd=SOURCE, check=True)
    for c in (["git", "fetch", "-q", "--depth", "1", "origin", WDA_COMMIT], ["git", "checkout", "-q", "--detach", "FETCH_HEAD"]):
        subprocess.run(c, cwd=SOURCE, check=True)


def xcode_build(cfg):
    require_team(cfg)
    ensure_source()
    CLI.mkdir(parents=True, exist_ok=True)
    print("构建并签名 WDA（首次约几分钟）...", flush=True)
    with open(CLI / "build.log", "w") as log:
        rc = subprocess.run(xcode_cmd(cfg, "build-for-testing"), stdout=log, stderr=subprocess.STDOUT, cwd=SOURCE).returncode
    text = (CLI / "build.log").read_text()
    if rc:
        errs = [l for l in text.splitlines() if "error:" in l][-5:]
        hint = next((m for p, m, fatal in LOG_HINTS if fatal and re.search(p, text)), "")
        raise Fail("构建失败:\n" + "\n".join(errs) + (f"\n{hint}" if hint else ""))
    d = days_left()
    print(f"构建成功，证书剩余 {d:.1f} 天" if d is not None else "构建成功")


def up_xcode(cfg, a):
    require_team(cfg)
    d = days_left()
    if d is None or d <= 0:
        print("没有可用构建或证书已过期，先构建并签名", flush=True)
        xcode_build(cfg)
    ensure_source()
    CLI.mkdir(parents=True, exist_ok=True)
    with open(UPLOG, "w") as log:
        proc = subprocess.Popen(xcode_cmd(cfg, "test-without-building"), stdout=log, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, cwd=SOURCE, start_new_session=True)
    PIDFILE.write_text(str(proc.pid))
    wait_ready(proc, "xcodebuild", a.timeout, LOG_HINTS)


# ---------- 子命令 ----------

def cmd_init(a):
    """首次配置，也用于换设备：沿用已有配置里的 bundle、team 和其他键。只有 --bundle 必填，--team 只有走 Xcode 路径才要。"""
    HOME.mkdir(parents=True, exist_ok=True)
    old = json.loads(CFG.read_text()) if CFG.exists() else {}
    if pid_alive():
        raise Fail("WDA 还在运行。先 iphone down（会把旧手机的自动锁定恢复为 3 分钟），再换设备")
    bundle = a.bundle or old.get("bundle_id")
    if not bundle:
        raise Fail("首次配置需要 --bundle <全局唯一的 bundle id，如 com.example.wda>")
    team = a.team or old.get("team_id")
    udid = a.udid
    if not udid:
        devs = usb_devices()
        if not devs:
            raise Fail("没有 USB 设备。接上并解锁 iPhone，或用 --udid 指定")
        if len(devs) > 1:
            raise Fail("有多台 USB 设备，用 --udid 指定其一: " + ", ".join(d[1] for d in devs))
        udid = devs[0][1]
    if udid != old.get("udid") or bundle != old.get("bundle_id"):
        # 旧的签名只含旧设备或旧 bundle id；删掉后 up 会自动重新签名
        shutil.rmtree(RUNNER, ignore_errors=True)
        shutil.rmtree(SIGNED, ignore_errors=True)
        (CLI / "session").unlink(missing_ok=True)
    cfg = {"device_port": 8100, **old, "udid": udid, "bundle_id": bundle}
    for k in ("local_port", "source_dir"):
        cfg.pop(k, None)  # 都已不再使用
    if team:
        cfg["team_id"] = team
    CFG.write_text(json.dumps(cfg, indent=2, ensure_ascii=False))
    print(f"已写入 {CFG}（设备 {udid}）\n下一步: iphone up（自动选路）")
    if not team:
        print("只有走 Xcode 路径才需要 Team ID；到时 iphone init --team <TeamID> 补上")
    print(relay_notice())


def cmd_renew(a):
    """对当前路径强制重新签名并安装。"""
    cfg = config()
    dev = need_usb(cfg)
    p = Probes()
    route = install_route(cfg, p)
    print(f"路径: {ROUTE_NAMES[route]}", flush=True)
    if route == "xcode":
        xcode_build(cfg)
    elif route == "plumesign":
        for t in ("ios", "plumesign", "rcodesign"):
            need_tool(t)
        install_plumesign(cfg, dev[0])
    else:
        up_sidestore(cfg, p)


def finish_up(a):
    print("WDA 已就绪")
    if not a.no_keep_awake:
        try:
            set_autolock(AUTOLOCK_NEVER)
        except Fail as e:  # 常亮只是附加功能，不能让 WDA 已就绪的 up 失败
            print(f"警告: 没能把自动锁定改为永不（{e}）。可手动改，或 iphone autolock never", file=sys.stderr)


def cmd_up(a):
    cfg = config()
    need_usb(cfg)
    if a.restart:
        stop_wda()
    p = Probes(a.timeout)
    route = choose_route(cfg, p)
    if route == "ready":
        return
    if route == "sidestore":
        return up_sidestore(cfg, p)
    if route == "xcode":
        up_xcode(cfg, a)
    elif route == "plumesign":
        up_plumesign(cfg, a)
    finish_up(a)  # "installed" 已在探测时由 runwda 启动


def cmd_down(a):
    if not a.no_keep_awake and pid_alive() and ready():
        try:
            set_autolock(AUTOLOCK_DEFAULT)
        except Fail as e:
            print(f"警告: 没能把自动锁定恢复为 3 分钟（{e}）。请手动设置，或 iphone autolock 180", file=sys.stderr)
    stop_wda()


def stop_wda():
    pid = pid_alive()
    if pid:
        try:
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        for _ in range(20):
            if not pid_alive():
                break
            time.sleep(0.5)
        else:
            os.killpg(pid, signal.SIGKILL)
    PIDFILE.unlink(missing_ok=True)
    (CLI / "session").unlink(missing_ok=True)
    if pid is None and ready():
        raise Fail("WDA 在运行，但不是本 CLI 启动的；没有动它")
    print("WDA 已停止")


def runner_kind(rid, cfg):
    """手机上已装 Runner 的来源，由 bundle id 判断：<bundle>.runner 是 plumesign，<bundle>.xctrunner 是 Xcode，
    其余带官方前缀的是 SideStore 重签（后缀未验证）。没有 Runner 返回 None。"""
    if rid == runner_id(cfg):
        return "plumesign"
    if rid == cfg["bundle_id"] + ".xctrunner":
        return "xcode"
    return "sidestore" if rid else None


def cert_line(route):
    if route == "sidestore":
        return "证书: 由 SideStore 管理"
    app, miss = (signed_app(), "无签名副本，iphone up 会自动签名并安装") if route == "plumesign" \
        else (RUNNER, "无构建，iphone up 会自动构建并签名")
    d = days_left(app)
    if d is None:
        return "证书: " + miss
    return f"证书: 剩余 {d:.1f} 天（免费账号 7 天，过期后 iphone up 会自动重签）" if d > 0 else "证书: 已过期，iphone up 会自动重签"


def cmd_status(a):
    cfg = config()
    dev = usb_device(cfg["udid"])
    print(f"设备: {'USB 已连接' if dev else '未通过 USB 连接'} ({cfg['udid']})")
    ok = bool(dev) and ready()
    print(f"WDA: {'就绪' if ok else '未运行'}" + (f" (pid {pid_alive()})" if pid_alive() else ""))
    if ok:
        print(f"锁屏: {'是' if wda('GET', '/wda/locked') else '否'}")
        print(f"前台: {(wda('GET', '/wda/activeAppInfo') or {}).get('bundleId')}")
    if not dev:
        print("路径: 接上 USB 才能探测")
        return 1
    p = Probes(fetch=False)
    rid = p.runner_installed(cfg)
    kind = runner_kind(rid, cfg)
    if kind:
        print(f"Runner: 已装，{ROUTE_NAMES[kind]} 签名（{rid}）")
        print(cert_line(kind))
        return 0 if ok else 1
    try:
        route = install_route(cfg, p)
    except Fail:
        print("Runner: 未装；没有可用的安装路径（iphone up 会报错并列出方案）")
    else:
        print(f"Runner: 未装；iphone up 会走: {ROUTE_NAMES[route]}")
    return 0 if ok else 1


def cmd_snapshot(a):
    require_unlocked()
    s = snapshot_now()
    shown = s["nodes"][:a.max]
    print(f'app={s["app"]} viewport={s["viewport"]["width"]}x{s["viewport"]["height"]} shown={len(shown)} total={len(s["nodes"])}')
    print("\n".join(fmt(n, None if a.full else 60) for n in shown))
    if len(s["nodes"]) > a.max:
        print(f"... 还有 {len(s['nodes']) - a.max} 个，用 iphone find <文字> 定位")


def matching(nodes, q):
    return [n for n in nodes if q in " ".join((n.get("label", ""), n.get("name", ""), n.get("value", ""))).lower()]


def cmd_find(a):
    require_unlocked()
    s = snapshot_now()
    q = " ".join(a.text).lower()
    hits = matching(s["nodes"], q)
    print(f'app={s["app"]} matches={len(hits)}')
    print("\n".join(fmt(n, None if a.full else 60) for n in hits[:a.max]))
    return 0 if hits else 1


def cmd_wait(a):
    q = " ".join(a.text).lower()
    end = time.time() + a.timeout
    while time.time() < end:
        s = snapshot_now()
        hits = matching(s["nodes"], q)
        if hits:
            print("\n".join(fmt(n) for n in hits[:5]))
            return 0
        time.sleep(1)
    print(f"{a.timeout}s 内没出现: {q}")
    return 1


def cmd_shot(a):
    require_unlocked()
    png = __import__("base64").b64decode(wda("GET", "/screenshot", timeout=60))
    SHOTS.mkdir(parents=True, exist_ok=True)
    for old in sorted(SHOTS.glob("*"))[:-20]:
        old.unlink()
    base = SHOTS / time.strftime("%Y%m%d-%H%M%S")
    src = base.with_suffix(".png")
    src.write_bytes(png)
    out = base.with_suffix(".jpg")
    subprocess.run(["sips", "-Z", str(a.size), "-s", "format", "jpeg", str(src), "--out", str(out)], capture_output=True, check=True)
    src.unlink()
    w, h = struct.unpack(">II", png[16:24])
    vp = load_last()["viewport"] if LAST.exists() else {"width": 402}
    print(f"{out} native={w}x{h} points_per_native_pixel={vp['width'] / w:.4f}")


def cmd_tap(a):
    if len(a.target) == 1:
        x, y, node = resolve_point(a.target[0])
        if node.get("disabled"):
            print(f"注意: {a.target[0]} 是 disabled")
    elif len(a.target) == 2:
        x, y = float(a.target[0]), float(a.target[1])
        vp = load_last()["viewport"] if LAST.exists() else {"width": 402, "height": 874}
        if not (0 <= x < vp["width"] and 0 <= y < vp["height"]):
            raise Fail(f"坐标 ({x:g},{y:g}) 在视口 {vp['width']}x{vp['height']} 之外。单位是点，不是截图像素")
    else:
        raise Fail("用法: iphone tap tN | iphone tap X Y（单位是点，不是截图像素）")
    act(a, lambda: sess("POST", "/wda/tap", {"x": x, "y": y}))


def _pick_by_text(q, index):
    s = snapshot_now()
    vp = s["viewport"]
    pool, seen = [], set()
    for n in matching(s["nodes"], q):
        x, y, w, h = n["rect"]
        if 0 <= x + w / 2 < vp["width"] and 0 <= y + h / 2 < vp["height"] and tuple(n["rect"]) not in seen:
            seen.add(tuple(n["rect"]))
            pool.append(n)
    pool = [n for n in pool if text_of(n).lower() == q] or pool
    if not pool:
        raise Fail(f"屏幕内没有包含「{q}」的元素；先 iphone find {q} 或 iphone shot 看看")
    if index is None and len(pool) > 1:
        raise Fail(f"{len(pool)} 个元素命中，用 --index N 选一个（从 0 起）:\n" + "\n".join(f"  [{i}] {fmt(n)}" for i, n in enumerate(pool)))
    if not 0 <= (index or 0) < len(pool):
        raise Fail(f"--index 超出范围，共 {len(pool)} 个命中")
    return pool[index or 0]


def cmd_tap_text(a):
    """现取快照，点屏幕内文字命中的元素：一次调用代替 find + 取 token + tap，token 不会过期。
    精确等于优先于包含；同一位置的重复节点算一个；仍有多个就列出来，不猜。
    坐标连续两次一致才点：刚启动或翻页后列表还在滚动，现取的坐标点下去会落在别处。"""
    require_unlocked()
    q = " ".join(a.text).lower()
    n = _pick_by_text(q, a.index)
    for _ in range(8):
        time.sleep(0.3)
        again = _pick_by_text(q, a.index)
        if again["rect"] == n["rect"]:
            break
        n = again
    else:
        raise Fail(f"「{q}」的位置一直在变（页面还在滚动或动画），稍后再试")
    x, y, w, h = n["rect"]
    act(a, lambda: sess("POST", "/wda/tap", {"x": x + w / 2, "y": y + h / 2}))


def cmd_type(a):
    if a.clear and not a.target:
        raise Fail("--clear 需要 --target tN，才知道清哪个输入框")
    if not a.clear and not a.text:
        raise Fail("没有要输入的文字；只清空请加 --clear")

    def do():
        if a.target:
            x, y, node = resolve_point(a.target)
            if a.clear:
                # 点输入框右端把光标落在文字末尾，再按当前内容长度逐个删除；过长而滚出框外的文字清不干净
                sess("POST", "/wda/tap", {"x": node["rect"][0] + node["rect"][2] - 3, "y": y})
            else:
                sess("POST", "/wda/tap", {"x": x, "y": y})
            time.sleep(0.4)
            if a.clear:
                sess("POST", "/wda/keys", {"value": ["\u0008" * (len(node.get("value", "") or text_of(node)) + 5)]}, timeout=30)
        for i in range(0, len(a.text), 200):
            sess("POST", "/wda/keys", {"value": [a.text[i:i + 200]], "frequency": 30}, timeout=60)
    act(a, do)


def cmd_key(a):
    keys = {"return": "\n", "delete": "\u0008"}
    if a.name == "home":
        return act(a, lambda: wda("POST", "/wda/homescreen", {}))
    act(a, lambda: sess("POST", "/wda/keys", {"value": [keys[a.name]]}))


def cmd_home(a):
    act(a, lambda: wda("POST", "/wda/homescreen", {}))


def cmd_scroll(a):
    vp = load_last()["viewport"] if LAST.exists() else {"width": 402, "height": 874}
    if a.target:
        cx, cy, node = resolve_point(a.target)
        w, h = node["rect"][2], node["rect"][3]
    else:
        cx, cy, w, h = vp["width"] / 2, vp["height"] / 2, vp["width"], vp["height"]
    dx, dy = {"down": (0, -1), "up": (0, 1), "right": (-1, 0), "left": (1, 0)}[a.direction]  # 手指方向与内容相反
    x1, y1 = cx - dx * w * 0.3, cy - dy * h * 0.3
    x2, y2 = cx + dx * w * 0.3, cy + dy * h * 0.3
    act(a, lambda: sess("POST", "/wda/dragfromtoforduration", {"fromX": x1, "fromY": y1, "toX": x2, "toY": y2, "duration": 0.2}))


def cmd_drag(a):
    act(a, lambda: sess("POST", "/wda/dragfromtoforduration", {"fromX": a.x1, "fromY": a.y1, "toX": a.x2, "toY": a.y2, "duration": a.duration}))


def cmd_launch(a):
    if not re.fullmatch(r"[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+", a.bundle):
        raise Fail("需要 bundle id（如 com.apple.mobilesafari）。不知道时: iphone home → iphone find 名称 → iphone tap tN")
    act(a, lambda: sess("POST", "/wda/apps/activate", {"bundleId": a.bundle}, timeout=45))


def cmd_stop(a):
    act(a, lambda: sess("POST", "/wda/apps/terminate", {"bundleId": a.bundle}))


SETTINGS = "com.apple.Preferences"
AUTOLOCK_NEVER, AUTOLOCK_DEFAULT = -1, 180  # Settings 里选项 cell 的 name 就是秒数，永不是 -1
AUTOLOCK_CHOICES = {"never": -1, "30": 30, "60": 60, "120": 120, "180": 180, "240": 240, "300": 300}


def _tap_node(n):
    x, y, w, h = n["rect"]
    sess("POST", "/wda/tap", {"x": x + w / 2, "y": y + h / 2})


def _poll_node(kind, name, wait):
    """等 (type, name) 出现，并且坐标连续两次一致才返回：设置 App 重开时会恢复上次的滚动位置，
    列表还在动时拿到的坐标点下去会落在别处。页面刚切换时 /source 可能 404，也在这里吞掉。"""
    end, s, n, last = time.time() + wait, None, None, None
    while True:
        try:
            s = snapshot_now()
            n = next((n for n in s["nodes"] if n["type"] == kind and n.get("name") == name), None)
        except Fail:
            n = None
        if n:
            if last == n["rect"] or time.time() >= end + 3:
                return s, n
            last = n["rect"]
            time.sleep(0.3)
            continue
        last = None
        if time.time() >= end:
            return s, None
        time.sleep(0.4)


def _drag_list(vp, step):
    a, b = (0.7, 0.3) if step > 0 else (0.3, 0.7)
    sess("POST", "/wda/dragfromtoforduration", {"fromX": vp["width"] / 2, "fromY": vp["height"] * a,
                                                "toX": vp["width"] / 2, "toY": vp["height"] * b, "duration": 0.2})
    time.sleep(0.4)


def _find_scrolling(kind, name, scrolls):
    """按 (type, name) 找节点；找不到就滚动，滚到头再掉头。name 是不随语言变化的标识。
    首次多等一会儿，页面刚切换时节点还没出现，先滚会把还没换掉的上一页滚走（慢设备上必现）。
    节点必须完整落在视口 8%~90% 内才返回：贴着底边的行点击中心会落进底部手势区，点击被系统吞掉（iPhone 14 上必现）。
    scrolls=0 表示不滚动，直接返回。"""
    step, flipped, prev, edge = 1, False, None, None
    for i in range(scrolls * 2 + 1):
        s, n = _poll_node(kind, name, 4 if i == 0 else 0.6)
        if n:
            vp, (_, y, _, h) = s["viewport"], n["rect"]
            if not scrolls or n["rect"] == edge or (vp["height"] * 0.08 <= y and y + h <= vp["height"] * 0.9):
                return s, n  # edge：滚过一次位置没变，列表到头，只能就这样点
            edge = n["rect"]
            _drag_list(vp, 1 if y + h > vp["height"] * 0.9 else -1)
            continue
        if not s:
            continue
        if i == scrolls * 2:
            break
        here = [(x["type"], text_of(x), tuple(x["rect"])) for x in s["nodes"]]
        if here == prev:  # 滚不动了，到头
            if flipped:
                break
            step, flipped, prev = -step, True, None
        else:
            prev = here
        _drag_list(s["viewport"], step)
    raise Fail(f"设置里没找到 {kind} {name}（iOS 版本或语言变了？）")


def _wait_node(kind, name, timeout):
    """页面切换瞬间 /source 可能报 404（旧 App 已不在），重试到超时。"""
    end, last = time.time() + timeout, None
    while time.time() < end:
        try:
            n = next((n for n in snapshot_now()["nodes"] if n["type"] == kind and n.get("name") == name), None)
        except Fail as e:
            last, n = e, None
        if n:
            return n
        time.sleep(0.5)
    raise Fail(f"{timeout}s 内没出现 {kind} {name}" + (f"（最后错误: {last}）" if last else ""))


AUTOLOCK_URL = "prefs:root=DISPLAY&path=AUTOLOCK"


def relay_name():
    return config().get("open_url_shortcut", RELAY_NAME)  # 假定每台手机首次配置时已装好，不逐次验证


def relay_notice():
    return ("中转快捷指令让自动锁定与 prefs: 稳定直达，没有它只能界面点击，慢且不稳。每台手机装一次，二选一，装完跑 iphone setup-shortcut 验证：\n"
            "  与 Mac 同一 iCloud:   iphone setup-shortcut（Mac 导入，经 iCloud 同步到手机）\n"
            "  与 Mac 不同 iCloud:   iphone shortcut-link 取 iCloud 链接，在手机 Safari 里打开并点「添加快捷指令」，再 iphone setup-shortcut")


def cmd_shortcut_link(a):
    print(RELAY_URL)


def _settings_ids(nodes):
    """设置页有没有 com.apple.settings.* 标识：True 有；False 页面已加载却没有（iOS 15.6.1 实测，行的 name 只是本地化文字）；
    None 页面还没加载好。按标识找行在 False 时必然落空，不必再滚动搜索。"""
    if any((n.get("name") or "").startswith("com.apple.settings.") for n in nodes):
        return True
    return False if sum(n["type"] == "Cell" for n in nodes) >= 3 else None


def _autolock_via_ui():
    sess("POST", "/wda/apps/activate", {"bundleId": SETTINGS}, timeout=45)
    time.sleep(0.8)
    end = time.time() + 8
    while time.time() < end:
        try:
            state = _settings_ids(snapshot_now()["nodes"])
        except Fail:
            state = None
        if state is False:
            raise Fail("这台手机的设置页没有稳定标识（iOS 15 实测），界面点击回退用不了；装中转快捷指令后可直达：iphone shortcut-link")
        if state:
            break
        time.sleep(0.5)
    for kind, name, scrolls in (("Button", "com.apple.settings.displayAndBrightness", 8), ("Cell", "AUTOLOCK", 3)):
        _tap_node(_find_scrolling(kind, name, scrolls)[1])
        time.sleep(0.7)


def set_autolock(seconds):
    """WDA 直接开 prefs: 会被拒（iOS 27，错误 115），所以假定手机已装中转快捷指令（iphone setup-shortcut），
    经它一步直达自动锁定页；没跑通才回退 UI：设置 → 显示与亮度 → 自动锁定。"""
    require_unlocked()
    sess("POST", "/wda/apps/terminate", {"bundleId": SETTINGS})
    wda("POST", "/wda/homescreen", {})
    time.sleep(0.8)
    try:
        try:
            open_url(AUTOLOCK_URL, direct=False)
            _wait_node("Cell", str(seconds), 10)
        except Fail:
            print("中转快捷指令没跑通，改走界面点击（每台手机要先装一次，见 iphone shortcut-link）", file=sys.stderr)
            _autolock_via_ui()
        s, row = _find_scrolling("Cell", str(seconds), 0)
        _tap_node(row)
        time.sleep(0.7)
        s = snapshot_now()
        row = next((n for n in s["nodes"] if n["type"] == "Cell" and n.get("name") == str(seconds)), None)
        check = next((n for n in s["nodes"] if n["type"] == "Button" and n.get("label") == "checkmark"), None)
        if not (row and check and row["rect"][1] <= check["rect"][1] < row["rect"][1] + row["rect"][3]):
            raise Fail("点了选项，但没有在该行看到对勾；用 iphone shot 确认")
        print(f"自动锁定已设为 {text_of(row)}")
    finally:
        try:
            sess("POST", "/wda/apps/terminate", {"bundleId": SETTINGS})
            wda("POST", "/wda/homescreen", {})
        except Fail:
            pass


def cmd_autolock(a):
    set_autolock(AUTOLOCK_CHOICES[a.value])


def open_url(url, direct=True, relay=None):
    """直接让 WDA 打开；prefs: 之类被系统拒绝（115）时，经接收输入的快捷指令（open_url_shortcut）转一手。"""
    from urllib.parse import quote
    if direct:
        try:
            sess("POST", "/url", {"url": url}, timeout=30)
            return
        except Fail as e:
            if "115" not in str(e):
                raise
    name = relay or relay_name()
    sess("POST", "/url", {"url": f"shortcuts://run-shortcut?name={quote(name)}&input=text&text={quote(url)}"}, timeout=30)


def cmd_open(a):
    act(a, lambda: open_url(a.url))


RELAY_NAME = "iphone-open-url"
RELAY_URL = "https://www.icloud.com/shortcuts/425895ce7d254e9cba00198ce8e7aa42"  # 同一个只含「打开 URL」的快捷指令，供不同 iCloud 的手机直接添加


def relay_shortcut_bytes():
    """只含「打开 URL」、输入取快捷指令输入的工作流。"""
    token = {"Value": {"string": "\ufffc", "attachmentsByRange": {"{0, 1}": {"Type": "ExtensionInput"}}},
             "WFSerializationType": "WFTextTokenString"}
    return plistlib.dumps({
        "WFWorkflowClientVersion": "2900", "WFWorkflowMinimumClientVersion": 900, "WFWorkflowMinimumClientRelease": 900,
        "WFWorkflowIcon": {"WFWorkflowIconStartColor": 431817727, "WFWorkflowIconGlyphNumber": 59511},
        "WFWorkflowImportQuestions": [], "WFWorkflowTypes": [],
        "WFWorkflowInputContentItemClasses": ["WFStringContentItem", "WFURLContentItem"],
        "WFWorkflowActions": [{"WFWorkflowActionIdentifier": "is.workflow.actions.openurl",
                               "WFWorkflowActionParameters": {"WFInput": token}}],
    }, fmt=plistlib.FMT_BINARY)


def mac_shortcuts():
    out = subprocess.run(["shortcuts", "list"], capture_output=True, text=True, check=True).stdout
    return out.splitlines()


def confirm_mac_import():
    """导入确认框是「快捷指令」的一个窗口，里面有「添加快捷指令」按钮；用 computer-use 在后台点掉。"""
    def cu(*args):
        return subprocess.run(["computer-use", *args], capture_output=True, text=True, timeout=60).stdout
    for line in cu("windows").splitlines():
        cols = line.split("\t")
        if len(cols) > 2 and cols[2] == "快捷指令":
            for hit in cu("find", cols[0], "添加快捷指令").splitlines():
                m = re.match(r"(t\d+)\tButton\t添加快捷指令", hit)
                if m:
                    cu("click", cols[0], m.group(1))
                    return True
    return False


def cmd_setup_shortcut(a):
    """在 Mac 上生成并签名中转快捷指令，后台导入，经 iCloud 同步到手机，再用 prefs: 实测。"""
    import tempfile
    if a.name in mac_shortcuts():
        print(f"Mac 的快捷指令里已有「{a.name}」，跳过导入，只在当前手机上验证", flush=True)
    else:
        with tempfile.TemporaryDirectory() as d:
            raw_f, signed = Path(d) / "raw.shortcut", Path(d) / f"{a.name}.shortcut"
            raw_f.write_bytes(relay_shortcut_bytes())
            subprocess.run(["shortcuts", "sign", "-m", "anyone", "-i", str(raw_f), "-o", str(signed)], check=True, capture_output=True)
            subprocess.run(["open", "-g", "-a", "Shortcuts", str(signed)], check=True)
            for _ in range(30):
                if a.name in mac_shortcuts():
                    break
                confirm_mac_import()
                time.sleep(2)
            else:
                raise Fail("60s 内 Mac 的快捷指令里没出现该条目；手动打开快捷指令 App 点「添加快捷指令」，需要 computer-use 命令可用")
        print(f"已导入「{a.name}」，等待 iCloud 同步到手机...", flush=True)
    if not ready():
        print("WDA 未运行，跳过实测。iphone up 之后用 iphone open prefs:root=BATTERY_USAGE 验证")
        return
    require_unlocked()
    for _ in range(12):
        sess("POST", "/wda/apps/activate", {"bundleId": "com.apple.shortcuts"}, timeout=45)
        time.sleep(2)
        if any(n["type"] == "Cell" and text_of(n).startswith(a.name) for n in snapshot_now()["nodes"]):
            break
        time.sleep(3)
    else:
        raise Fail("60s 内手机上没出现该快捷指令。\n" + relay_notice())
    wda("POST", "/wda/homescreen", {})
    open_url("prefs:root=BATTERY_USAGE", direct=False, relay=a.name)
    # 快捷指令首次运行可能在手机上弹授权提示；批准属于用户，这里只把内容报出来并等待
    told, app, seen = False, None, []
    for _ in range(30):
        time.sleep(2)
        app = (wda("GET", "/wda/activeAppInfo") or {}).get("bundleId")
        if app == SETTINGS:
            break
        try:
            seen = [text_of(n) for n in snapshot_now()["nodes"] if n["type"] in ("Alert", "Sheet", "Button", "StaticText")][:8]
        except Fail:
            seen = []
        if seen and not told:
            print("手机上可能出现了授权提示，请你本人处理（最多等 60 秒）: " + " | ".join(seen), flush=True)
            told = True
    wda("POST", "/wda/homescreen", {})
    if app != SETTINGS:
        raise Fail(f"实测失败：前台是 {app}，不是设置；屏幕上: {' | '.join(seen) or '无'}。手机上打开该快捷指令，确认含「打开 URL」且输入是「快捷指令输入」")
    cfg = config()
    cfg["open_url_shortcut"] = a.name
    CFG.write_text(json.dumps(cfg, indent=2, ensure_ascii=False))
    print("实测通过：prefs: 经中转快捷指令打开了设置")


# ---------- 自检 ----------

def selftest():
    xml = ('<XCUIElementTypeApplication type="XCUIElementTypeApplication" bundleId="com.test" x="0" y="0" width="400" height="800">'
           '<XCUIElementTypeButton type="XCUIElementTypeButton" label="通用" name="BackButton" x="16" y="60" width="44" height="44">'
           '<XCUIElementTypeStaticText type="XCUIElementTypeStaticText" label="通用" x="20" y="64" width="30" height="20"/></XCUIElementTypeButton>'
           '<XCUIElementTypeStaticText type="XCUIElementTypeStaticText" label="屏外" x="0" y="900" width="30" height="20"/>'
           '<XCUIElementTypeTextField type="XCUIElementTypeTextField" x="10" y="100" width="200" height="30"/>'
           '<XCUIElementTypeOther type="XCUIElementTypeOther" x="0" y="0" width="400" height="800"/>'
           '</XCUIElementTypeApplication>')
    app, vp, nodes = parse_tree(xml)
    assert app == "com.test" and vp == {"width": 400, "height": 800}
    assert [n["type"] for n in nodes] == ["Button", "TextField"], nodes  # 折叠重复文字、裁掉屏外和空容器
    assert nodes[0]["name"] == "BackButton" and nodes[0]["t"] == "t1"
    old = {"app": "a", "nodes": nodes}
    new = {"app": "a", "nodes": [dict(nodes[0], t="t1"), {"t": "t2", "type": "Switch", "label": "Wi-Fi", "rect": [0, 0, 1, 1]}]}
    d = diff(old, new)
    assert "+ t2 Switch \"Wi-Fi\" [0,0,1,1]" in d and any(l.startswith("- TextField") for l in d), d
    assert diff(old, old)[0].startswith("observe: 树无变化")
    # iOS 15 的设置页没有 com.apple.settings.* 标识，只有本地化文字；页面已加载却没有标识就该立刻放弃，不能滚动搜索
    assert _settings_ids([{"type": "Cell", "label": t, "rect": [0, 0, 1, 1]} for t in "abc"]) is False
    assert _settings_ids([]) is None
    assert _settings_ids([{"type": "Button", "name": "com.apple.settings.displayAndBrightness", "rect": [0, 0, 1, 1]}]) is True
    # status 要说的是手机上已装 Runner 的来源，不是「现在重装会走哪条路」：来源由 bundle id 判断
    demo = {"bundle_id": "com.x.wda"}
    assert runner_kind("com.x.wda.runner", demo) == "plumesign" and runner_kind("com.x.wda.xctrunner", demo) == "xcode"
    assert runner_kind(OFFICIAL_RUNNER_ID + ".ABC123", demo) == "sidestore" and runner_kind(None, demo) is None
    # 本进程启动的子进程被终止后是僵尸；pid_alive 必须把它当作已退出，stop_wda 不能抛 EPERM
    import tempfile
    g, saved = globals(), (PIDFILE, CLI)
    with tempfile.TemporaryDirectory() as tmp:
        g["CLI"], g["PIDFILE"] = Path(tmp), Path(tmp) / "wda.pid"
        child = subprocess.Popen(["sleep", "60"], start_new_session=True)
        PIDFILE.write_text(str(child.pid))
        stop_wda()
        assert pid_alive() is None and not PIDFILE.exists()
    g["PIDFILE"], g["CLI"] = saved[0], saved[1]
    # 贴着底边的行（中心落进底部手势区）要先滚进安全区再返回；列表滚不动时照样返回，不能白耗循环
    vp, drags = {"width": 390, "height": 844}, []

    def fake_list(y, movable):
        pos = [y]

        def poll(kind, name, wait):
            return {"viewport": vp, "nodes": [{"type": "Button", "name": "row", "rect": [16, pos[0], 358, 53]}]}, \
                {"type": "Button", "name": "row", "rect": [16, pos[0], 358, 53]}

        def drag(method, path, body=None, **kw):
            drags.append(body)
            if movable:
                pos[0] -= 250
        return poll, drag

    saved = (g["_poll_node"], g["sess"], g["time"])
    class NoSleep:
        sleep = staticmethod(lambda s: None)
        time = staticmethod(time.time)
    try:
        g["time"] = NoSleep
        g["_poll_node"], g["sess"] = fake_list(807, True)
        _, n = _find_scrolling("Button", "row", 3)
        assert n["rect"][1] == 557 and len(drags) == 1, (n, drags)
        drags.clear()
        g["_poll_node"], g["sess"] = fake_list(807, False)
        _, n = _find_scrolling("Button", "row", 3)
        assert n["rect"][1] == 807 and len(drags) == 1, (n, drags)
    finally:
        g["_poll_node"], g["sess"], g["time"] = saved
    # tap-text：精确优先、同位置重复节点算一个、屏外不算、多个命中不猜
    def node(t, kind, label, rect):
        return {"t": t, "type": kind, "label": label, "rect": rect}

    screen = {"app": "a", "viewport": {"width": 390, "height": 844}, "nodes": [
        node("t1", "Button", "Home", [0, 766, 78, 44]), node("t2", "StaticText", "Home", [0, 766, 78, 44]),
        node("t3", "StaticText", "Homework", [100, 100, 80, 20]),
        node("t4", "Button", "Done", [10, 200, 50, 20]), node("t5", "Button", "Done", [10, 300, 50, 20]),
        node("t6", "Button", "Offscreen", [10, 900, 50, 20])]}
    taps = []
    saved = tuple(g[k] for k in ("snapshot_now", "sess", "act", "require_unlocked", "time"))
    g["snapshot_now"], g["require_unlocked"], g["time"] = lambda: screen, lambda: None, NoSleep
    g["sess"] = lambda method, path, body=None, **kw: taps.append(body)
    g["act"] = lambda args, do: do()

    def tap_text(*words, index=None):
        taps.clear()
        cmd_tap_text(argparse.Namespace(text=list(words), index=index))

    try:
        tap_text("home")
        assert taps == [{"x": 39, "y": 788}], taps  # 精确的 Home 压过 Homework，Button 与 StaticText 同位置只点一次
        for bad in ("done", "offscreen", "nope"):
            try:
                tap_text(bad)
            except Fail:
                continue
            raise AssertionError(f"{bad} 应该报错")
        tap_text("done", index=1)
        assert taps == [{"x": 35, "y": 310}], taps
        calls = [0]

        def drifting():  # 列表一直在滚：目标位置每次都不同，不能点
            calls[0] += 1
            return {**screen, "nodes": [node("t1", "Button", "Moving", [10, 100 + calls[0], 50, 20])]}

        g["snapshot_now"] = drifting
        try:
            tap_text("moving")
        except Fail:
            assert not taps
        else:
            raise AssertionError("位置一直在变时不该点击")
    finally:
        g["snapshot_now"], g["sess"], g["act"], g["require_unlocked"], g["time"] = saved
    # ---------- 安装路径：下载校验、系统下限、路径表、plumesign 流程、过期、init ----------
    import contextlib
    import io

    @contextlib.contextmanager
    def patched(**kw):
        before = {k: g[k] for k in kw}
        g.update(kw)
        try:
            yield
        finally:
            g.update(before)

    def expect_fail(fn, *words):
        try:
            fn()
        except Fail as e:
            assert all(w in str(e) for w in words), (words, str(e))
            return
        raise AssertionError(f"应该报错并含 {words}")

    def quiet(fn, *args, **kw):
        with contextlib.redirect_stdout(io.StringIO()) as buf:
            r = fn(*args, **kw)
        return r, buf.getvalue()

    def make_zip(path, members):
        with zipfile.ZipFile(path, "w") as z:
            for name, data, mode in members:
                zi = zipfile.ZipInfo(name)
                zi.external_attr = (0o100000 | mode) << 16
                z.writestr(zi, data)

    def fake_app(root, main_min, xctest_min):
        fa = root / RUNNER_APP
        (fa / "PlugIns/WebDriverAgentRunner.xctest").mkdir(parents=True)
        (fa / "Info.plist").write_bytes(plistlib.dumps({"CFBundleExecutable": "WebDriverAgentRunner-Runner", "MinimumOSVersion": main_min}))
        (fa / "PlugIns/WebDriverAgentRunner.xctest/Info.plist").write_bytes(plistlib.dumps({"MinimumOSVersion": xctest_min}))
        (fa / "WebDriverAgentRunner-Runner").write_bytes(b"bin")
        (fa / "WebDriverAgentRunner-Runner").chmod(0o755)
        return fa

    # 文本解析与错误翻译
    assert ios_values('{"level":"info","msg":"x"}\nWARN y\n["a"]\n"15.6.1"\n[{"CFBundleIdentifier":"b.runner"}]\n') == \
        [["a"], "15.6.1", [{"CFBundleIdentifier": "b.runner"}]]  # 日志行与 WARN 被丢掉，只留结果
    assert not image_mounted('{"level":"info","msg":"none"}') and image_mounted('{"level":"info","msg":"image signature","signature":"ab"}')
    assert "吊销" in tool_hint("x Revoked certificate y") and "anisette" in tool_hint("anisette server error: connection refused")
    assert "锁屏" in tool_hint("failed: PasswordProtected") and tool_hint("fine") == ""
    doc = {"result": {"devices": [{"hardwareProperties": {"reality": "physical", "udid": "U1"}},
                                  {"hardwareProperties": {"reality": "virtual", "udid": "U3"}},
                                  {"hardwareProperties": {"reality": "physical", "ecid": 1}}]}}
    assert devicectl_serves(doc, "U1") and not devicectl_serves(doc, "U2") and not devicectl_serves(doc, "U3")
    assert account_listed("Saved accounts:\n x") and not account_listed("No accounts found")
    assert sidestore_id([{"CFBundleIdentifier": SIDESTORE_ID + ".ABC"}]) and sidestore_id([{"CFBundleIdentifier": "x"}]) is None

    with tempfile.TemporaryDirectory() as t:
        t = Path(t)
        # sha256 不符：拒绝，且不解包（连 zip 都不打开）
        good, evil = t / "good.zip", t / "evil.zip"
        make_zip(good, [(f"{RUNNER_APP}/Info.plist", b"x", 0o644), (f"{RUNNER_APP}/run", b"bin", 0o755)])
        make_zip(evil, [("../evil", b"x", 0o644), (f"{RUNNER_APP}/Info.plist", b"x", 0o644)])

        class NoZip:
            class ZipFile:
                def __init__(self, *a, **k):
                    raise AssertionError("sha256 不符后不该解包")

        with patched(zipfile=NoZip):
            expect_fail(lambda: unpack_runner(good, "0" * 64, t / "bad"), "sha256")
        assert not (t / "bad").exists() and not (t / "bad.part").exists()
        unpack_runner(good, hashlib.sha256(good.read_bytes()).hexdigest(), t / "ok")
        assert (t / "ok" / RUNNER_APP / "run").stat().st_mode & 0o111 and not (t / "ok.part").exists()  # 可执行位保留
        expect_fail(lambda: unpack_runner(evil, hashlib.sha256(evil.read_bytes()).hexdigest(), t / "slip"), "越界")  # zip-slip
        assert not (t / "evil").exists() and not (t / "slip").exists() and not (t / "slip.part").exists()
        with patched(ARTIFACTS=t / "art", OFFICIAL=t / "art" / "official",
                     download_file=lambda url, dest: dest.write_bytes(b"not the runner")):
            expect_fail(lambda: quiet(fetch_runner), "sha256")  # 下载到的内容与固定的哈希不符
        assert not (t / "art" / "official").exists() and not list((t / "art").glob("*.zip"))

        # 设备系统下限 = 两个组件 MinimumOSVersion 的最大值（按数字比较）
        assert runner_min_os(fake_app(t / "a1", "13.0", "15.0")) == "15.0"
        assert runner_min_os(fake_app(t / "a2", "16.4", "15.0")) == "16.4"
        assert runner_min_os(fake_app(t / "a3", "9.3", "10.0")) == "10.0"
        (t / "a4" / RUNNER_APP).mkdir(parents=True)
        (t / "a4" / RUNNER_APP / "Info.plist").write_bytes(plistlib.dumps({"MinimumOSVersion": "13.0"}))
        expect_fail(lambda: runner_min_os(t / "a4" / RUNNER_APP), "xctest")

        # IPA：Payload/<app>/...，权限保留
        build_ipa(t / "a1" / RUNNER_APP, t / "r.ipa")
        with zipfile.ZipFile(t / "r.ipa") as z:
            ent = {i.filename: i for i in z.infolist()}
        run_ent = ent[f"Payload/{RUNNER_APP}/WebDriverAgentRunner-Runner"]
        assert f"Payload/{RUNNER_APP}/Info.plist" in ent and (run_ent.external_attr >> 16) & 0o111

        # plumesign 流程：DeviceID 而不是 UDID；补签在第二遍之前；原样解包的目录不被改动；成品留在 signed/
        official = fake_app(t / "off", "13.0", "15.0")
        (t / "keys" / "TEAM123").mkdir(parents=True)
        (t / "keys" / "TEAM123" / "key.pem").write_text("KEY")
        c1 = {"udid": "00008030-ABCDEF", "bundle_id": "com.example.wda"}
        cmds = []

        def fake_run(cmd, check=True):
            cmds.append(list(cmd))
            if cmd[0] == "codesign":
                Path(cmd[2].split("=", 1)[1] + "0").write_bytes(b"der")
            elif cmd[0] == "openssl" and "-out" in cmd:
                Path(cmd[cmd.index("-out") + 1]).write_text("PEM")
            elif cmd[0] == "openssl":
                return "subject=UID=u, CN=Apple Development: a (b), OU=TEAM123, O=n, C=US"
            elif cmd[0] == "plumesign" and "--register-and-install" in cmd:
                (Path(cmd[cmd.index("--package") + 1]) / "embedded.mobileprovision").write_bytes(b"p")
            return ""

        with patched(SIGNED=t / "signed", PLUME_KEYS=t / "keys", fetch_runner=lambda: official):
            kept, _ = quiet(sign_runner, c1, 7, run=fake_run)
        assert [c[0] for c in cmds] == ["plumesign", "codesign", "openssl", "openssl", "rcodesign", "plumesign"], cmds
        first, rc, second = cmds[0], cmds[4], cmds[5]
        assert "--register-and-install" not in first and "--udid" not in first  # 第一遍不带设备
        assert second[second.index("--udid") + 1] == "7" and "00008030-ABCDEF" not in " ".join(second)  # DeviceID，不是 UDID
        assert second[second.index("--custom-identifier") + 1] == "com.example.wda.runner" and "--register-and-install" in second
        pkg = second[second.index("--package") + 1]
        assert pkg == first[first.index("--package") + 1] and Path(pkg) != official  # 都签同一份临时副本
        assert rc.count("--pem-file") == 2 and str(t / "keys" / "TEAM123" / "key.pem") in rc  # 按证书 OU 找到私钥
        assert rc[-1].startswith(pkg) and rc[-1].endswith(".xctest") and str(official) not in " ".join(rc)  # 补签的是副本里的 xctest
        assert not list(official.rglob("embedded.mobileprovision"))  # 官方解包目录原样
        assert kept == t / "signed" / RUNNER_APP and (kept / "embedded.mobileprovision").exists()

        # 过期读取：profile 里的 ExpirationDate；没有文件或解不开都是 None
        def profile(days):
            exp = (datetime.now(timezone.utc) + timedelta(days=days)).replace(tzinfo=None)
            return lambda f: plistlib.dumps({"ExpirationDate": exp})

        with patched(_decode_profile=profile(3)):
            assert 2.9 < days_left(kept) < 3.1
        with patched(_decode_profile=profile(-1)):
            assert days_left(kept) < 0
        with patched(_decode_profile=lambda f: None):
            assert days_left(kept) is None
        assert days_left(t / "nothing") is None

    # 路径表：每一档都用注入的假探测走一遍
    class FakeP:
        def __init__(self, **kw):
            self.v = {"ready": False, "installed": None, "start": True, "version": "15.6.1", "floor": "15.0",
                      "xcode": False, "plume": "", "side": False, **kw}
            self.calls, self.started = [], []

        def _a(self, name):
            self.calls.append(name)
            return self.v[name]

        def ready(self):
            return self._a("ready")

        def runner_installed(self, cfg):
            return self._a("installed")

        def start(self, cfg, rid):
            self.started.append(rid)
            return self._a("start")

        def device_version(self, cfg):
            return self._a("version")

        def min_os(self):
            return self._a("floor")

        def xcode_serves(self, cfg):
            return self._a("xcode")

        def plumesign_state(self):
            return self._a("plume")

        def sidestore(self, cfg):
            return self._a("side")

    c3 = {"udid": "U", "bundle_id": "b"}

    def route(**kw):
        p = FakeP(**kw)
        r, buf = quiet(choose_route, c3, p)
        return r, buf.splitlines(), p.calls

    r, lines, calls = route(ready=True, installed="b.runner", xcode=True)  # 已就绪：后面的探测都不跑
    assert r == "ready" and lines == ["路径: 已就绪"] and calls == ["ready"], (r, lines, calls)
    r, lines, calls = route(installed="b.runner")  # 已装 Runner 且能起
    assert r == "installed" and lines == ["路径: 已装 Runner"] and "xcode" not in calls, (r, lines, calls)
    r, lines, calls = route(installed="b.runner", start=False, xcode=True)  # 已装但起不来：继续往下
    assert r == "xcode" and lines[0] == "路径: 已装 Runner" and lines[-1] == "路径: Xcode", lines
    expect_fail(lambda: route(version="14.8", xcode=True, plume="", side=True), "14.8", "15.0")  # 系统低于下限，Xcode 也不行
    assert route(version=None, xcode=True)[0] == "xcode"  # 读不到版本：跳过下限
    r, lines, calls = route(xcode=True, plume="", side=True)  # Xcode 优先于后面
    assert r == "xcode" and "plume" not in calls and lines == ["路径: Xcode"], (r, lines, calls)
    r, lines, calls = route(plume="", side=True)  # plumesign
    assert r == "plumesign" and "side" not in calls and lines == ["路径: plumesign"], (r, lines, calls)
    r, lines, calls = route(plume="缺 plumesign", side=True)  # SideStore
    assert r == "sidestore" and "未验证" in lines[-1], (r, lines)
    expect_fail(lambda: route(plume="缺 plumesign"), "Xcode", "plumesign", "SideStore")  # 都不满足：列出方案

    # iOS 17 及以上：已装直启、plumesign、SideStore 都不可用，在碰 plumesign 与 SideStore 之前就报错；Xcode 照常
    p17 = FakeP(version="17.2", installed="b.runner", plume="", side=True)
    expect_fail(lambda: quiet(choose_route, c3, p17), "iOS 17 及以上需要 Xcode 路径", "tunnel", "Xcode")
    assert not {"installed", "start", "plume", "side"} & set(p17.calls) and not p17.started, p17.calls
    assert route(version="17.2", installed="b.runner", xcode=True)[0] == "xcode"
    assert route(version="16.7", installed="b.runner")[0] == "installed"

    # 已装 Runner 的识别：三种候选各自命中，前缀对应 SideStore 路径（id 后缀未验证）；runwda 用匹配到的 id
    c4 = {"udid": "U", "bundle_id": "com.x.y"}

    def apps_of(*ids):
        return [{"CFBundleIdentifier": i} for i in ids]

    sidestore_rid = OFFICIAL_RUNNER_ID + ".ABC123"
    assert find_runner(apps_of("a", "com.x.y.runner"), c4) == "com.x.y.runner"
    assert find_runner(apps_of("com.x.y.xctrunner"), c4) == "com.x.y.xctrunner"
    assert find_runner(apps_of("a", sidestore_rid), c4) == sidestore_rid
    assert find_runner(apps_of(sidestore_rid, "com.x.y.xctrunner", "com.x.y.runner"), c4) == "com.x.y.runner"
    assert find_runner(apps_of(sidestore_rid, "com.x.y.xctrunner"), c4) == "com.x.y.xctrunner"
    assert find_runner(apps_of("com.other"), c4) is None and find_runner([], c4) is None
    probes = Probes()
    probes._apps = apps_of(sidestore_rid)
    assert probes.runner_installed(c4) == sidestore_rid
    for rid in ("com.x.y.runner", "com.x.y.xctrunner", sidestore_rid):
        cmd = runwda_cmd(c4, rid)
        assert cmd[:2] == ["ios", "runwda"] and f"--bundleid={rid}" in cmd and f"--testrunnerbundleid={rid}" in cmd, cmd

    # 已装 Runner 起不来（比如账号证书被吊销，本地副本却没到期）：up 仍要走一轮签名安装，且只有一轮
    signs, launches = [], []
    pf = FakeP(installed="com.x.y.runner", start=False, plume="")
    with patched(config=lambda: c4, need_usb=lambda c: (7, "U"), need_tool=lambda n: None, Probes=lambda timeout: pf,
                 install_plumesign=lambda c, d: signs.append(d), finish_up=lambda a: None,
                 launch_runwda=lambda c, timeout, rid: launches.append(rid)):
        quiet(cmd_up, argparse.Namespace(restart=False, timeout=5))
    assert pf.started == ["com.x.y.runner"] and signs == [7] and launches == ["com.x.y.runner"], (pf.started, signs, launches)

    # DDI 在启动 runwda 之前准备：准备失败时不会启动进程
    with tempfile.TemporaryDirectory() as t:
        def no_ddi(c):
            raise Fail("ddi")

        with patched(CLI=Path(t), PIDFILE=Path(t) / "wda.pid", UPLOG=Path(t) / "up.log", need_tool=lambda n: None, ensure_ddi=no_ddi):
            expect_fail(lambda: launch_runwda(c4, 5, "com.x.y.runner"), "ddi")
        assert not (Path(t) / "wda.pid").exists()

    # init：只必填 --bundle；--udid 缺失按设备数报错；--team 只在走 Xcode 路径时要
    with tempfile.TemporaryDirectory() as t:
        t = Path(t)

        def ns(**kw):
            return argparse.Namespace(**{"team": None, "bundle": None, "udid": None, **kw})

        with patched(HOME=t, CFG=t / "config.json", CLI=t / "cli", PIDFILE=t / "cli" / "wda.pid",
                     RUNNER=t / "r", SIGNED=t / "s", usb_devices=lambda: []):
            expect_fail(lambda: cmd_init(ns(udid="U1")), "--bundle")
            expect_fail(lambda: cmd_init(ns(bundle="com.x.y")), "--udid")
            with patched(usb_devices=lambda: [(1, "A"), (2, "B")]):
                expect_fail(lambda: cmd_init(ns(bundle="com.x.y")), "--udid", "A", "B")
            quiet(cmd_init, ns(bundle="com.x.y", udid="U1"))
            c2 = json.loads(CFG.read_text())
            assert c2["udid"] == "U1" and c2["bundle_id"] == "com.x.y" and "team_id" not in c2
            assert "source_dir" not in c2 and "local_port" not in c2
            expect_fail(lambda: require_team(c2), "--team")
            with patched(usb_devices=lambda: [(1, "U1")]):
                quiet(cmd_init, ns(team="TEAM1"))  # 沿用已有 bundle；udid 取唯一一台
            c2 = json.loads(CFG.read_text())
            assert c2["team_id"] == "TEAM1" and c2["bundle_id"] == "com.x.y"
            require_team(c2)
    print("selftest ok")


def main():
    p = argparse.ArgumentParser(prog="iphone", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help, observe=False):
        sp = sub.add_parser(name, help=help)
        sp.set_defaults(fn=fn)
        if observe:
            sp.add_argument("--no-observe", action="store_true", help="动作后不输出树差分")
            sp.add_argument("--wait", type=int, default=500, help="动作后等待界面稳定的毫秒数，默认 500")
        return sp

    sp = add("init", cmd_init, "写配置；只必填 --bundle，换设备时重新运行")
    sp.add_argument("--bundle", help="全局唯一的 bundle id，如 com.example.wda；首次必填，已有配置时可省略")
    sp.add_argument("--team", help="Apple Team ID；只有走 Xcode 路径才需要")
    sp.add_argument("--udid", help="手机 UDID；省略时用唯一一台 USB 设备")
    add("renew", cmd_renew, "对当前路径强制重新签名并安装（免费证书 7 天过期后用）")
    sp = add("up", cmd_up, "按本机条件自动选路，把 Runner 装上手机并启动，等待就绪；证书过期时自动重签")
    sp.add_argument("--restart", action="store_true")
    sp.add_argument("--timeout", type=int, default=120)
    sp.add_argument("--no-keep-awake", action="store_true", help="不把自动锁定改为永不")
    sp = add("down", cmd_down, "停止由本 CLI 启动的 WDA，并把自动锁定恢复为 3 分钟")
    sp.add_argument("--no-keep-awake", action="store_true", help="不恢复自动锁定")
    sp = add("autolock", cmd_autolock, "设置自动锁定时间（走设置 App 的 UI）")
    sp.add_argument("value", choices=list(AUTOLOCK_CHOICES), help="never 或秒数 30/60/120/180/240/300")
    add("status", cmd_status, "设备、WDA、安装路径、锁屏、前台 App、证书剩余天数")
    sp = add("snapshot", cmd_snapshot, "读界面树（带 tN 元素 token）")
    sp.add_argument("--max", type=int, default=MAX_NODES)
    sp.add_argument("--full", action="store_true", help="标签不截断（读长帖、长消息）")
    sp = add("find", cmd_find, "按文字查找元素；无命中退出码 1")
    sp.add_argument("text", nargs="+")
    sp.add_argument("--max", type=int, default=MAX_NODES)
    sp.add_argument("--full", action="store_true", help="标签不截断（读长帖、长消息）")
    sp = add("wait", cmd_wait, "等待文字出现；超时退出码 1")
    sp.add_argument("text", nargs="+")
    sp.add_argument("--timeout", type=int, default=10)
    sp = add("shot", cmd_shot, "截图存为缩小的 JPEG，输出路径")
    sp.add_argument("--size", type=int, default=1000, help="长边像素，默认 1000")
    sp = add("tap", cmd_tap, "点击 tN 或点坐标 X Y", observe=True)
    sp.add_argument("target", nargs="+")
    sp = add("tap-text", cmd_tap_text, "按文字点击屏幕上的元素（先精确后包含）；多个命中时报出候选，用 --index 选", observe=True)
    sp.add_argument("text", nargs="+")
    sp.add_argument("--index", type=int, help="多个命中时选第几个（从 0 起）")
    sp = add("type", cmd_type, "输入文字；给 tN 则先点它聚焦，--clear 先清空。不会提交", observe=True)
    sp.add_argument("--target", metavar="tN")
    sp.add_argument("--clear", action="store_true", help="先清空 --target 输入框再输入；text 可省略")
    sp.add_argument("text", nargs="?", default="")
    sp = add("key", cmd_key, "按键", observe=True)
    sp.add_argument("name", choices=["return", "delete", "home"])
    add("home", cmd_home, "回主屏幕", observe=True)
    sp = add("scroll", cmd_scroll, "滚动：down 表示看后面的内容", observe=True)
    sp.add_argument("direction", choices=["down", "up", "left", "right"])
    sp.add_argument("target", nargs="?", metavar="tN")
    sp = add("drag", cmd_drag, "手指从 (x1,y1) 拖到 (x2,y2)，单位是点", observe=True)
    for k in ("x1", "y1", "x2", "y2"):
        sp.add_argument(k, type=float)
    sp.add_argument("--duration", type=float, default=0.3)
    sp = add("launch", cmd_launch, "按 bundle id 启动 App", observe=True)
    sp.add_argument("bundle")
    sp = add("stop", cmd_stop, "结束某个 App", observe=True)
    sp.add_argument("bundle")
    sp = add("open", cmd_open, "打开 URL 或 scheme（https:、prefs:root=BATTERY_USAGE 等）", observe=True)
    sp.add_argument("url")
    sp.set_defaults(wait=2500)  # 跨 App 跳转比应用内点击慢
    sp = add("setup-shortcut", cmd_setup_shortcut, "在 Mac 安装中转快捷指令（同一 iCloud 的手机自动同步），并在当前手机上验证")
    sp.add_argument("--name", default=RELAY_NAME)
    sub.add_parser("shortcut-link", help="展示中转快捷指令的 iCloud 链接（给与 Mac 不同 iCloud 的手机用）").set_defaults(fn=cmd_shortcut_link)
    sub.add_parser("selftest", help="离线自检").set_defaults(fn=lambda a: selftest())

    a = p.parse_args()
    t = time.time()
    try:
        rc = a.fn(a) or 0
    except Fail as e:
        print(f"error: {e}", file=sys.stderr)
        rc = 1
    except subprocess.CalledProcessError as e:
        print(f"error: 命令失败 {e.cmd[:3]} rc={e.returncode}", file=sys.stderr)
        rc = 1
    print(f"duration_ms={int((time.time() - t) * 1000)}")
    return rc


if __name__ == "__main__":
    sys.exit(main())
