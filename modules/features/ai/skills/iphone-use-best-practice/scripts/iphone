#!/usr/bin/env python3
"""iphone: Pinky 的 MCP 薄封装，读取并操作 USB 连接的真实 iPhone。

只依赖标准库。每条子命令对应一个 phone_* 工具，经 Pinky 的 Streamable HTTP 端点调用；
MCP 会话 ID 存在 $IPHONE_HOME/session，所以租约跨进程保留。审批、屏蔽 App、凭据字段拦截都由 Pinky 网关执行。
先决条件: Pinky 已安装，设置 › 智能体 › 远程智能体（Settings › Agents › Remote agents） 已打开（设计见 ../README.md）。
"""
import argparse
import base64
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path(os.environ.get("IPHONE_HOME", "~/.local/share/iphone-use")).expanduser()
SESSION = HOME / "session"
SHOTS = HOME / "shots"
URL = os.environ.get("IPHONE_PINKY_URL", "http://127.0.0.1:7465/mcp")
PINKY_APPS = ("/Applications/Pinky.app/Contents/MacOS/Pinky", "~/Applications/Pinky.app/Contents/MacOS/Pinky")
PROTOCOL = "2025-06-18"
KEYS = ["back", "home", "recents", "enter", "tab", "delete", "forward_delete", "escape",
        "dpad_up", "dpad_down", "dpad_left", "dpad_right", "page_up", "page_down"]
SWIPE = {"down": "up", "up": "down", "right": "left", "left": "right"}  # 手指方向与内容相反
ELEMENT = re.compile(r'^\[(\d+)\]\s+\S+\s+"(.*?)"(?:\s+@(\d+),(\d+))?')
OCR = re.compile(r'^ocr\s+"(.*?)"\s+@(\d+),(\d+)')


class Fail(Exception):
    pass


# ---------- Pinky 进程与 HTTP ----------

def pinky_bin():
    for c in (os.environ.get("PINKY_BIN"), shutil.which("pinkyctl"), *PINKY_APPS):
        if c and os.access(os.path.expanduser(c), os.X_OK):
            return os.path.expanduser(c)
    raise Fail("找不到 Pinky。安装 Pinky 并打开一次，或用 PINKY_BIN 指定它的可执行文件")


def token():
    if os.environ.get("PINKY_TOKEN"):
        return os.environ["PINKY_TOKEN"]
    r = subprocess.run([pinky_bin(), "token"], capture_output=True, text=True)
    if r.returncode or not r.stdout.strip():
        raise Fail(f"取不到 Pinky 的 agent token: {r.stderr.strip()}")
    return r.stdout.strip()


def rpc(body, sid=None, timeout=120):
    """发一条 JSON-RPC；返回 (会话 ID, 结果)。响应是 SSE 或 JSON，按 id 取对应那条。"""
    headers = {"Authorization": f"Bearer {token()}", "Content-Type": "application/json",
               "Accept": "application/json, text/event-stream"}
    if sid:
        headers["Mcp-Session-Id"] = sid
    req = urllib.request.Request(URL, json.dumps(body).encode(), headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw, new_sid = r.read().decode(), r.headers.get("Mcp-Session-Id")
    except urllib.error.HTTPError as e:
        if e.code == 401:
            raise Fail("Pinky 拒绝了 token。检查 PINKY_TOKEN，或 Pinky token 是否被重置")
        if e.code == 404:
            raise Fail("会话已失效")
        raise Fail(f"Pinky HTTP {e.code}: {e.read().decode()[:200]}")
    except (urllib.error.URLError, ConnectionError, socket.timeout) as e:
        raise Fail(f"连不上 Pinky 的 HTTP 端点 {URL}（{e}）。打开 Pinky，在 设置 › 智能体 › 远程智能体（Settings › Agents › Remote agents） 开启它")
    if not raw.strip():
        return new_sid, None
    for chunk in re.findall(r"^data:\s*(.*)$", raw, re.M) or [raw]:
        msg = json.loads(chunk)
        if msg.get("id") == body.get("id"):
            if "error" in msg:
                raise Fail(f"MCP 错误: {msg['error'].get('message')}")
            return new_sid, msg["result"]
    raise Fail("Pinky 没有返回对应的响应")


def new_session():
    sid, _ = rpc({"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {
        "protocolVersion": PROTOCOL, "capabilities": {}, "clientInfo": {"name": "iphone", "version": "1"}}})
    rpc({"jsonrpc": "2.0", "method": "notifications/initialized"}, sid)
    HOME.mkdir(parents=True, exist_ok=True)
    SESSION.write_text(sid)
    return sid


def call(tool, args, create=False):
    """调用一个工具，返回 (文本, 图片块列表)。create: 没有会话时新建（只有 up 这样做）。"""
    sid = SESSION.read_text().strip() if SESSION.exists() else None
    body = {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": tool, "arguments": args}}
    for attempt in (0, 1):
        if not sid:
            if not create:
                raise Fail("没有会话。先运行 iphone up")
            sid = new_session()
        try:
            _, result = rpc(body, sid)
            break
        except Fail as e:
            if str(e) != "会话已失效" or attempt:
                raise
            SESSION.unlink(missing_ok=True)
            sid = None
            if not create:
                raise Fail("会话已过期。先运行 iphone up")
    blocks = result.get("content", [])
    return "\n".join(b["text"] for b in blocks if b["type"] == "text"), [b for b in blocks if b["type"] == "image"]


def run(tool, args, create=False):
    """调用并打印；首行状态是 settled 才算成功。返回 (退出码, 文本)。"""
    text, _ = call(tool, {k: v for k, v in args.items() if v is not None and v is not False}, create)
    print(text)
    if "phone_connect first" in text:
        print("hint: 租约已结束或没连手机。运行 iphone up", file=sys.stderr)
    return (0 if text.startswith("settled") else 1), text


def common(a):
    """动作工具共有的参数。"""
    return {"intent": a.intent, "approval_id": a.approval_id}


# ---------- 子命令 ----------

def cmd_up(a):
    apps = [x.strip() for x in a.apps.split(",")] if a.apps else None
    return run("phone_connect", {"task": a.task, "device": a.device, "apps": apps, "read_only": a.read_only,
                                 "approval_id": a.approval_id}, create=True)[0]


def cmd_down(a):
    rc = run("phone_release", {"outcome": a.outcome, "summary": a.summary})[0]
    SESSION.unlink(missing_ok=True)
    return rc


def cmd_status(a):
    r = subprocess.run([pinky_bin(), "devices"], capture_output=True, text=True)
    print(r.stdout.strip() or r.stderr.strip())
    host = urllib.parse.urlparse(URL)
    try:
        socket.create_connection((host.hostname, host.port), timeout=2).close()
        print(f"HTTP: 可达 ({URL})")
    except OSError:
        print(f"HTTP: 不可达 ({URL})。在 Pinky 的 设置 › 智能体 › 远程智能体（Settings › Agents › Remote agents） 开启")
    print("会话: " + ("有（租约是否还在要看 iphone snapshot）" if SESSION.exists() else "无，先 iphone up"))
    return 0


def cmd_snapshot(a):
    return run("phone_observe", {"wait_ms": a.wait_ms})[0]


def cmd_shot(a):
    text, images = call("phone_observe", {"screenshot": True})
    if not images:
        print(text)
        raise Fail("没有截图（手机锁屏，或前台是被屏蔽的 App）")
    SHOTS.mkdir(parents=True, exist_ok=True)
    for old in sorted(SHOTS.glob("*"))[:-20]:
        old.unlink()
    out = SHOTS / (time.strftime("%Y%m%d-%H%M%S") + ".jpg")
    out.write_bytes(base64.b64decode(images[0]["data"]))
    print(f"{out}\n坐标单位是截图像素，与 snapshot 的 @x,y 一致")
    return 0


def screen_lines():
    text, _ = call("phone_observe", {})
    return text.splitlines()


def cmd_find(a):
    q = " ".join(a.text).lower()
    lines = screen_lines()
    hits = [l for l in lines if (ELEMENT.match(l) or OCR.match(l)) and q in l.lower()]
    print("\n".join(lines[:1] + hits))
    return 0 if hits else 1


def cmd_wait(a):
    rc, text = run("phone_wait_for", {"text": " ".join(a.text), "gone": a.gone, "timeout_ms": a.timeout * 1000})
    return 1 if "matched: false" in text else rc


def tap(a, **kw):
    return run("phone_tap", {**common(a), "long_press": a.long, **kw})[0]


def cmd_tap(a):
    if len(a.target) == 1:
        return tap(a, ref=int(a.target[0]))
    if len(a.target) == 2:
        return tap(a, x=int(a.target[0]), y=int(a.target[1]))
    raise Fail("用法: iphone tap REF | iphone tap X Y（X Y 是截图像素）")


def cmd_tap_text(a):
    q = " ".join(a.text).lower()
    found = []  # (标签, tap 参数)
    for l in screen_lines():
        m, o = ELEMENT.match(l), OCR.match(l)
        label = (m or o).group(2) if (m or o) else ""
        if q in label.lower():
            found.append((label, {"ref": int(m.group(1))} if m else {"x": int(o.group(2)), "y": int(o.group(3))}, l))
    exact = [f for f in found if f[0].lower() == q]
    pool = exact or found
    if not pool:
        raise Fail(f"屏幕上没有包含「{q}」的元素；先 iphone find {q} 或 iphone shot 看看")
    if a.index is None and len(pool) > 1:
        raise Fail(f"{len(pool)} 个元素命中，用 --index N 选一个（从 0 起）:\n" + "\n".join(f"  [{i}] {f[2]}" for i, f in enumerate(pool)))
    if not 0 <= (a.index or 0) < len(pool):
        raise Fail(f"--index 超出范围，共 {len(pool)} 个命中")
    return tap(a, **pool[a.index or 0][1])


def cmd_type(a):
    if not a.text and not a.submit:
        raise Fail("没有要输入的文字。清空输入框：点它旁边的清除按钮（如 iphone tap-text 清除文本），或直接输入新内容替换")
    return run("phone_type", {**common(a), "text": a.text, "ref": a.ref, "append": a.append, "submit": a.submit})[0]


def cmd_key(a):
    return run("phone_key", {**common(a), "key": "enter" if a.name == "return" else a.name})[0]


def cmd_home(a):
    return run("phone_key", {**common(a), "key": "home"})[0]


def cmd_scroll(a):
    return run("phone_swipe", {**common(a), "direction": SWIPE[a.direction], "ref": a.ref})[0]


def cmd_drag(a):
    return run("phone_swipe", {**common(a), "from": {"x": a.x1, "y": a.y1}, "to": {"x": a.x2, "y": a.y2},
                               "duration_ms": a.duration})[0]


def cmd_launch(a):
    return run("phone_launch", {**common(a), "app": a.app})[0]


def cmd_apps(a):
    if not a.query and not a.all:
        raise Fail("不带关键词会列出手机上全部 App。用 iphone apps <关键词> 查。确实要全部列出再加 --all")
    return run("phone_apps", {"query": a.query})[0]


def cmd_handoff(a):
    return run("phone_handoff", {"reason": " ".join(a.reason), "approval_id": a.approval_id})[0]


def cmd_ask(a):
    return run("phone_request_approval", {"summary": " ".join(a.summary), "details": a.details, "approval_id": a.approval_id})[0]


def main():
    p = argparse.ArgumentParser(prog="iphone", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help, action=False):
        sp = sub.add_parser(name, help=help)
        sp.set_defaults(fn=fn)
        if action:
            sp.add_argument("--intent", help="一句话说明为什么做，显示在审批面板上；可能需要审批的动作都要给")
            sp.add_argument("--approval-id", help="上次返回 approval_pending 时的 id；用相同参数重发同一条命令")
        return sp

    sp = add("up", cmd_up, "租用手机并开始任务，返回首屏。首次连接要用户在 Pinky 里批准")
    sp.add_argument("--task", default="iPhone 操作", help="任务名，用户在 Pinky 里能看到，写清楚")
    sp.add_argument("--device", help="手机 id 或名称；只有一台在线时可省略")
    sp.add_argument("--apps", help="本次任务只允许的 App，逗号分隔（名称或 id）")
    sp.add_argument("--read-only", action="store_true", help="只读任务：凡是会请示用户的动作一律拒绝")
    sp.add_argument("--approval-id", help="首次连接返回 approval_pending 时的 id")
    sp = add("down", cmd_down, "结束任务并释放手机")
    sp.add_argument("--outcome", choices=["done", "failed", "partial", "cancelled"], default="done")
    sp.add_argument("--summary", help="给用户历史记录的一句话")
    add("status", cmd_status, "Pinky 看到的手机、HTTP 端点与会话")
    sp = add("snapshot", cmd_snapshot, "读整屏：每行 [ref] role \"label\" @x,y")
    sp.add_argument("--wait-ms", type=int, help="等界面变化后再读，最多 30000")
    add("shot", cmd_shot, "截图存为 JPEG，输出路径")
    sp = add("find", cmd_find, "按文字查找元素；无命中退出码 1")
    sp.add_argument("text", nargs="+")
    sp = add("wait", cmd_wait, "等文字出现；超时退出码 1")
    sp.add_argument("text", nargs="+")
    sp.add_argument("--timeout", type=int, default=10, help="秒，最多 45")
    sp.add_argument("--gone", action="store_true", help="等它消失")
    sp = add("tap", cmd_tap, "点击 REF，或点截图像素坐标 X Y", action=True)
    sp.add_argument("target", nargs="+")
    sp.add_argument("--long", action="store_true", help="长按")
    sp = add("tap-text", cmd_tap_text, "按文字点击（精确优先）；多个命中时列候选，用 --index 选", action=True)
    sp.add_argument("text", nargs="+")
    sp.add_argument("--index", type=int)
    sp.add_argument("--long", action="store_true", help="长按")
    sp = add("type", cmd_type, "输入文字，默认替换输入框原有内容；不提交，除非加 --submit", action=True)
    sp.add_argument("--ref", type=int, help="目标输入框；省略则输入到当前焦点")
    sp.add_argument("--append", action="store_true", help="保留原有内容")
    sp.add_argument("--submit", action="store_true", help="输入后按回车")
    sp.add_argument("text", nargs="?", default="")
    sp = add("key", cmd_key, "按键", action=True)
    sp.add_argument("name", choices=["return", *KEYS])
    add("home", cmd_home, "回主屏幕", action=True)
    sp = add("scroll", cmd_scroll, "滚动：down 表示看后面的内容", action=True)
    sp.add_argument("direction", choices=list(SWIPE))
    sp.add_argument("ref", nargs="?", type=int, help="在这个元素内滚动")
    sp = add("drag", cmd_drag, "手指从 (x1,y1) 拖到 (x2,y2)，单位是截图像素", action=True)
    for k in ("x1", "y1", "x2", "y2"):
        sp.add_argument(k, type=int)
    sp.add_argument("--duration", type=int, default=300, help="毫秒，80 到 1200")
    sp = add("launch", cmd_launch, "启动 App：bundle id 或名称，不收 URL", action=True)
    sp.add_argument("app")
    sp = add("apps", cmd_apps, "按关键词查已装 App（Pinky 允许范围内）；不带关键词要加 --all")
    sp.add_argument("query", nargs="?")
    sp.add_argument("--all", action="store_true", help="列出全部 App（会暴露手机上装了什么，慢用）")
    sp = add("handoff", cmd_handoff, "请用户接管（解锁、登录、输密码），等他交还")
    sp.add_argument("reason", nargs="+")
    sp.add_argument("--approval-id")
    sp = add("ask", cmd_ask, "向用户提问并等回答；它不授予任何权限")
    sp.add_argument("summary", nargs="+")
    sp.add_argument("--details")
    sp.add_argument("--approval-id")

    a = p.parse_args()
    try:
        return a.fn(a) or 0
    except Fail as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
