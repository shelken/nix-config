#!/usr/bin/env bun
// spawn-subagent.ts — 在 Herdr.app(hc 终端)、旧 Herdr 窗格或 Kitty 窗口中启动/关闭 pi 或 agy 子代理
// agent 真相源: ~/.pi/agent/agents/<profile>.md（nix 生成，只声明 role）: tools 与正文来自 md，
// model/thinking 每次派发按 md 的 role 实时读 ~/.omp/agent/config.yml（agy/<model>:<level> 走 agy，其余走 pi）。
// 用法: spawn-subagent <profile> <slug> -- <task> | batch | resume | close | list | ps | --check | -h
import { execFileSync, execSync } from "node:child_process";
import { randomUUID } from "node:crypto";
import {
  existsSync, lstatSync, mkdirSync, readdirSync, readFileSync,
  readlinkSync, renameSync, rmSync, symlinkSync, unlinkSync, writeFileSync,
} from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const selfPath = fileURLToPath(import.meta.url);
const scriptDir = dirname(selfPath);
const agentsDir = join(homedir(), ".pi", "agent", "agents");
const config = JSON.parse(readFileSync(join(scriptDir, "subagent-config.json"), "utf8"));
const subHome = join(homedir(), ".pi", "agent-subagent");
// hc 与 kitty 直接 exec pi，不经 shell，用不上主窗口 pi 别名里的 sec-run：hc run 继承的守护进程环境、
// kitty --copy-env 复制的窗口环境里都没有 provider 凭据。每次派发现场解析，不依赖调用者可能过期的环境
const PI_CMD = ["sec-run", "pi"];

type RunnerKind = "pi" | "agy";
type Agent = {
  name: string; runner: RunnerKind; model: string; cliModel: string; thinking: string; tools: string;
  exclude: string[]; description: string; body: string;
};
type Resolved = { agent: Agent } | { error: string };

// ---------- 解析 ----------

// md 的 frontmatter 不是合法 YAML、缺 tools 或缺 role 即视为无法解析；
// model/thinking 只来自 config.yml，没有静态兜底。cfg 由调用方传入，避免每个 profile 重读 config.yml。
function resolveAgent(profile: string, cfg: ModelConfig = loadModelConfig()): Resolved {
  const mdName = existsSync(agentsDir)
    ? readdirSync(agentsDir).find((f) => basename(f, ".md").toLowerCase() === profile.toLowerCase())
    : undefined;
  if (!mdName) return { error: "agents 目录无对应 md" };
  // 文件名大小写不敏感匹配；override 按 config.yml 里的精确键查，所以统一用 md 的规范名
  const name = basename(mdName, ".md");
  const text = readFileSync(join(agentsDir, mdName), "utf8");
  const block = text.match(/^---\n([\s\S]*?)\n---/);
  if (!block) return { error: "md 缺少 frontmatter" };
  let f: Record<string, unknown>;
  try {
    f = Bun.YAML.parse(block[1]) ?? {};
  } catch (e: any) {
    return { error: `md frontmatter 不是合法 YAML（${e.message}）` };
  }
  // YAML 值可能是对象、数组、数字等：只收字符串（tools 另收字符串数组，逗号连接），
  // 类型不对按字段报错，避免 String() 把对象静默转成 "[object Object]" 或抛 TypeError
  const s: Record<string, string> = {};
  for (const key of ["description", "role", "tools"]) {
    const v = f[key] ?? "";
    if (typeof v === "string") s[key] = v;
    else if (key === "tools" && Array.isArray(v) && v.every((x) => typeof x === "string")) s[key] = v.join(",");
    else return { error: `md 的 ${key} 字段必须是${key === "tools" ? "字符串或字符串数组" : "字符串"}` };
  }
  if (!s.tools) return { error: "md 缺少 tools 字段" };
  if (!s.role) return { error: "md 缺少 role 字段（请先重新生成 agents：just hm）" };
  const resolved = resolveModel(name, cfg, s.role);
  if ("error" in resolved) return resolved;
  // 插件排除全局统一：所有子代理共用一份派生 settings.json，per-md 无法生效
  return {
    agent: {
      name, runner: resolved.runner, model: resolved.model, cliModel: resolved.cliModel,
      thinking: resolved.thinking, tools: s.tools,
      exclude: (config.exclude ?? []) as string[], description: s.description,
      body: text.replace(/^---\n[\s\S]*?\n---\n?/, "").trim(),
    },
  };
}

// ---------- config.yml 热加载 ----------
// 角色对应的模型只在这里读：md 只写 role，改 config.yml 立即生效，不需要重新 build。
// 文件缺失或 YAML 坏了直接抛错，调用方在派发前报出原因，不回退任何静态值。

const ompConfigPath = join(homedir(), ".omp", "agent", "config.yml");
const LEVEL = /:(off|minimal|low|medium|high|xhigh|max)$/;

type ModelConfig = { roles: Record<string, string>; overrides: Record<string, string> };

function loadModelConfig(): ModelConfig {
  if (!existsSync(ompConfigPath)) {
    throw new Error(`模型配置不存在: ${ompConfigPath}（model/thinking 只读此文件，无静态兜底）`);
  }
  let doc: any;
  try {
    doc = Bun.YAML.parse(readFileSync(ompConfigPath, "utf8"));
  } catch (e: any) {
    throw new Error(`模型配置不是合法 YAML: ${ompConfigPath}（${e.message}）`);
  }
  if (!doc || typeof doc !== "object") throw new Error(`模型配置内容无效: ${ompConfigPath}`);
  return {
    roles: doc.modelRoles && typeof doc.modelRoles === "object" ? doc.modelRoles : {},
    overrides: doc.task?.agentModelOverrides && typeof doc.task.agentModelOverrides === "object"
      ? doc.task.agentModelOverrides
      : {},
  };
}

// "provider/model:level" 或 "@role[:level]" -> { model, thinking }
function resolveSpec(
  spec: string,
  roles: Record<string, string>,
  seen: string[] = [],
): { model: string; thinking: string } | null {
  const m = spec.match(LEVEL);
  const level = m ? m[1] : null;
  const ref = m ? spec.slice(0, m.index) : spec;
  if (ref.startsWith("@")) {
    const role = ref.slice(1);
    // 角色引用成环: 无法解析。
    if (seen.includes(role)) return null;
    const next = roles[role];
    if (typeof next !== "string") return null;
    const base = resolveSpec(next, roles, [...seen, role]);
    return base ? { model: base.model, thinking: level ?? base.thinking } : null;
  }
  if (!ref.includes("/")) return null;
  return { model: ref, thinking: level ?? "" };
}

// omp 的 "provider/model" -> pi 的 provider 名
function toPiModel(model: string): string {
  const alias: Record<string, string> = config.providerAlias ?? {};
  const i = model.indexOf("/");
  if (i < 0) return model;
  return (alias[model.slice(0, i)] ?? model.slice(0, i)) + model.slice(i);
}

const AGY_ALIASES: Record<string, string> = {
  carbon: "gemini-4-carbon",
  argon: "gemini-4-argon",
  hydrogen: "gemini-4-hydrogen",
  flash: "gemini-3.8-flash",
  pro: "gemini-3.1-pro",
};
const AGY_FAMILY_EFFORTS: Record<string, string[]> = {
  "gemini-4-carbon": ["low", "medium", "high"],
  "gemini-4-argon": ["low", "medium", "high"],
  "gemini-4-hydrogen": ["low", "medium", "high", "xhigh"],
  "gemini-3.8-flash": ["low", "medium", "high"],
  "gemini-3.1-pro": ["low", "high"],
};
const AGY_FIXED_MODELS = new Set([
  "claude-sonnet-4-6",
  "claude-opus-4-6-thinking",
  "gemini-pro-orchestrator",
  "gemini-pro-orchestrator-argon",
]);
const AGY_VALID_EFFORTS = new Set(["low", "medium", "high", "xhigh"]);

// agy --model 只接受拼好 effort 后缀的 ID（裸家族名会被 agy 直接拒掉）
function resolveAgyModel(raw: string, thinking: string): { cliModel: string } | { error: string } {
  if (!raw) return { error: "agy 模型名不能为空" };
  const name = AGY_ALIASES[raw] ?? raw;
  if (AGY_FIXED_MODELS.has(name) || /-(low|medium|high|xhigh|thinking)$/.test(name)) {
    return { cliModel: name };
  }
  const allowed = AGY_FAMILY_EFFORTS[name];
  if (allowed) {
    if (!allowed.includes(thinking)) {
      return { error: `agy 模型 '${name}' 不支持档位 '${thinking}'（可选: ${allowed.join("|")}）` };
    }
    return { cliModel: `${name}-${thinking}` };
  }
  if (!AGY_VALID_EFFORTS.has(thinking)) {
    return { error: `agy 不支持 thinking 档位 '${thinking}'（可选: low|medium|high|xhigh）` };
  }
  return { cliModel: `${name}-${thinking}` };
}

function resolveModel(
  profile: string,
  cfg: ModelConfig,
  role: string,
): { runner: RunnerKind; model: string; cliModel: string; thinking: string } | { error: string } {
  const spec = cfg.overrides[profile] ?? `@${role}`;
  const resolved = resolveSpec(spec, cfg.roles);
  if (!resolved) {
    return { error: `config.yml 无法解析 '${spec}'（role '${role}' 不在 modelRoles、引用成环或缺 provider/model）` };
  }
  // pi 与 agy 都需要 thinking 档位；角色没写 level 时报错，避免传出残缺模型规格。
  if (!resolved.thinking) return { error: `config.yml 的 '${spec}' 没有 thinking 档位` };
  if (resolved.model.startsWith("agy/")) {
    const agy = resolveAgyModel(resolved.model.slice(4), resolved.thinking);
    if ("error" in agy) return agy;
    return { runner: "agy", model: `agy/${agy.cliModel}`, cliModel: agy.cliModel, thinking: resolved.thinking };
  }
  const piModel = toPiModel(resolved.model);
  return { runner: "pi", model: piModel, cliModel: piModel, thinking: resolved.thinking };
}

