const displayModel = (g: Agent) => (g.runner === "agy" ? `agy/${g.model}` : g.model);

function listAgents(opts: { verbose?: boolean; json?: boolean } = {}) {
  if (!existsSync(agentsDir)) return console.error(`agents 目录不存在: ${agentsDir}`);
  let cfg: ModelConfig;
  try {
    cfg = loadModelConfig();
  } catch (e: any) {
    console.error(`spawn-subagent: ${e.message}`);
    process.exit(1);
  }
  const mdNames = readdirSync(agentsDir).filter((x) => x.endsWith(".md")).map((x) => basename(x, ".md"));
  const names = [...new Set([...mdNames, ...Object.keys(agyProfiles)])].sort();
  const rows = names.map((name) => ({ name, r: resolveAgent(name, cfg) }));
  const access = (tools: string) => (canEdit(tools) ? "rw" : "ro");

  if (opts.json) {
    console.log(JSON.stringify(rows.map(({ name, r }) => "error" in r
      ? { name, error: r.error }
      : {
        name, runner: r.agent.runner, access: access(r.agent.tools), model: displayModel(r.agent), thinking: r.agent.thinking,
        tools: r.agent.tools.split(","), description: r.agent.description,
      }), null, 2));
    return;
  }

  const ok = rows.flatMap(({ r }) => ("agent" in r ? [r.agent] : []));
  const w = (pick: (g: Agent) => string, head: string) => Math.max(head.length, ...ok.map((g) => pick(g).length));
  const wName = Math.max(4, ...rows.map((x) => x.name.length));
  const wModel = w(displayModel, "MODEL");
  const line = (...c: string[]) => `${c[0].padEnd(wName)}  ${c[1].padEnd(6)}  ${c[2].padEnd(wModel)}  ${c[3]}`;
  console.log(line("NAME", "ACCESS", "MODEL", "THINK"));
  for (const { name, r } of rows) {
    if ("error" in r) console.log(`${name.padEnd(wName)}  <无法解析: ${r.error}>`);
    else {
      const g = r.agent;
      console.log(line(g.name, access(g.tools), displayModel(g), g.thinking));
    }
    if (opts.verbose && "agent" in r) console.log(`  ${r.agent.description}`);
  }
  console.log(`${rows.length} agents`);
}

function prepareEnv(exclude: string[]) {
  const main = join(homedir(), ".pi", "agent");
  const sub = join(homedir(), ".pi", "agent-subagent");
  mkdirSync(join(sub, "sessions"), { recursive: true });
  mkdirSync(join(sub, "tmp"), { recursive: true });
  const own = ["settings.json", "sessions", "tmp"];
  const linked = readdirSync(main).filter((ent) => !own.includes(ent));
  for (const ent of linked) {
    const src = join(main, ent), dst = join(sub, ent);
    let cur: string | null = null;
    try { cur = readlinkSync(dst); } catch { /* dst 不存在或不是软链 */ }
    if (cur === src) continue;
    rmSync(dst, { recursive: true, force: true });
    symlinkSync(src, dst, lstatSync(src).isDirectory() ? "dir" : "file");
  }
  for (const ent of readdirSync(sub)) {
    if (own.includes(ent) || linked.includes(ent)) continue;
    const dst = join(sub, ent);
    if (!lstatSync(dst).isSymbolicLink()) continue;
    const target = resolve(sub, readlinkSync(dst));
    if (target === join(main, ent) && !existsSync(target)) unlinkSync(dst);
  }
  const pkgName = (p: any): string | null => {
    if (p && typeof p === "object") p = p.source;
    if (typeof p !== "string" || !p) return null;
    const s = p.replace(/^-/, "");
    const bare = s.includes(":") && !s.startsWith("/") ? s.split(":").slice(1).join(":") : s;
    return bare.split("/").filter(Boolean).at(-1)?.split("@")[0] ?? null;
  };
  const settings = JSON.parse(readFileSync(join(main, "settings.json"), "utf8"));
  settings.packages = settings.packages.map((p: any) => {
    const name = pkgName(p);
    if (name && exclude.includes(name)) {
      if (p && typeof p === "object") {
        const src = String(p.source);
        return src.startsWith("-") ? p : { ...p, source: "-" + src };
      }
      if (typeof p === "string" && !p.startsWith("-")) return "-" + p;
    }
    return p;
  });
  const file = join(sub, "settings.json");
  const next = JSON.stringify(settings, null, 2) + "\n";
  if (existsSync(file) && readFileSync(file, "utf8") === next) return;
  const tmp = `${file}.${process.pid}.tmp`;
  writeFileSync(tmp, next);
  renameSync(tmp, file);
}

function layoutPane(mainPane: string): string {
  const layout = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
  const mainX = layout.panes.find((p: any) => p.pane_id === mainPane).rect.x;
  const right = layout.panes
    .filter((p: any) => p.rect.x > mainX)
    .sort((a: any, b: any) => a.rect.y - b.rect.y);
  const target = right.at(-1)?.pane_id;
  const newPane = target
    ? herdr(["pane", "split", "--pane", target, "--direction", "down", "--ratio", "0.5", "--no-focus"]).result.pane.pane_id
    : herdr(["pane", "split", "--pane", mainPane, "--direction", "right", "--ratio", "0.55", "--no-focus"]).result.pane.pane_id;
  for (let i = 0; i < 6; i++) {
    const l = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
    const panes = l.panes
      .filter((p: any) => p.rect.x === l.panes.find((q: any) => q.pane_id === newPane).rect.x)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    const n = panes.length;
    if (n < 2) break;
    const colX = l.panes.find((q: any) => q.pane_id === newPane).rect.x;
    const splits = l.splits
      .filter((s: any) => s.direction === "down" && Math.abs((s.rect?.x ?? -1) - colX) < 1)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    let changed = false;
    for (let k = n - 2; k >= 0; k--) {
      const cur = splits[k].ratio, want = 1 / (n - k);
      const delta = Math.round((want - cur) * 1e6) / 1e6;
      if (delta === 0) continue;
      const dir = delta > 0 ? "down" : "up";
      const pane = delta > 0 ? panes[k] : panes[k + 1];
      herdr(["pane", "resize", "--pane", pane.pane_id, "--direction", dir, "--amount", String(Math.abs(delta))]);
      changed = true;
    }
    if (!changed) break;
  }
  return newPane;
}

function writeAgentBody(name: string, body: string): string | undefined {
  if (!body) return undefined;
  const dir = join(subHome, "tmp", "agent-prompts");
  mkdirSync(dir, { recursive: true });
  const file = join(dir, `${name}.md`);
  writeFileSync(file, body + "\n");
  return file;
}

type Launch = {
  kind: Runner;
  env: Record<string, string>;
  cmd: string[];
  args: string[];
  promptArgs: (prompt: string) => string[];
  observe: () => HealthObservation;
  onHealthy?: () => void;
};

const canEdit = (tools: string) => /(^|,)(edit|write)(,|$)/.test(tools);
const envPairs = (env: Record<string, string>) => Object.entries(env).map(([k, v]) => `${k}=${v}`);

function piLaunch(g: Agent, promptFile?: string): Launch {
  const sessionId = randomUUID();
  const locate = sessionLocator(sessionId);
  return {
    kind: "pi", env: { PI_CODING_AGENT_DIR: subHome }, cmd: PI_CMD,
    args: [
      "--session-id", sessionId, "--model", g.model, "--thinking", g.thinking, "--tools", g.tools,
      ...(promptFile ? ["--append-system-prompt", promptFile] : []),
    ],
    promptArgs: (p) => ["--", p],
    observe: () => {
      const f = locate();
      return f && existsSync(f) ? observeHealth(readFileSync(f, "utf8")) : { status: "none" };
    },
  };
}

function agyLaunch(g: Agent, agentName: string, intercom: string, promptFile?: string): Launch {
  const runDir = join(subHome, "tmp", "agy", agentName);
  mkdirSync(runDir, { recursive: true });
  const meta: AgyMeta = { agentName, profile: g.name, intercom, readOnly: !canEdit(g.tools), promptFile };
  writeFileSync(join(runDir, "meta.json"), JSON.stringify(meta));
  return {
    kind: "agy", env: { [AGY_RUN_ENV]: runDir }, cmd: ["agy"],
    args: ["--model", g.model, "--dangerously-skip-permissions"],
    promptArgs: (p) => ["-i", p],
    observe: () => observeAgy(runDir),
    onHealthy: () => writeFileSync(join(runDir, "gated"), ""),
  };
}

type Term = {
  validate(): void;
  start(o: { agentName: string; profile: string; slug: string; launch: Launch; prompt: string }): { pane: string; alive?: () => boolean };
  send(pane: string, text: string): boolean;
  close(pane: string): void;
  focusMain?(): void;
};

function herdrPrompt(pane: string, prompt: string): boolean {
  for (let i = 0; i < 20; i++) {
    try {
      const out = execFileSync("herdr", ["agent", "prompt", pane, prompt], { encoding: "utf8" });
      if (out.includes('"type":"agent_prompted"')) return true;
    } catch { /* 未就绪或 pane 已关闭, 重试 */ }
    execSync("sleep 2");
  }
  return false;
}

// split 后立刻 agent start，新 pane 的 shell 还在跑 .zshrc 启动子进程，start 返回结构化
// agent_pane_busy（herdr#2773/#3208），--timeout 不覆盖这个前置检查。pane get/list 没有就绪
// 字段（agent_status 恒为 unknown），唯一权威信号是 start 自身的 agent_pane_busy；
// 再用 pane process-info 的 shell_pid 确认 pane 里仍是活着的 shell，在固定期限内重试。
const HERDR_START_READY_MS = 10_000;

function paneShellAlive(pane: string): boolean | undefined {
  try {
    const shellPid = herdr(["pane", "process-info", "--pane", pane]).result.process_info?.shell_pid;
    return typeof shellPid === "number" && shellPid > 0;
  } catch { return undefined; }
}

function herdrAgentStart(agentName: string, newPane: string, kind: Runner, args: string[]): any {
  const deadline = Date.now() + HERDR_START_READY_MS;
  for (;;) {
    try {
      return herdr(["agent", "start", agentName, "--kind", kind, "--pane", newPane, "--", ...args]);
    } catch (e: any) {
      let code: string | undefined;
      try { code = JSON.parse(String(e.stderr || e.stdout || ""))?.error?.code; } catch { /* 非结构化错误 */ }
      if (code !== "agent_pane_busy" || Date.now() >= deadline || paneShellAlive(newPane) === false) throw e;
      execSync("sleep 0.25");
    }
  }
}

const herdrTerm: Term = {
  validate() {
    const pane = process.env.HERDR_PANE_ID!;
    try { herdr(["pane", "get", pane]); } catch (e: any) {
      throw new Error(`HERDR_PANE_ID='${pane}' 对应的旧 Herdr pane 不存在或不可用（${cliError(e)}）`);
    }
  },
  start({ agentName, launch, prompt }) {
    const newPane = layoutPane(process.env.HERDR_PANE_ID!);
    const closeNew = () => { try { execFileSync("herdr", ["pane", "close", newPane]); } catch {} };
    try {
      execFileSync("herdr", ["pane", "run", newPane, `export ${envPairs(launch.env).join(" ")}`]);
      herdrAgentStart(agentName, newPane, launch.kind, launch.args);
    } catch (e: any) {
      closeNew();
      throw new Error(`启动失败: ${String(e.message ?? e)}`);
    }
    if (!herdrPrompt(newPane, prompt)) {
      closeNew();
      throw new Error("prompt 注入失败（20 次重试后 pane 未就绪）");
    }
    return { pane: newPane };
  },
  send: herdrPrompt,
  close: (pane) => { execFileSync("herdr", ["pane", "close", pane]); },
  focusMain: () => { execFileSync("herdr", ["agent", "focus", process.env.HERDR_PANE_ID!]); },
};

type KittyWindow = { id: number; lines: number; user_vars?: Record<string, string> };
type KittyTab = { layout: string; windows: KittyWindow[] };

function kitten(args: string[], input?: string): string {
  return execFileSync("kitten", ["@", ...args], { encoding: "utf8", input });
}
function kittyTabs(): KittyTab[] {
  return JSON.parse(kitten(["ls"])).flatMap((o: any) => o.tabs);
}
function kittyTabOf(main: string): KittyTab {
  const tab = kittyTabs().find((t) => t.windows.some((w) => String(w.id) === main));
  if (!tab) throw new Error(`kitty 找不到主窗口 ${main}`);
  return tab;
}
const kittyRight = (main: string) => kittyTabOf(main).windows.filter((w) => w.user_vars?.subagent === "1");

function kittyEqualize(main: string) {
  for (let i = 0; i < 6; i++) {
    const right = kittyRight(main);
    if (right.length < 2) return;
    const want = Math.floor(right.reduce((sum, w) => sum + w.lines, 0) / right.length);
    let changed = false;
    for (const w of right.slice(0, -1)) {
      const cur = kittyRight(main).find((x) => x.id === w.id)!.lines;
      const delta = want - cur;
      if (Math.abs(delta) < 2) continue;
      kitten(["resize-window", "--match", `id:${w.id}`, "--axis=vertical", "--increment", String(delta)]);
      changed = true;
    }
    if (!changed) return;
  }
}

const kittyAlive = (pane: string) => kittyTabs().some((t) => t.windows.some((w) => String(w.id) === pane));

// 会话文件定位: pi 的 --session-id 让它落盘为 <ts>_<id>.jsonl，目录名由 pi 决定，故遍历查找
function sessionLocator(sessionId: string): () => string | null {
  let found: string | null = null;
  return () => {
    if (found) return found;
    const root = join(subHome, "sessions");
    if (!existsSync(root)) return null;
    for (const d of readdirSync(root, { withFileTypes: true }).filter((e) => e.isDirectory())) {
      const f = readdirSync(join(root, d.name)).find((x) => x.endsWith(`_${sessionId}.jsonl`));
      if (f) return (found = join(root, d.name, f));
    }
    return null;
  };
}

const kittyTerm: Term = {
  validate() {
    const main = process.env.KITTY_WINDOW_ID!;
    let layout: string;
    try { layout = kittyTabOf(main).layout; } catch (e: any) {
      throw new Error(`KITTY_WINDOW_ID='${main}' 不可用（${cliError(e)}）`);
    }
    if (layout !== "splits") throw new Error(`kitty 当前 tab 布局为 '${layout}'，需要 splits`);
  },
  start({ launch, prompt }) {
    const main = process.env.KITTY_WINDOW_ID!;
    const anchor = kittyRight(main).at(-1)?.id;
    const placement = anchor
      ? ["--location=hsplit", "--bias=50", "--next-to", `id:${anchor}`]
      : ["--location=vsplit", "--bias=45", "--next-to", `id:${main}`];
    let pane: string;
    try {
      pane = kitten([
        "launch", "--match", `window_id:${main}`, "--copy-env", "--keep-focus",
        "--cwd", process.cwd(), "--var", "subagent=1", ...envPairs(launch.env).flatMap((p) => ["--env", p]),
        ...placement, "--", ...launch.cmd, ...launch.args, ...launch.promptArgs(prompt),
      ]).trim();
    } catch (e: any) {
      throw new Error(`启动失败: ${String(e.message ?? e)}`);
    }
    try {
      kittyEqualize(main);
    } catch (e: any) {
      try { kitten(["close-window", "--match", `id:${pane}`]); } catch {}
      throw new Error(`布局调整失败: ${String(e.message ?? e)}`);
    }
    return { pane, alive: () => kittyAlive(pane) };
  },
  send(pane, text) {
    if (!kittyAlive(pane)) return false;
    kitten(["send-text", "--match", `id:${pane}`, "--bracketed-paste=enable", "--stdin"], text);
    execSync("sleep 1");
    kitten(["send-key", "--match", `id:${pane}`, "enter"]);
    return true;
  },
  close: (pane) => { kitten(["close-window", "--match", `id:${pane}`]); },
};

const hcOut = (args: string[]): any => JSON.parse(execFileSync("hc", args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }));

function hcGet(id: string): any | null {
  try { return hcOut(["get", "--json", id]); } catch (e: any) {
    if (e.status === 3) return null;
    throw e;
  }
}

const HC_SPAWN_LABEL = "spawned-by=spawn-subagent";

type HcSubagent = { id: string; name: string; profile: string; slug: string; state: "running" | "finished"; ageMs: number };

function hcSubagents(): HcSubagent[] {
  const { terminals } = hcOut(["ls", "--all", "--json", "--label", HC_SPAWN_LABEL]);
  const now = Date.now();
  return terminals.flatMap((x: any) => {
    const t = hcGet(x.address);
    if (!t || t.parent !== process.env.HC_TERMINAL_ID) return [];
    return [{
      id: t.address, name: t.name, profile: t.labels?.profile ?? "-", slug: t.labels?.slug ?? "-",
      state: t.state === "live" ? "running" : "finished", ageMs: now - t.created_ms,
    }];
  });
}

// hc send 是“粘贴并回车”，传错 ID 指到非子代理终端（如用户的 shell）会把任务文本当命令执行，
// 所以 send/close 都只允许操作当前终端自己启动的子终端
function requireHcChild(pane: string) {
  const t = hcGet(pane);
  if (!t) throw new Error(`终端 ${pane} 不存在`);
  if (t.parent !== process.env.HC_TERMINAL_ID) throw new Error(`终端 ${pane} 不是当前终端启动的子终端`);
}

const hcTerm: Term = {
  validate() {
    const id = process.env.HC_TERMINAL_ID!;
    let t: any;
    try { t = hcGet(id); } catch (e: any) {
      throw new Error(`HC_TERMINAL_ID='${id}' 无法查询（${cliError(e)}）`);
    }
    if (!t) throw new Error(`HC_TERMINAL_ID='${id}' 不存在`);
    if (t.state !== "live") throw new Error(`HC_TERMINAL_ID='${id}' 已结束`);
  },
  start({ agentName, profile, slug, launch, prompt }) {
    let pane: string;
    try {
      const out = hcOut([
        "run", "--bg", "--json", "--name", agentName, "--parent", process.env.HC_TERMINAL_ID!, "--cwd", process.cwd(),
        "--label", HC_SPAWN_LABEL, "--label", `profile=${profile}`, "--label", `slug=${slug}`,
        "env", ...envPairs(launch.env), `PATH=${process.env.PATH}`,
        ...launch.cmd, ...launch.args, ...launch.promptArgs(prompt),
      ]);
      if (typeof out?.address !== "string") throw new Error("hc run 未返回 address");
      pane = out.address;
    } catch (e: any) {
      throw new Error(`启动失败: ${cliError(e)}`);
    }
    return { pane, alive: () => { try { return hcGet(pane)?.state === "live"; } catch { return true; } } };
  },
  send(pane, text) {
    requireHcChild(pane);
    try { execFileSync("hc", ["send", "--json", pane, text], { stdio: "ignore" }); return true; } catch { return false; }
  },
  close(pane) {
    requireHcChild(pane);
    execFileSync("hc", ["kill", "--json", pane], { stdio: "ignore" });
    execFileSync("hc", ["rm", "--json", pane], { stdio: "ignore" });
  },
};

function cliError(e: any): string {
  try { return JSON.parse(String(e.stderr || e.stdout || ""))?.error?.message ?? String(e.message ?? e); } catch {
    return String(e.stderr || e.message || e).trim();
  }
}

// HC_TERMINAL_ID 优先（Herdr.app 内可能残留已失效的旧 HERDR_PANE_ID），其次旧 Herdr（可能运行在 kitty 内），最后 Kitty
function getTerm(): Term {
  if (process.env.HC_TERMINAL_ID) return hcTerm;
  if (process.env.HERDR_PANE_ID) return herdrTerm;
  if (process.env.KITTY_WINDOW_ID) return kittyTerm;
  throw new Error("需要在 Herdr.app（HC_TERMINAL_ID）、旧 Herdr（HERDR_PANE_ID）或 Kitty（KITTY_WINDOW_ID）中运行");
}
function termOrExit(): Term {
  try { return getTerm(); } catch (e: any) {
    console.error(`spawn-subagent: context-error: ${e.message}`);
    process.exit(1);
  }
}

type Context = { term: Term; intercom: string };
function requireContext(): Context {
  const term = termOrExit();
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!intercom) {
    console.error("spawn-subagent: context-error: 需要 PI_INTERCOM_SESSION_ID");
    process.exit(1);
  }
  try { term.validate(); } catch (e: any) {
    console.error(`spawn-subagent: context-error: ${e.message}`);
    process.exit(1);
  }
  return { term, intercom };
}

function resume(paneId: string, task: string) {
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!intercom) {
    console.error("spawn-subagent: resume 需要 PI_INTERCOM_SESSION_ID");
    process.exit(1);
  }
  const prompt = `（会话延续）新任务，完成后按首条任务的回传协议向主代理（session ${intercom}）回报结论:\n---\n${task}`;
  let sent: boolean;
  try { sent = termOrExit().send(paneId, prompt); } catch (e: any) {
    console.error(`spawn-subagent: resume 被拒绝（${cliError(e)}）: ${paneId}`);
    process.exit(1);
  }
  if (!sent) {
    console.error(`spawn-subagent: resume 注入失败（pane '${paneId}' 未就绪或已关闭）`);
    process.exit(1);
  }
  console.log(paneId);
}

function requireHcOrExit(cmd: string): void {
  if (termOrExit() !== hcTerm) {
    console.error(`spawn-subagent: ${cmd} 仅支持 Herdr.app(hc)`);
    process.exit(1);
  }
}

function formatAge(ms: number): string {
  const s = Math.floor(ms / 1000);
  if (s < 60) return `${s}s`;
  if (s < 3600) return `${Math.floor(s / 60)}m`;
  if (s < 86400) return `${Math.floor(s / 3600)}h`;
  return `${Math.floor(s / 86400)}d`;
}

function psAgents(json: boolean) {
  requireHcOrExit("ps");
  const agents = hcSubagents();
  const running = agents.filter((a) => a.state === "running").length;
  if (json) {
    console.log(JSON.stringify(agents.map((a) => ({
      id: a.id, name: a.name, profile: a.profile, slug: a.slug, state: a.state, ageSeconds: Math.floor(a.ageMs / 1000),
    })), null, 2));
    return;
  }
  const wId = Math.max(2, ...agents.map((a) => a.id.length));
  const wProfile = Math.max(7, ...agents.map((a) => a.profile.length));
  const wSlug = Math.max(4, ...agents.map((a) => a.slug.length));
  const line = (...c: string[]) => `${c[0].padEnd(wId)}  ${c[1].padEnd(wProfile)}  ${c[2].padEnd(wSlug)}  ${c[3].padEnd(8)}  ${c[4]}`;
  console.log(line("ID", "PROFILE", "SLUG", "STATE", "AGE"));
  for (const a of agents) console.log(line(a.id, a.profile, a.slug, a.state, formatAge(a.ageMs)));
  console.log(`${running} running, ${agents.length - running} finished`);
}

function closeAgents(scope: "finished" | "all") {
  requireHcOrExit(`close --${scope}`);
  const targets = hcSubagents().filter((a) => scope === "all" || a.state === "finished");
  let failed = 0;
  for (const a of targets) {
    try {
      hcTerm.close(a.id);
      console.log(`closed ${a.id} (${a.profile}, ${a.slug}, ${a.state})`);
    } catch (e: any) {
      failed++;
      console.error(`spawn-subagent: 关闭失败（${cliError(e)}）: ${a.id}`);
    }
  }
  console.log(`${targets.length - failed} closed`);
  if (failed) process.exit(1);
}

function sleep(ms: number) {
  return new Promise((r) => setTimeout(r, ms));
}

type SessionEvent = {
  type?: string;
  message?: { role?: string; stopReason?: string; errorMessage?: string };
};
type HealthObservation = { status: "none" | "healthy" | "error"; reason?: string; final?: boolean };

function observeHealth(text: string): HealthObservation {
  let reason = "";
  for (const line of text.trim().split("\n")) {
    let event: SessionEvent;
    try { event = JSON.parse(line); } catch { continue; }
    const message = event.type === "message" ? event.message : null;
    if (message?.role !== "assistant") continue;
    if (message.stopReason !== "error") return { status: "healthy" };
    reason = message.errorMessage || "model error";
  }
  return reason ? { status: "error", reason } : { status: "none" };
}

function checkHealthParser() {
  const msg = (stopReason: string, errorMessage?: string) => JSON.stringify({ type: "message", message: { role: "assistant", stopReason, errorMessage } });
  if (observeHealth(msg("stop")).status !== "healthy") throw new Error("健康签名自检失败");
  if (observeHealth(`${msg("error", "503")}\n${msg("toolUse")}`).status !== "healthy") throw new Error("恢复签名自检失败");
  if (observeHealth(msg("error", "404")).status !== "error") throw new Error("失效签名自检失败");
}

const CONFIG_ERROR = /(?<![a-z0-9])(?:400|401|403|404|429)(?![a-z0-9])|(?<![a-z])(?:un)?auth(?:entic[a-z]*|oriz[a-z]*)?(?![a-z])|(?<![a-z])(?:forbidden|not_found|resource_exhausted)/i;

async function healthGate(
  observe: () => HealthObservation,
  alive: (() => boolean) | undefined,
  timeoutMs: number,
): Promise<{ healthy: boolean; reason?: string } | null> {
  const deadline = Date.now() + timeoutMs;
  let lastErrorText = "";
  while (Date.now() < deadline) {
    const observation = observe();
    if (observation.status === "healthy") return { healthy: true };
    if (observation.status === "error") {
      lastErrorText = observation.reason ?? "model error";
      if (observation.final || CONFIG_ERROR.test(lastErrorText)) {
        return { healthy: false, reason: lastErrorText };
      }
    }
    if (alive && !alive()) {
      return { healthy: false, reason: lastErrorText || "pane exited before model response" };
    }
    await sleep(1000);
  }
  return lastErrorText ? { healthy: false, reason: lastErrorText } : null;
}

const AGY_RUN_ENV = "SPAWN_SUBAGENT_AGY_RUN";
const AGY_EDIT_TOOLS = ["write_file", "edit_file"];
const intercomCli = join(homedir(), ".pi", "agent", "npm", "node_modules", "pi-intercom", "cli.ts");

type AgyMeta = { agentName: string; profile: string; intercom: string; readOnly: boolean; promptFile?: string };
type AgyRoot = { conversationId: string; transcriptPath: string };
type AgyStep = { type?: string; step_index?: number; content?: string; tool_calls?: unknown[] };

function readJson<T>(file: string): T | null {
  try { return JSON.parse(readFileSync(file, "utf8")); } catch { return null; }
}

function agySteps(transcript: string): AgyStep[] {
  if (!existsSync(transcript)) return [];
  return readFileSync(transcript, "utf8").split("\n").flatMap((line) => {
    try { return [JSON.parse(line)]; } catch { return []; }
  });
}

function agyFinalReply(steps: AgyStep[]): AgyStep | null {
  const lastUser = steps.findLastIndex((s) => s.type === "USER_INPUT");
  const last = steps.slice(lastUser + 1).findLast((s) => s.type === "PLANNER_RESPONSE");
  return last && !last.tool_calls?.length ? last : null;
}

const agyResponded = (steps: AgyStep[]) => steps.some((s) => s.type === "PLANNER_RESPONSE");

// transcript 要等首条回复完成才写入，高档位模型首轮思考常超过健康门期限且磁盘上没有流式信号。
// 额度、认证等快速失败会以 Stop 报错或进程退出出现，所以会话启动后安静超过宽限即视为健康
const AGY_QUIET_HEALTHY_MS = 20_000;

function observeAgy(runDir: string): HealthObservation {
  const rootFile = join(runDir, "root.json");
  const root = readJson<AgyRoot>(rootFile);
  const stop = readJson<{ terminationReason: string; error: string }>(join(runDir, "stop.json"));
  if (root && agyResponded(agySteps(root.transcriptPath))) return { status: "healthy" };
  if (stop) return { status: "error", final: true, reason: stop.error || `agy 在模型响应前停止（${stop.terminationReason}）` };
  if (root && Date.now() - statSync(rootFile).mtimeMs > AGY_QUIET_HEALTHY_MS) return { status: "healthy" };
  return { status: "none" };
}

function agySystemMessage(meta: AgyMeta): string {
  const body = meta.promptFile ? readFileSync(meta.promptFile, "utf8").trim() : "";
  const rules = [
    `你是 spawn-subagent 派发的子代理（profile: ${meta.profile}，agent 名: ${meta.agentName}），为另一个会话里的主代理工作。`,
    "每轮结束时，你的最终回复会被自动原样转发给主代理；不要调用任何工具回传。",
    "不派生子代理，不用 ask_question 向用户提问：缺信息或受阻时，在最终回复里写明原因与所需信息。",
    ...(meta.readOnly ? ["你是只读角色：不要修改任何文件，包括通过命令修改。"] : []),
  ];
  return `${body}\n\n## spawn-subagent 约定\n${rules.map((r) => `- ${r}`).join("\n")}`.trim();
}

function sendIntercom(meta: AgyMeta, text: string, cwd?: string) {
  const r = spawnSync(process.execPath, [
    intercomCli, "send", "--to", meta.intercom, "--name", meta.agentName, "--text", text, "--json",
  ], { encoding: "utf8", timeout: 20_000, cwd: cwd && existsSync(cwd) ? cwd : undefined });
  if (r.status !== 0) throw new Error(`intercom 投递失败: ${(r.stdout || r.stderr || String(r.error)).trim()}`);
}

function agyHookEvent(event: string, input: any, meta: AgyMeta, runDir: string): object {
  const rootFile = join(runDir, "root.json");
  if (event === "session-start") {
    try {
      writeFileSync(rootFile, JSON.stringify({ conversationId: input.conversationId, transcriptPath: input.transcriptPath }), { flag: "wx" });
    } catch (e: any) {
      if (e.code === "EEXIST") return {};
      throw e;
    }
    return { injectSteps: [{ systemMessage: { systemMessage: agySystemMessage(meta) } }] };
  }
  if (event === "pre-tool") {
    const tool = String(input.toolCall?.name ?? "");
    if (AGY_EDIT_TOOLS.includes(tool)) {
      return meta.readOnly
        ? { decision: "deny", reason: `只读 profile（${meta.profile}）不能修改文件` }
        : { decision: "allow" };
    }
    return { decision: "deny", reason: `spawn-subagent 子代理不能使用 ${tool}：不派生子代理，也不向用户提问；受阻时在最终回复中说明` };
  }
  if (event === "stop") {
    const root = readJson<AgyRoot>(rootFile);
    if (root?.conversationId !== input.conversationId) return {};
    if (input.fullyIdle === false && !input.error) return {};
    writeFileSync(join(runDir, "stop.json"), JSON.stringify({ terminationReason: input.terminationReason, error: input.error ?? "" }));
    const steps = agySteps(root.transcriptPath);
    if (!agyResponded(steps) && !existsSync(join(runDir, "gated"))) return {};
    const final = agyFinalReply(steps);
    const key = `${steps.length}`;
    const sentFile = join(runDir, "sent");
    if (existsSync(sentFile) && readFileSync(sentFile, "utf8") === key) return {};
    let body = final?.content?.trim() || `agy 已停止（${input.terminationReason}），本轮没有最终回复`;
    if (input.error) body = `agy 中断（${input.terminationReason}）: ${input.error}${final?.content ? `\n\n${final.content.trim()}` : ""}`;
    sendIntercom(meta, `[${meta.agentName}]\n${body}`, input.cwd);
    writeFileSync(sentFile, key);
  }
  return {};
}

async function agyHook(event: string) {
  const runDir = process.env[AGY_RUN_ENV] ?? "";
  let reply: object = {};
  try {
    const input = JSON.parse(await Bun.stdin.text());
    const meta = readJson<AgyMeta>(join(runDir, "meta.json"));
    if (!meta) throw new Error(`派发目录缺 meta.json: ${runDir}`);
    reply = agyHookEvent(event, input, meta, runDir);
  } catch (e: any) {
    try { appendFileSync(join(runDir, "hook.log"), `${new Date().toISOString()} ${event}: ${e.stack ?? e}\n`); } catch { /* 目录不可写 */ }
    // hook 失败时 agy 默认放行，受限工具必须显式拒绝，否则只读约束失效
    if (event === "pre-tool") reply = { decision: "deny", reason: `spawn-subagent hook 出错: ${e.message ?? e}` };
  }
  console.log(JSON.stringify(reply));
}

type DispatchResult = {
  profile: string;
  slug: string;
  pane: string;
  agentName: string;
  healthy: boolean;
  reason?: string;
};

type Launched = {
  term: Term;
  profile: string;
  slug: string;
  pane: string;
  agentName: string;
  observe: () => HealthObservation;
  onHealthy?: () => void;
  alive?: () => boolean;
};

function launchAgent({ term, intercom }: Context, profile: string, slug: string, task: string): Launched {
  const resolved = resolveAgent(profile);
  if ("error" in resolved) throw new Error(`profile '${profile}' 无法解析（${resolved.error}）`);
  const g = resolved.agent;
  if (!slug.match(/^[a-z0-9-]+$/)) throw new Error(`slug 只能含小写字母/数字/连字符: '${slug}'`);

  const ts = Date.now().toString(36);
  const p = profile.toLowerCase();
  const slugBudget = 32 - 1 - ts.length - 1 - p.length;
  let agentName: string;
  if (slugBudget >= 1) {
    agentName = `${p}-${slug.slice(0, slugBudget).replace(/-$/, "")}-${ts}`;
  } else {
    agentName = `${p.slice(0, 32 - 1 - ts.length).replace(/-$/, "")}-${ts}`;
  }
  if (agentName.length > 32) throw new Error(`无法构造 32 字符内的 agent 名（profile='${profile}' slug='${slug}'）`);

  const promptFile = writeAgentBody(p, g.body);
  let launch: Launch;
  let prompt: string;
  if (g.runner === "agy") {
    launch = agyLaunch(g, agentName, intercom, promptFile);
    prompt = `你是通过 spawn-subagent 启动的 agy 子代理（profile: ${profile}），按系统消息中的 spawn-subagent 约定工作。

任务原文:
---
${task}
---`;
  } else {
    prepareEnv(g.exclude);
    launch = piLaunch(g, promptFile);
    prompt = `你是通过 spawn-subagent 启动的 pi 子代理（profile: ${profile}）。

回传协议:
- 完成或受阻时，用 intercom 工具向主代理 session 发送一条结论消息:
  intercom({ action: "send", to: "${intercom}", message: "<结论>" })
- 结论消息第一行必须是 [${agentName}]（你的 agent 名），供主代理对账。
- 消息格式由下方任务描述，不设固定字段。
- 阻塞或失败时保留当前 pane 供主代理检查，不要自行关闭。

任务原文:
---
${task}
---`;
  }
  const { pane, alive } = term.start({ agentName, profile: p, slug, launch, prompt });
  return { term, profile, slug, pane, agentName, observe: launch.observe, onHealthy: launch.onHealthy, alive };
}

function classifyFailure(reason: string): string {
  return CONFIG_ERROR.test(reason)
    ? `config-error: ${reason}`
    : `transient: ${reason}`;
}

async function gateAgent(l: Launched, timeoutMs: number): Promise<DispatchResult> {
  const gate = await healthGate(l.observe, l.alive, timeoutMs);
  const reason = gate && !gate.healthy ? classifyFailure(gate.reason ?? "") : (gate ? undefined : "transient: health-check timeout (no model response)");
  if (reason) {
    try { l.term.close(l.pane); } catch {}
    return { profile: l.profile, slug: l.slug, pane: "-", agentName: l.agentName, healthy: false, reason };
  }
  l.onHealthy?.();
  return { profile: l.profile, slug: l.slug, pane: l.pane, agentName: l.agentName, healthy: true };
}

async function spawn(profile: string, slug: string, task: string) {
  const ctx = requireContext();
  try {
    const resolved = resolveAgent(profile);
    const configError = "agent" in resolved ? checkAgy(resolved.agent) : null;
    if (configError) {
      console.error(`spawn-subagent: config-error: ${configError}`);
      process.exit(1);
    }
    const r = await gateAgent(launchAgent(ctx, profile, slug, task), 45000);
    if (!r.healthy) {
      console.error(`spawn-subagent: 模型失效（${r.reason}）`);
      process.exit(1);
    }
    console.log(r.pane);
  } catch (e: any) {
    console.error("spawn-subagent: 启动失败:", String(e.message ?? e));
    process.exit(1);
  }
}

function composeTask(sharedTask: string, agentTask: string | undefined): string {
  if (!sharedTask) return agentTask ?? "";
  if (!agentTask) return sharedTask;
  return `${sharedTask}\n\n专项任务:\n---\n${agentTask}`;
}

function checkTaskComposition() {
  if (composeTask("共享背景", "专项分工") !== "共享背景\n\n专项任务:\n---\n专项分工") {
    throw new Error("任务组合自检失败: 共享背景与专项任务未正确组合");
  }
  if (composeTask("共享背景", undefined) !== "共享背景") {
    throw new Error("任务组合自检失败: 仅共享任务时内容发生变化");
  }
  if (composeTask("", "专项分工") !== "专项分工") {
    throw new Error("任务组合自检失败: 仅专项任务时内容发生变化");
  }
}

// json: stdout 只输出一个 JSON 数组，进度与逐行结果走 stderr
// 退出码: 0 全部成功；1 全部失败或派发前失败；2 部分失败（健康的仍在运行，调用方不可整体重试，否则会重复派发）
async function batch(manifestPath: string, json: boolean) {
  let manifest: any;
  try {
    manifest = JSON.parse(readFileSync(manifestPath, "utf-8"));
  } catch (e: any) {
    console.error(`spawn-subagent: manifest 解析失败: ${e.message}`);
    process.exit(1);
  }
  const sharedTask = manifest.task ?? "";
  const rawAgents = manifest.agents;
  if (!Array.isArray(rawAgents) || rawAgents.length === 0) {
    console.error("spawn-subagent: manifest 需要非空 agents 数组");
    process.exit(1);
  }

  const entries: { profile: string; slug: string; task: string }[] = [];
  const errors: string[] = [];
  let cfg: ModelConfig;
  try {
    cfg = loadModelConfig();
  } catch (e: any) {
    console.error(`spawn-subagent: ${e.message}（未派发任何 agent）`);
    process.exit(1);
  }
  for (const a of rawAgents) {
    const profile = typeof a === "string" ? a : a?.profile;
    if (!profile) { errors.push("缺少 profile"); continue; }
    const slugRaw = typeof a === "string" ? undefined : a?.slug;
    const task = typeof a === "string" ? composeTask(sharedTask, undefined) : composeTask(sharedTask, a?.task);
    const slug = slugRaw ?? profile.replace(/^reviewer-/i, "").replace(/[^a-z0-9-]/gi, "-");
    const resolved = resolveAgent(profile, cfg);
    if ("error" in resolved) errors.push(`profile '${profile}' 无效（${resolved.error}）`);
    else {
      try {
        const configError = checkAgy(resolved.agent);
        if (configError) errors.push(configError);
      } catch (e: any) {
        errors.push(e.message);
      }
    }
    if (!slug.match(/^[a-z0-9-]+$/)) errors.push(`slug '${slug}' 只能含小写/数字/连字符`);
    if (!task.trim()) errors.push(`profile '${profile}' 的 task 为空`);
    entries.push({ profile, slug, task });
  }
  if (errors.length) {
    console.error(`spawn-subagent: manifest 校验失败（未派发任何 agent）:`);
    for (const err of errors) console.error(`  - ${err}`);
    process.exit(1);
  }

  const ctx = requireContext();

  const progress = json ? console.error : console.log;
  progress(`spawn-subagent: 派发 ${entries.length} 个 agent...`);
  const launched: { entry: { profile: string; slug: string; task: string }; result: Launched | null; error?: string }[] = [];
  for (const entry of entries) {
    try {
      launched.push({ entry, result: launchAgent(ctx, entry.profile, entry.slug, entry.task) });
    } catch (e: any) {
      launched.push({ entry, result: null, error: String(e.message ?? e) });
    }
  }
  const results = await Promise.all(launched.map(async ({ entry, result, error }) => {
    if (!result) return { profile: entry.profile, slug: entry.slug, pane: "-", agentName: "-", healthy: false, reason: `launch-error: ${error}` };
    return gateAgent(result, 45000);
  }));
  for (const r of results) {
    const line = `${r.profile}\t${r.slug}\t${r.pane}\t${r.healthy ? "ok" : "failed"}${r.reason ? `  (${r.reason})` : ""}`;
    (r.healthy ? progress : console.error)(line);
  }
  if (json) {
    console.log(JSON.stringify(results.map((r) => r.healthy
      ? { profile: r.profile, slug: r.slug, id: r.pane, status: "ok" }
      : { profile: r.profile, slug: r.slug, id: null, status: "failed", reason: r.reason }), null, 2));
  }
  const failed = results.filter((r) => !r.healthy).length;
  process.exit(failed === 0 ? 0 : failed === results.length ? 1 : 2);
}

const [c0, c1, ...rest] = process.argv.slice(2);
if (!c0 || c0 === "-h" || c0 === "--help") {
  usage();
} else if (c0 === "batch") {
  const args = process.argv.slice(3);
  const manifest = args.find((a) => !a.startsWith("--"));
  if (!manifest) {
    console.error("spawn-subagent: batch 需要 manifest 文件路径");
    process.exit(1);
  }
  await batch(manifest, args.includes("--json"));
} else if (c0 === "list") {
  const flags = process.argv.slice(3);
  listAgents({ verbose: flags.includes("-v"), json: flags.includes("--json") });
} else if (c0 === "--check") {
  checkHealthParser();
  checkTaskComposition();
  prepareEnv(config.exclude ?? []);
  console.log("健康门签名自检通过");
  console.log(`派生 settings.json 就绪: ${join(homedir(), ".pi", "agent-subagent", "settings.json")}`);
  console.log(`全局排除 exclude(subagent-config.json 统一生效): ${JSON.stringify(config.exclude ?? [])}`);
  for (const name of Object.keys(agyProfiles)) {
    const r = resolveAgent(name);
    let err: string | null;
    try { err = "error" in r ? r.error : checkAgy(r.agent); } catch (e: any) { err = e.message; }
    console.log(err ? `agy profile ${name}: ${err}` : `agy profile ${name}: 模型 ${r.agent.model} 可用`);
  }
  console.log();
  listAgents();
} else if (c0 === "_agy-hook") {
  await agyHook(c1);
} else if (c0 === "ps") {
  psAgents(process.argv.slice(3).includes("--json"));
} else if (c0 === "close") {
  if (!c1) {
    console.error("spawn-subagent: close 需要 id、--finished 或 --all");
    process.exit(1);
  }
  if (c1 === "--finished" || c1 === "--all") {
    closeAgents(c1 === "--all" ? "all" : "finished");
  } else {
    try {
      const term = termOrExit();
      term.close(c1);
      term.focusMain?.();
      console.log(`closed ${c1}`);
    } catch (e: any) {
      console.error(`spawn-subagent: 关闭失败（${cliError(e)}）: ${c1}`);
      process.exit(1);
    }
  }
} else if (c0 === "resume") {
  const sep = process.argv.indexOf("--");
  const task = sep >= 0 ? process.argv.slice(sep + 1).join(" ") : rest.join(" ");
  if (!c1 || !task.trim()) {
    usage();
    process.exit(1);
  }
  resume(c1, task);
} else {
  const sep = process.argv.indexOf("--");
  const task = sep >= 0 ? process.argv.slice(sep + 1).join(" ") : rest.join(" ");
  if (!c1 || !task.trim()) {
    usage();
    process.exit(1);
  }
  await spawn(c0, c1, task);
}
