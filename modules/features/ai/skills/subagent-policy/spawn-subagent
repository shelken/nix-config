const accessOf = (tools: string): "rw" | "ro" => (/(^|,)(edit|write)(,|$)/.test(tools) ? "rw" : "ro");
const shellQuote = (s: string) => `'${s.replaceAll("'", "'\\''")}'`;

// opts: -v 每个 agent 下加一行缩进 description；--json 输出数组。无法解析的 md 仍占一行并说明原因
function listAgents(opts: { verbose?: boolean; json?: boolean } = {}) {
  if (!existsSync(agentsDir)) return console.error(`agents 目录不存在: ${agentsDir}`);
  let cfg: ModelConfig;
  try {
    cfg = loadModelConfig();
  } catch (e: any) {
    console.error(`spawn-subagent: ${e.message}`);
    process.exit(1);
  }
  const names = readdirSync(agentsDir).filter((x) => x.endsWith(".md")).map((x) => basename(x, ".md")).sort();
  const rows = names.map((name) => ({ name, r: resolveAgent(name, cfg) }));

  if (opts.json) {
    console.log(JSON.stringify(rows.map(({ name, r }) => "error" in r
      ? { name, error: r.error }
      : {
        name, runner: r.agent.runner, access: accessOf(r.agent.tools), model: r.agent.model, thinking: r.agent.thinking,
        tools: r.agent.tools.split(","), description: r.agent.description,
      }), null, 2));
    return;
  }

  const ok = rows.flatMap(({ r }) => ("agent" in r ? [r.agent] : []));
  const w = (pick: (g: Agent) => string, head: string) => Math.max(head.length, ...ok.map((g) => pick(g).length));
  const wName = Math.max(4, ...rows.map((x) => x.name.length));
  const wModel = w((g) => g.model, "MODEL");
  const line = (...c: string[]) => `${c[0].padEnd(wName)}  ${c[1].padEnd(6)}  ${c[2].padEnd(wModel)}  ${c[3]}`;
  console.log(line("NAME", "ACCESS", "MODEL", "THINK"));
  for (const { name, r } of rows) {
    if ("error" in r) console.log(`${name.padEnd(wName)}  <无法解析: ${r.error}>`);
    else {
      const g = r.agent;
      console.log(line(g.name, accessOf(g.tools), g.model, g.thinking));
    }
    if (opts.verbose && "agent" in r) console.log(`  ${r.agent.description}`);
  }
  console.log(`${rows.length} agents`);
}

// 子代理环境: ~/.pi/agent-subagent 只隔离 settings/sessions/tmp, 其余链接回主目录;
// packages 里命中 exclude 的包加 "-" 前缀禁用。
// 已有子代理在运行时也会再次派发，所以软链已正确就不动，settings.json 内容相同就不写、需要写时原子替换，
// 避免运行中的 pi 短暂看不到这些条目。
function prepareEnv(exclude: string[]) {
  const main = join(homedir(), ".pi", "agent");
  const sub = join(homedir(), ".pi", "agent-subagent");
  mkdirSync(join(sub, "sessions"), { recursive: true });
  mkdirSync(join(sub, "tmp"), { recursive: true });
  const own = ["settings.json", "sessions", "tmp"];
  const linked = readdirSync(main).filter((ent) => !own.includes(ent));
  for (const ent of linked) {
    const src = join(main, ent), dst = join(sub, ent);
    let cur: string | null = null;
    try { cur = readlinkSync(dst); } catch { /* dst 不存在或不是软链 */ }
    if (cur === src) continue;
    rmSync(dst, { recursive: true, force: true });
    symlinkSync(src, dst, lstatSync(src).isDirectory() ? "dir" : "file");
  }
  for (const ent of readdirSync(sub)) {
    if (own.includes(ent) || linked.includes(ent)) continue;
    const dst = join(sub, ent);
    if (!lstatSync(dst).isSymbolicLink()) continue;
    // 只清理指向主目录同名条目且已失效的软链，用户自建的软链（哪怕暂时悬空）一律保留
    const target = resolve(sub, readlinkSync(dst));
    if (target === join(main, ent) && !existsSync(target)) unlinkSync(dst);
  }
  const pkgName = (p: any): string | null => {
    if (p && typeof p === "object") p = p.source;
    if (typeof p !== "string" || !p) return null;
    const s = p.replace(/^-/, "");
    const bare = s.includes(":") && !s.startsWith("/") ? s.split(":").slice(1).join(":") : s;
    return bare.split("/").filter(Boolean).at(-1)?.split("@")[0] ?? null;
  };
  const settings = JSON.parse(readFileSync(join(main, "settings.json"), "utf8"));
  settings.packages = settings.packages.map((p: any) => {
    const name = pkgName(p);
    if (name && exclude.includes(name)) {
      if (p && typeof p === "object") {
        const src = String(p.source);
        return src.startsWith("-") ? p : { ...p, source: "-" + src };
      }
      if (typeof p === "string" && !p.startsWith("-")) return "-" + p;
    }
    return p;
  });
  const file = join(sub, "settings.json");
  const next = JSON.stringify(settings, null, 2) + "\n";
  if (existsSync(file) && readFileSync(file, "utf8") === next) return;
  const tmp = `${file}.${process.pid}.tmp`;
  writeFileSync(tmp, next);
  renameSync(tmp, file);
}

// 布局: 首个右侧分列(55%), 后续右列内向下堆叠并均分等高
function layoutPane(mainPane: string): string {
  const layout = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
  const mainX = layout.panes.find((p: any) => p.pane_id === mainPane).rect.x;
  const right = layout.panes
    .filter((p: any) => p.rect.x > mainX)
    .sort((a: any, b: any) => a.rect.y - b.rect.y);
  const target = right.at(-1)?.pane_id;
  const newPane = target
    ? herdr(["pane", "split", "--pane", target, "--direction", "down", "--ratio", "0.5", "--no-focus"]).result.pane.pane_id
    : herdr(["pane", "split", "--pane", mainPane, "--direction", "right", "--ratio", "0.55", "--no-focus"]).result.pane.pane_id;
  // 均分右列: 从下往上把同列 panes 逐步调成 1/(n-i) 占比
  for (let i = 0; i < 6; i++) {
    const l = herdr(["pane", "layout", "--pane", mainPane]).result.layout;
    const panes = l.panes
      .filter((p: any) => p.rect.x === l.panes.find((q: any) => q.pane_id === newPane).rect.x)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    const n = panes.length;
    if (n < 2) break;
    const colX = l.panes.find((q: any) => q.pane_id === newPane).rect.x;
    const splits = l.splits
      .filter((s: any) => s.direction === "down" && Math.abs((s.rect?.x ?? -1) - colX) < 1)
      .sort((a: any, b: any) => a.rect.y - b.rect.y);
    let changed = false;
    for (let k = n - 2; k >= 0; k--) {
      const cur = splits[k].ratio, want = 1 / (n - k);
      const delta = Math.round((want - cur) * 1e6) / 1e6;
      if (delta === 0) continue;
      const dir = delta > 0 ? "down" : "up";
      const pane = delta > 0 ? panes[k] : panes[k + 1];
      herdr(["pane", "resize", "--pane", pane.pane_id, "--direction", dir, "--amount", String(Math.abs(delta))]);
      changed = true;
    }
    if (!changed) break;
  }
  return newPane;
}

// 正文写文件再以路径传入，避开 shell/argv 的引号与长度问题；同 profile 内容恒定，并发覆盖写无冲突
function writeAgentBody(name: string, body: string): string | undefined {
  if (!body) return undefined;
  const dir = join(subHome, "tmp", "agent-prompts");
  mkdirSync(dir, { recursive: true });
  const file = join(dir, `${name}.md`);
  writeFileSync(file, body + "\n");
  return file;
}

// ---------- 终端后端与运行器规格 ----------

type HealthObservation = { status: "none" | "healthy" | "error"; reason?: string };
type Session = {
  observe: () => HealthObservation;
  alive?: () => boolean;
  exitError?: () => string | undefined;
};

type LaunchSpec = {
  agentName: string;
  profileLower: string;
  runner: RunnerKind;
  env: Record<string, string>;
  // hc / kitty 直接 exec 携带首轮任务
  execCmd: (sessionId: string) => string[];
  // 旧 herdr 先启动就绪，再由 herdrPrompt 注入任务
  herdrArgs: string[];
  prompt: string;
  makeSession: (o: { sessionId?: string; herdrStartOut?: any; alive?: () => boolean }) => Session;
  onStarted?: (pane: string) => void;
};

type Term = {
  // 派发前验证当前终端；失效抛错，由调用方报 context-error
  validate(): void;
  start(spec: LaunchSpec): { pane: string; session: Session };
  send(pane: string, text: string): boolean;
  close(pane: string): void;
  focusMain?(): void;
};

function currentTermScope(): string {
  if (process.env.HC_TERMINAL_ID) return `hc:${process.env.HC_TERMINAL_ID}`;
  if (process.env.HERDR_PANE_ID) return "herdr";
  if (process.env.KITTY_WINDOW_ID) return "kitty";
  return "none";
}

function herdrPrompt(pane: string, prompt: string): boolean {
  for (let i = 0; i < 20; i++) {
    try {
      const out = execFileSync("herdr", ["agent", "prompt", pane, prompt], { encoding: "utf8" });
      if (out.includes('"type":"agent_prompted"')) return true;
    } catch { /* 未就绪或 pane 已关闭, 重试 */ }
    execSync("sleep 2");
  }
  return false;
}

// split 后立刻 agent start，新 pane 的 shell 还在跑 .zshrc 启动子进程，start 返回结构化
// agent_pane_busy（herdr#2773/#3208），--timeout 不覆盖这个前置检查。pane get/list 没有就绪
// 字段（agent_status 恒为 unknown），唯一权威信号是 start 自身的 agent_pane_busy；
// 再用 pane process-info 的 shell_pid 确认 pane 里仍是活着的 shell，在固定期限内重试。
const HERDR_START_READY_MS = 10_000;

function paneShellAlive(pane: string): boolean | undefined {
  try {
    const shellPid = herdr(["pane", "process-info", "--pane", pane]).result.process_info?.shell_pid;
    return typeof shellPid === "number" && shellPid > 0;
  } catch { return undefined; } // 查不到状态时不作终止依据，交给期限兜底
}

function herdrAgentStart(agentName: string, newPane: string, kind: RunnerKind, args: string[]): any {
  const deadline = Date.now() + HERDR_START_READY_MS;
  for (;;) {
    try {
      return herdr(["agent", "start", agentName, "--kind", kind, "--pane", newPane, "--", ...args]);
    } catch (e: any) {
      let code: string | undefined;
      try { code = JSON.parse(String(e.stderr || e.stdout || ""))?.error?.code; } catch { /* 非结构化错误 */ }
      if (code !== "agent_pane_busy" || Date.now() >= deadline || paneShellAlive(newPane) === false) throw e;
      execSync("sleep 0.25");
    }
  }
}

const herdrTerm: Term = {
  validate() {
    const pane = process.env.HERDR_PANE_ID!;
    try { herdr(["pane", "get", pane]); } catch (e: any) {
      throw new Error(`HERDR_PANE_ID='${pane}' 对应的旧 Herdr pane 不存在或不可用（${cliError(e)}）`);
    }
  },
  start(spec) {
    const newPane = layoutPane(process.env.HERDR_PANE_ID!);
    const closeNew = () => { try { execFileSync("herdr", ["pane", "close", newPane]); } catch { /* 已关闭 */ } };
    let session: Session;
    try {
      const exports = Object.entries(spec.env).map(([k, v]) => `${k}=${shellQuote(v)}`).join(" ");
      if (exports) execFileSync("herdr", ["pane", "run", newPane, `export ${exports}`]);
      const startOut = herdrAgentStart(spec.agentName, newPane, spec.runner, spec.herdrArgs);
      session = spec.makeSession({ herdrStartOut: startOut });
    } catch (e: any) {
      closeNew();
      throw e instanceof Error && e.message.startsWith("健康门不可用:")
        ? e
        : new Error(`启动失败: ${String(e.message ?? e)}`);
    }
    if (!herdrPrompt(newPane, spec.prompt)) {
      closeNew();
      throw new Error("prompt 注入失败（20 次重试后 pane 未就绪）");
    }
    spec.onStarted?.(newPane);
    return { pane: newPane, session };
  },
  send: herdrPrompt,
  close: (pane) => { execFileSync("herdr", ["pane", "close", pane]); },
  focusMain: () => { execFileSync("herdr", ["agent", "focus", process.env.HERDR_PANE_ID!]); },
};

type KittyWindow = { id: number; lines: number; user_vars?: Record<string, string> };
type KittyTab = { layout: string; windows: KittyWindow[] };

function kitten(args: string[], input?: string): string {
  return execFileSync("kitten", ["@", ...args], { encoding: "utf8", input });
}
function kittyTabs(): KittyTab[] {
  return JSON.parse(kitten(["ls"])).flatMap((o: any) => o.tabs);
}
function kittyTabOf(main: string): KittyTab {
  const tab = kittyTabs().find((t) => t.windows.some((w) => String(w.id) === main));
  if (!tab) throw new Error(`kitty 找不到主窗口 ${main}`);
  return tab;
}
// 子代理窗口用 user var 标记；右列 = 主窗口所在 tab 内带标记的窗口（ls 顺序即上下顺序）
const kittyRight = (main: string) => kittyTabOf(main).windows.filter((w) => w.user_vars?.subagent === "1");

// splits 是二叉树，单次 launch 无法均分；逐个把行数调到平均值（容差 1 行）
function kittyEqualize(main: string) {
  for (let i = 0; i < 6; i++) {
    const right = kittyRight(main);
    if (right.length < 2) return;
    const want = Math.floor(right.reduce((sum, w) => sum + w.lines, 0) / right.length);
    let changed = false;
    for (const w of right.slice(0, -1)) {
      const cur = kittyRight(main).find((x) => x.id === w.id)!.lines;
      const delta = want - cur;
      if (Math.abs(delta) < 2) continue;
      kitten(["resize-window", "--match", `id:${w.id}`, "--axis=vertical", "--increment", String(delta)]);
      changed = true;
    }
    if (!changed) return;
  }
}

const kittyAlive = (pane: string) => kittyTabs().some((t) => t.windows.some((w) => String(w.id) === pane));

// 会话文件定位: pi 的 --session-id 让它落盘为 <ts>_<id>.jsonl，目录名由 pi 决定，故遍历查找
function sessionLocator(sessionId: string): () => string | null {
  let found: string | null = null;
  return () => {
    if (found) return found;
    const root = join(subHome, "sessions");
    if (!existsSync(root)) return null;
    for (const d of readdirSync(root, { withFileTypes: true }).filter((e) => e.isDirectory())) {
      const f = readdirSync(join(root, d.name)).find((x) => x.endsWith(`_${sessionId}.jsonl`));
      if (f) return (found = join(root, d.name, f));
    }
    return null;
  };
}

const kittyTerm: Term = {
  validate() {
    const main = process.env.KITTY_WINDOW_ID!;
    let layout: string;
    try { layout = kittyTabOf(main).layout; } catch (e: any) {
      throw new Error(`KITTY_WINDOW_ID='${main}' 不可用（${cliError(e)}）`);
    }
    if (layout !== "splits") throw new Error(`kitty 当前 tab 布局为 '${layout}'，需要 splits`);
  },
  start(spec) {
    const main = process.env.KITTY_WINDOW_ID!;
    const anchor = kittyRight(main).at(-1)?.id;
    const placement = anchor
      ? ["--location=hsplit", "--bias=50", "--next-to", `id:${anchor}`]
      : ["--location=vsplit", "--bias=45", "--next-to", `id:${main}`];
    // OMP 的 bash 工具会注入 TERM=dumb、NO_COLOR=1、CI=true；--copy-env 会把它们带进新窗口弄坏 TUI，这里显式净化
    const envArgs = [
      "--env", "TERM=xterm-kitty",
      "--env", "COLORTERM=truecolor",
      "--env", "NO_COLOR=",
      "--env", "CI=",
      ...Object.entries(spec.env).flatMap(([k, v]) => ["--env", `${k}=${v}`]),
    ];
    let pane: string;
    try {
      // --match window_id 把窗口钉在主窗口所在 tab（否则会落进当前活动 tab）；
      // --copy-env 复制主窗口环境（API key、PATH 等），直接 exec 不经 shell，prompt 原样传入
      pane = kitten([
        "launch", "--match", `window_id:${main}`, "--copy-env", "--keep-focus",
        "--cwd", process.cwd(), "--var", "subagent=1", ...envArgs,
        ...placement, "--",
        ...spec.execCmd(spec.agentName),
      ]).trim();
    } catch (e: any) {
      throw new Error(`启动失败: ${String(e.message ?? e)}`);
    }
    try {
      kittyEqualize(main);
    } catch (e: any) {
      try { kitten(["close-window", "--match", `id:${pane}`]); } catch { /* 已关闭 */ }
      throw new Error(`布局调整失败: ${String(e.message ?? e)}`);
    }
    spec.onStarted?.(pane);
    return { pane, session: spec.makeSession({ sessionId: spec.agentName, alive: () => kittyAlive(pane) }) };
  },
  send(pane, text) {
    if (!kittyAlive(pane)) return false;
    // --stdin 避免 send-text 把正文里的反斜杠当作转义序列
    kitten(["send-text", "--match", `id:${pane}`, "--bracketed-paste=enable", "--stdin"], text);
    execSync("sleep 1");
    kitten(["send-key", "--match", `id:${pane}`, "enter"]);
    return true;
  },
  close: (pane) => { kitten(["close-window", "--match", `id:${pane}`]); },
};

// Herdr.app 的 hc 终端。HC_TERMINAL_ID 是当前终端地址；hc 不返回 agent_session，
// pi 用显式 --session-id 定位 JSONL，agy 用 SessionStart 钩子写回的 transcriptPath。
// 后台启动，不调用 herdr-app 分屏/聚焦，用户在 Agents 列表查看。
const hcOut = (args: string[]): any => JSON.parse(execFileSync("hc", args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }));

function hcGet(id: string): any | null {
  try { return hcOut(["get", "--json", id]); } catch (e: any) {
    if (e.status === 3) return null; // not_found
    throw e;
  }
}

// 派发时打标签，ps / close --finished / close --all 靠它与 parent 找回本终端的子代理，不在本地记录派发状态
const HC_SPAWN_LABEL = "spawned-by=spawn-subagent";

type HcSubagent = { id: string; name: string; profile: string; state: "running" | "finished"; ageMs: number };

// 当前终端启动、带派发标签的子代理（含已结束）。hc ls 不返回 parent，逐个 get 过滤
function hcSubagents(): HcSubagent[] {
  const { terminals } = hcOut(["ls", "--all", "--json", "--label", HC_SPAWN_LABEL]);
  const now = Date.now();
  return terminals.flatMap((x: any) => {
    const t = hcGet(x.address);
    if (!t || t.parent !== process.env.HC_TERMINAL_ID) return [];
    return [{
      id: t.address, name: t.name, profile: t.labels?.profile ?? "-",
      state: t.state === "live" ? "running" : "finished", ageMs: now - t.created_ms,
    }];
  });
}

// hc send 是“粘贴并回车”，传错 ID 指到非子代理终端（如用户的 shell）会把任务文本当命令执行，
// 所以 send/close 都只允许操作当前终端自己启动的子终端
function requireHcChild(pane: string) {
  const t = hcGet(pane);
  if (!t) throw new Error(`终端 ${pane} 不存在`);
  if (t.parent !== process.env.HC_TERMINAL_ID) throw new Error(`终端 ${pane} 不是当前终端启动的子终端`);
}

const hcTerm: Term = {
  validate() {
    const id = process.env.HC_TERMINAL_ID!;
    let t: any;
    try { t = hcGet(id); } catch (e: any) {
      throw new Error(`HC_TERMINAL_ID='${id}' 无法查询（${cliError(e)}）`);
    }
    if (!t) throw new Error(`HC_TERMINAL_ID='${id}' 不存在`);
    if (t.state !== "live") throw new Error(`HC_TERMINAL_ID='${id}' 已结束`);
  },
  start(spec) {
    const sessionId = randomUUID();
    let pane: string;
    try {
      const envPairs = [
        ...Object.entries(spec.env).map(([k, v]) => `${k}=${v}`),
        `PATH=${process.env.PATH}`,
      ];
      const out = hcOut([
        "run", "--bg", "--json", "--name", spec.agentName, "--parent", process.env.HC_TERMINAL_ID!, "--cwd", process.cwd(),
        "--label", HC_SPAWN_LABEL, "--label", `profile=${spec.profileLower}`, "--label", `runner=${spec.runner}`,
        // hc run 继承 hc 守护进程的环境，其 PATH 可能没有 mise 安装的 pi/agy；传入主窗口 PATH
        "--", "env", ...envPairs,
        ...spec.execCmd(sessionId),
      ]);
      if (typeof out?.address !== "string") throw new Error("hc run 未返回 address");
      pane = out.address;
    } catch (e: any) {
      throw new Error(`启动失败: ${cliError(e)}`);
    }
    spec.onStarted?.(pane);
    return {
      pane,
      session: spec.makeSession({
        sessionId,
        alive: () => { try { return hcGet(pane)?.state === "live"; } catch { return true; } },
      }),
    };
  },
  send(pane, text) {
    requireHcChild(pane);
    try { execFileSync("hc", ["send", "--json", pane, text], { stdio: "ignore" }); return true; } catch { return false; }
  },
  // kill 同步返回，对已 finished 的终端也成功，再 rm 清理
  close(pane) {
    requireHcChild(pane);
    execFileSync("hc", ["kill", "--json", pane], { stdio: "ignore" });
    execFileSync("hc", ["rm", "--json", pane], { stdio: "ignore" });
  },
};

function cliError(e: any): string {
  try { return JSON.parse(String(e.stderr || e.stdout || ""))?.error?.message ?? String(e.message ?? e); } catch {
    return String(e.stderr || e.message || e).trim();
  }
}

// HC_TERMINAL_ID 优先（Herdr.app 内可能残留已失效的旧 HERDR_PANE_ID），其次旧 Herdr（可能运行在 kitty 内），最后 Kitty
function getTerm(): Term {
  if (process.env.HC_TERMINAL_ID) return hcTerm;
  if (process.env.HERDR_PANE_ID) return herdrTerm;
  if (process.env.KITTY_WINDOW_ID) return kittyTerm;
  throw new Error("需要在 Herdr.app（HC_TERMINAL_ID）、旧 Herdr（HERDR_PANE_ID）或 Kitty（KITTY_WINDOW_ID）中运行");
}
function termOrExit(): Term {
  try { return getTerm(); } catch (e: any) {
    console.error(`spawn-subagent: context-error: ${e.message}`);
    process.exit(1);
  }
}

// 派发前的上下文检查（spawn / batch 共用，失败即退出，调用方尚未启动任何 agent）。
// 失效不回退到其他后端或当前聚焦 pane。
type Context = { term: Term; intercom: string };
function requireContext(): Context {
  const term = termOrExit();
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!intercom) {
    console.error("spawn-subagent: context-error: 需要 PI_INTERCOM_SESSION_ID");
    process.exit(1);
  }
  try { term.validate(); } catch (e: any) {
    console.error(`spawn-subagent: context-error: ${e.message}`);
    process.exit(1);
  }
  return { term, intercom };
}

const agySessionsDir = join(subHome, "tmp", "agy-sessions");

function clearStaleAgyPane(termScope: string, pane: string) {
  if (!existsSync(agySessionsDir)) return;
  for (const f of readdirSync(agySessionsDir).filter((x) => x.endsWith(".json"))) {
    const p = join(agySessionsDir, f);
    const m = readAgyMeta(p);
    if (m && m.termScope === termScope && m.pane === pane) {
      delete m.pane;
      writeAtomicJson(p, m);
    }
  }
}

function isAgyPane(term: Term, paneId: string): boolean {
  if (term === hcTerm) {
    const runner = hcGet(paneId)?.labels?.runner;
    if (runner) return runner === "agy";
  }
  if (!existsSync(agySessionsDir)) return false;
  const scope = currentTermScope();
  for (const f of readdirSync(agySessionsDir).filter((x) => x.endsWith(".json"))) {
    const m = readAgyMeta(join(agySessionsDir, f));
    if (m?.termScope === scope && m.pane === paneId) return true;
  }
  return false;
}

// 复用已有 agent（指定 pane/终端 ID）：注入新任务，不重启、不新建 pane。
// pi 需提醒调 intercom 工具；agy 由 Stop 钩子自动提取末条回复回传，不注入虚假工具名
function resume(paneId: string, task: string) {
  const intercom = process.env.PI_INTERCOM_SESSION_ID;
  if (!intercom) {
    console.error("spawn-subagent: resume 需要 PI_INTERCOM_SESSION_ID");
    process.exit(1);
  }
  const term = termOrExit();
  let agy = false;
  try { agy = isAgyPane(term, paneId); } catch { /* 交给 send 统一报归属或不存在错误 */ }
  const prompt = agy
    ? `（会话延续）新任务（完成后直接在最终回复中输出结论，宿主 Stop 钩子会自动经 intercom 回传主代理）:\n---\n${task}`
    : `（会话延续）新任务，完成后用 intercom 向主代理 session 回传结论（${intercom}），结论第一行标注 [${paneId}] 供对账:\n---\n${task}`;
  let sent: boolean;
  try { sent = term.send(paneId, prompt); } catch (e: any) {
    console.error(`spawn-subagent: resume 被拒绝（${cliError(e)}）: ${paneId}`);
    process.exit(1);
  }
  if (!sent) {
    console.error(`spawn-subagent: resume 注入失败（pane '${paneId}' 未就绪或已关闭）`);
    process.exit(1);
  }
  console.log(paneId);
}

// ps / close --finished / close --all 只支持 hc 后端
function requireHcOrExit(cmd: string): void {
  if (termOrExit() !== hcTerm) {
    console.error(`spawn-subagent: ${cmd} 仅支持 Herdr.app(hc)`);
    process.exit(1);
  }
}

function formatAge(ms: number): string {
  const s = Math.floor(ms / 1000);
  if (s < 60) return `${s}s`;
  if (s < 3600) return `${Math.floor(s / 60)}m`;
  if (s < 86400) return `${Math.floor(s / 3600)}h`;
  return `${Math.floor(s / 86400)}d`;
}

function psAgents(json: boolean) {
  requireHcOrExit("ps");
  const agents = hcSubagents();
  const running = agents.filter((a) => a.state === "running").length;
  if (json) {
    console.log(JSON.stringify(agents.map((a) => ({
      id: a.id, name: a.name, profile: a.profile, state: a.state, ageSeconds: Math.floor(a.ageMs / 1000),
    })), null, 2));
    return;
  }
  const wId = Math.max(2, ...agents.map((a) => a.id.length));
  const wProfile = Math.max(7, ...agents.map((a) => a.profile.length));
  const line = (...c: string[]) => `${c[0].padEnd(wId)}  ${c[1].padEnd(wProfile)}  ${c[2].padEnd(8)}  ${c[3]}`;
  console.log(line("ID", "PROFILE", "STATE", "AGE"));
  for (const a of agents) console.log(line(a.id, a.profile, a.state, formatAge(a.ageMs)));
  console.log(`${running} running, ${agents.length - running} finished`);
}

// 批量关闭：只动当前终端启动且带派发标签的终端
function closeAgents(scope: "finished" | "all") {
  requireHcOrExit(`close --${scope}`);
  const targets = hcSubagents().filter((a) => scope === "all" || a.state === "finished");
  let failed = 0;
  for (const a of targets) {
    try {
      hcTerm.close(a.id);
      console.log(`closed ${a.id} (${a.profile}, ${a.state})`);
    } catch (e: any) {
      failed++;
      console.error(`spawn-subagent: 关闭失败（${cliError(e)}）: ${a.id}`);
    }
  }
  console.log(`${targets.length - failed} closed`);
  if (failed) process.exit(1);
}

// ---------- 健康门 ----------

function sleep(ms: number) {
  return new Promise((r) => setTimeout(r, ms));
}

type SessionEvent = {
  type?: string;
  message?: { role?: string; stopReason?: string; errorMessage?: string };
};

function observeHealth(text: string): HealthObservation {
  let reason = "";
  for (const line of text.trim().split("\n")) {
    let event: SessionEvent;
    try { event = JSON.parse(line); } catch { continue; }
    const message = event.type === "message" ? event.message : null;
    if (message?.role !== "assistant") continue;
    if (message.stopReason !== "error") return { status: "healthy" };
    reason = message.errorMessage || "model error";
  }
  return reason ? { status: "error", reason } : { status: "none" };
}

// agy transcript 中普通工具报错记为 GENERIC + ERROR，不能误判为模型失效；只看 PLANNER_RESPONSE
function observeAgyHealth(text: string): HealthObservation {
  let reason = "";
  for (const line of text.trim().split("\n")) {
    let ev: any;
    try { ev = JSON.parse(line); } catch { continue; }
    if (ev?.type !== "PLANNER_RESPONSE") continue;
    if (ev.status === "DONE") return { status: "healthy" };
    if (ev.status === "ERROR") reason = String(ev.error || ev.content || "agy model error");
  }
  return reason ? { status: "error", reason } : { status: "none" };
}

function extractAgyLogError(logFile: string): string | undefined {
  if (!existsSync(logFile)) return undefined;
  let tail = "";
  try {
    tail = readFileSync(logFile, "utf8").slice(-16384).trim();
  } catch {
    return undefined;
  }
  if (!tail) return undefined;
  const lines = tail.split("\n").map((l) => l.trim()).filter(Boolean);
  for (let i = lines.length - 1; i >= 0; i--) {
    const m = /^AGY_ERROR:\s*(\{.*\})$/.exec(lines[i]);
    if (m) {
      try {
        const obj = JSON.parse(m[1]);
        const parts = [obj.status, obj.error_code !== undefined ? `code=${obj.error_code}` : ""].filter(Boolean);
        if (parts.length) return `AGY_ERROR ${parts.join(" ")}`;
      } catch { /* 保留原始行 */ }
      return lines[i];
    }
  }
  return lines.at(-1);
}

// 配置/认证/额度类错误（含 429 额度用尽与 agy 结构化状态），重试无意义，健康门立即失败。
// 状态码前后不能紧挨字母或数字，否则 request id（req_4012）、耗时（1403ms）会被误判、让可重试的故障直接失败；
// 但下划线要算边界，pi 透传的 `${code}: ${message}` 里 model_not_found、invalid_auth、HTTP_401 都是真实配置错误。
// auth 类词只认 auth/authentication/authorization/unauthenticated 等，避开 author；forbidden/not_found 保持前缀匹配。
const CONFIG_ERROR = /(?<![a-z0-9])(?:400|401|403|404|429)(?![a-z0-9])|(?<![a-z])(?:un)?auth(?:entic[a-z]*|oriz[a-z]*)?(?![a-z])|(?<![a-z])(?:forbidden|not_found|permission_denied|resource_exhausted|quota|rate[_ -]?limit)/i;
const AGY_MODEL_ERROR = /invalid model selection|unsupported model|not recognized as a known model/i;
const isConfigError = (s: string) => CONFIG_ERROR.test(s) || AGY_MODEL_ERROR.test(s);

function checkHealthParser() {
  const msg = (stopReason: string, errorMessage?: string) => JSON.stringify({ type: "message", message: { role: "assistant", stopReason, errorMessage } });
  if (observeHealth(msg("stop")).status !== "healthy") throw new Error("健康签名自检失败");
  if (observeHealth(`${msg("error", "503")}\n${msg("toolUse")}`).status !== "healthy") throw new Error("恢复签名自检失败");
  if (observeHealth(msg("error", "404")).status !== "error") throw new Error("失效签名自检失败");
  const agyToolErr = JSON.stringify({ step_index: 1, type: "GENERIC", status: "ERROR", error: "denied" });
  const agyOk = JSON.stringify({ step_index: 2, type: "PLANNER_RESPONSE", status: "DONE", content: "ok" });
  const agyFail = JSON.stringify({ step_index: 2, type: "PLANNER_RESPONSE", status: "ERROR", error: "429" });
  if (observeAgyHealth(`${agyToolErr}\n${agyOk}`).status !== "healthy") throw new Error("agy 健康签名自检失败");
  if (observeAgyHealth(agyFail).status !== "error") throw new Error("agy 失效签名自检失败");
  if (isConfigError("req_4012 took 1403ms by author")) throw new Error("CONFIG_ERROR 误报自检失败");
  if (!isConfigError("AGY_ERROR RESOURCE_EXHAUSTED code=429")) throw new Error("CONFIG_ERROR agy 命中自检失败");
}

// pi / agy 各自负责瞬时错误重试。健康门只观察同一会话，避免脚本重启 session 造成双重重试。
// 4xx/认证/额度配置错误立即失败；其他错误等到总期限，期间出现新健康响应即恢复。
async function healthGate(session: Session, timeoutMs: number): Promise<{ healthy: boolean; reason?: string } | null> {
  const deadline = Date.now() + timeoutMs;
  let lastErrorText = "";
  while (Date.now() < deadline) {
    const observation = session.observe();
    if (observation.status === "healthy") return { healthy: true };
    if (observation.status === "error") {
      lastErrorText = observation.reason ?? "model error";
      if (isConfigError(lastErrorText)) {
        return { healthy: false, reason: lastErrorText };
      }
    }
    if (session.alive && !session.alive()) {
      return { healthy: false, reason: lastErrorText || session.exitError?.() || "pane exited before model response" };
    }
    await sleep(1000);
  }
  return lastErrorText ? { healthy: false, reason: lastErrorText } : null;
}

// ---------- 单 agent 派发（spawn / batch 共用）----------

type DispatchResult = {
  profile: string;
  pane: string;
  agentName: string;
  healthy: boolean;
  reason?: string;
};

type Launched = {
  term: Term;
  profile: string;
  pane: string;
  agentName: string;
  session: Session;
};

function buildLaunchSpec(agentName: string, profile: string, g: Agent, intercom: string, task: string): LaunchSpec {
  const p = profile.toLowerCase();
  const promptFile = writeAgentBody(p, g.body);
  const scope = currentTermScope();

  if (g.runner === "agy") {
    const metaFile = join(agySessionsDir, `${agentName}.json`);
    const logFile = join(agySessionsDir, `${agentName}.log`);
    writeAtomicJson(metaFile, {
      agentName,
      to: intercom,
      termScope: scope,
      systemFile: promptFile,
      logFile,
    } satisfies AgyMeta);

    const ro = accessOf(g.tools) === "ro";
    const baseArgs = [
      "--model", g.cliModel,
      ...(ro ? ["--mode", "plan"] : []),
      "--dangerously-skip-permissions",
      "--add-dir", process.cwd(),
      "--log-file", logFile,
    ];
    const prompt = `你是通过 spawn-subagent 启动的 agy 子代理（profile: ${profile}，agent: ${agentName}）。

回传协议:
- 完成后直接在最终回复中输出完整结论，宿主 Stop 钩子会自动将你的最终回复加上 [${agentName}] 前缀经 intercom 回传给主代理，无需手动运行任何回传命令。
- 子代理不再派生外部子代理。
- 阻塞或失败时在最终回复中说明原因并停下，保留当前终端供主代理检查。

任务原文:
---
${task}
---`;
    return {
      agentName,
      profileLower: p,
      runner: "agy",
      env: {
        SPAWN_SUBAGENT_META: metaFile,
        SPAWN_SUBAGENT_BUN: process.execPath,
        SPAWN_SUBAGENT_BIN: selfPath,
      },
      execCmd: () => ["agy", ...baseArgs, "-i", prompt],
      herdrArgs: baseArgs,
      prompt,
      onStarted: (pane) => {
        clearStaleAgyPane(scope, pane);
        const m = readAgyMeta(metaFile);
        if (m) writeAtomicJson(metaFile, { ...m, pane });
      },
      makeSession: ({ alive }) => ({
        observe: () => {
          const tx = readAgyMeta(metaFile)?.transcriptPath;
          return tx && existsSync(tx) ? observeAgyHealth(readFileSync(tx, "utf8")) : { status: "none" };
        },
        alive,
        exitError: () => extractAgyLogError(logFile),
      }),
    };
  }

  prepareEnv(g.exclude);
  const baseArgs = [
    "--model", g.cliModel, "--thinking", g.thinking, "--tools", g.tools,
    ...(promptFile ? ["--append-system-prompt", promptFile] : []),
  ];
  const prompt = `你是通过 spawn-subagent 启动的 pi 子代理（profile: ${profile}）。

回传协议:
- 完成或受阻时，用 intercom 工具向主代理 session 发送一条结论消息:
  intercom({ action: "send", to: "${intercom}", message: "<结论>" })
- 结论消息第一行必须是 [${agentName}]（你的 agent 名），供主代理对账。
- 消息格式由下方任务描述，不设固定字段。
- 阻塞或失败时保留当前 pane 供主代理检查，不要自行关闭。

任务原文:
---
${task}
---`;
  return {
    agentName,
    profileLower: p,
    runner: "pi",
    env: { PI_CODING_AGENT_DIR: subHome },
    execCmd: (sessionId) => [...PI_CMD, "--session-id", sessionId, ...baseArgs, "--", prompt],
    herdrArgs: baseArgs,
    prompt,
    onStarted: (pane) => clearStaleAgyPane(scope, pane),
    makeSession: ({ sessionId, herdrStartOut, alive }) => {
      let locate: () => string | null;
      if (herdrStartOut !== undefined) {
        // 会话文件：agent_session.value 形如 ~/.pi/agent/sessions/--cwd--/ts.jsonl；
        // 子代理实际写入 ~/.pi/agent-subagent/sessions/ 同相对段
        const sf = herdrStartOut?.result?.agent?.agent_session?.value;
        const m = typeof sf === "string" ? sf.match(/(sessions\/--[^/]+\/[^/]+\.jsonl)/) : null;
        if (!m) throw new Error("健康门不可用: herdr 未返回可解析的 agent session 路径");
        const file = join(subHome, m[1]);
        locate = () => file;
      } else {
        locate = sessionLocator(sessionId!);
      }
      return {
        observe: () => {
          const f = locate();
          return f && existsSync(f) ? observeHealth(readFileSync(f, "utf8")) : { status: "none" };
        },
        alive,
      };
    },
  };
}

// 阶段一（同步串行）：布局 + 环境 + 启动 + 注入。返回派发信息，不等待模型响应
function launchAgent({ term, intercom }: Context, profile: string, slug: string, task: string): Launched {
  const resolved = resolveAgent(profile);
  if ("error" in resolved) throw new Error(`profile '${profile}' 无法解析（${resolved.error}）`);
  const g = resolved.agent;
  if (!slug.match(/^[a-z0-9-]+$/)) throw new Error(`slug 只能含小写字母/数字/连字符: '${slug}'`);

  const ts = Date.now().toString(36);
  // herdr agent 名必须小写字母开头：profile 统一小写
  const p = profile.toLowerCase();
  const slugBudget = 32 - 1 - ts.length - 1 - p.length;
  let agentName: string;
  if (slugBudget >= 1) {
    agentName = `${p}-${slug.slice(0, slugBudget).replace(/-$/, "")}-${ts}`;
  } else {
    agentName = `${p.slice(0, 32 - 1 - ts.length).replace(/-$/, "")}-${ts}`;
  }
  if (agentName.length > 32) throw new Error(`无法构造 32 字符内的 agent 名（profile='${profile}' slug='${slug}'）`);

  const spec = buildLaunchSpec(agentName, profile, g, intercom, task);
  const { pane, session } = term.start(spec);
  return { term, profile, pane, agentName, session };
}

// 失效分类: 404/401/403/认证/额度/不支持模型属配置错误（重试无意义），其余（503/超时等）为瞬时故障（可重试）
function classifyFailure(reason: string): string {
  return isConfigError(reason)
    ? `config-error: ${reason}`
    : `transient: ${reason}`;
}

// 阶段二（可并发）：独立健康门，等本 agent 的 stopReason:error / 健康 assistant，超时 30s
// 失效时自动关闭 pane（模型失效的 pane 无检查价值，防残留）
async function gateAgent(l: Launched, timeoutMs: number): Promise<DispatchResult> {
  const gate = await healthGate(l.session, timeoutMs);
  const reason = gate && !gate.healthy ? classifyFailure(gate.reason ?? "") : (gate ? undefined : "transient: health-check timeout (no model response)");
  if (reason) {
    try { l.term.close(l.pane); } catch { /* 已关闭 */ }
    return { profile: l.profile, pane: "-", agentName: l.agentName, healthy: false, reason };
  }
  return { profile: l.profile, pane: l.pane, agentName: l.agentName, healthy: true };
}

async function spawn(profile: string, slug: string, task: string) {
  const ctx = requireContext();
  try {
    const r = await gateAgent(launchAgent(ctx, profile, slug, task), 45000);
    if (!r.healthy) {
      console.error(`spawn-subagent: 模型失效（${r.reason}）`);
      process.exit(1);
    }
    console.log(r.pane);
  } catch (e: any) {
    console.error("spawn-subagent: 启动失败:", String(e.message ?? e));
    process.exit(1);
  }
}

// ---------- 任务组合 ----------

function composeTask(sharedTask: string, agentTask: string | undefined): string {
  if (!sharedTask) return agentTask ?? "";
  if (!agentTask) return sharedTask;
  return `${sharedTask}\n\n专项任务:\n---\n${agentTask}`;
}

function checkTaskComposition() {
  if (composeTask("共享背景", "专项分工") !== "共享背景\n\n专项任务:\n---\n专项分工") {
    throw new Error("任务组合自检失败: 共享背景与专项任务未正确组合");
  }
  if (composeTask("共享背景", undefined) !== "共享背景") {
    throw new Error("任务组合自检失败: 仅共享任务时内容发生变化");
  }
  if (composeTask("", "专项分工") !== "专项分工") {
    throw new Error("任务组合自检失败: 仅专项任务时内容发生变化");
  }
}

// ---------- batch 编排 ----------

// json: stdout 只输出一个 JSON 数组，进度与逐行结果走 stderr
// 退出码: 0 全部成功；1 全部失败或派发前失败；2 部分失败（健康的仍在运行，调用方不可整体重试，否则会重复派发）
async function batch(manifestPath: string, json: boolean) {
  let manifest: any;
  try {
    manifest = JSON.parse(readFileSync(manifestPath, "utf-8"));
  } catch (e: any) {
    console.error(`spawn-subagent: manifest 解析失败: ${e.message}`);
    process.exit(1);
  }
  const sharedTask = manifest.task ?? "";
  const rawAgents = manifest.agents;
  if (!Array.isArray(rawAgents) || rawAgents.length === 0) {
    console.error("spawn-subagent: manifest 需要非空 agents 数组");
    process.exit(1);
  }

  // 校验先行：展开 agents 为 {profile, slug, task}，任一无效整体拒绝（零 token）
  const entries: { profile: string; slug: string; task: string }[] = [];
  const errors: string[] = [];
  let cfg: ModelConfig;
  try {
    cfg = loadModelConfig();
  } catch (e: any) {
    console.error(`spawn-subagent: ${e.message}（未派发任何 agent）`);
    process.exit(1);
  }
  for (const a of rawAgents) {
    const profile = typeof a === "string" ? a : a?.profile;
    if (!profile) { errors.push("缺少 profile"); continue; }
    const slugRaw = typeof a === "string" ? undefined : a?.slug;
    const task = typeof a === "string" ? composeTask(sharedTask, undefined) : composeTask(sharedTask, a?.task);
    const slug = slugRaw ?? profile.replace(/^reviewer-/i, "").replace(/[^a-z0-9-]/gi, "-");
    const resolved = resolveAgent(profile, cfg);
    if ("error" in resolved) errors.push(`profile '${profile}' 无效（${resolved.error}）`);
    if (!slug.match(/^[a-z0-9-]+$/)) errors.push(`slug '${slug}' 只能含小写/数字/连字符`);
    if (!task.trim()) errors.push(`profile '${profile}' 的 task 为空`);
    entries.push({ profile, slug, task });
  }
  if (errors.length) {
    console.error(`spawn-subagent: manifest 校验失败（未派发任何 agent）:`);
    for (const err of errors) console.error(`  - ${err}`);
    process.exit(1);
  }

  // 上下文无效则整体退出，不为每个 entry 重复同一失败
  const ctx = requireContext();

  // 两阶段：串行 launchAgent（布局是累积操作必须串行），再并发健康门（互不阻塞）
  const progress = json ? console.error : console.log;
  progress(`spawn-subagent: 派发 ${entries.length} 个 agent...`);
  const launched: { entry: { profile: string; slug: string; task: string }; result: Launched | null; error?: string }[] = [];
  for (const entry of entries) {
    try {
      launched.push({ entry, result: launchAgent(ctx, entry.profile, entry.slug, entry.task) });
    } catch (e: any) {
      launched.push({ entry, result: null, error: String(e.message ?? e) });
    }
  }
  const results = await Promise.all(launched.map(async ({ entry, result, error }) => {
    if (!result) return { profile: entry.profile, pane: "-", agentName: "-", healthy: false, reason: `launch-error: ${error}` };
    return gateAgent(result, 45000);
  }));
  for (const r of results) {
    const line = `${r.profile}\t${r.pane}\t${r.healthy ? "ok" : "failed"}${r.reason ? `  (${r.reason})` : ""}`;
    (r.healthy ? progress : console.error)(line);
  }
  if (json) {
    console.log(JSON.stringify(results.map((r) => r.healthy
      ? { profile: r.profile, id: r.pane, status: "ok" }
      : { profile: r.profile, id: null, status: "failed", reason: r.reason }), null, 2));
  }
  const failed = results.filter((r) => !r.healthy).length;
  process.exit(failed === 0 ? 0 : failed === results.length ? 1 : 2);
}

// ---------- agy 生命周期钩子（SessionStart / Stop）----------

type AgyMeta = {
  agentName: string;
  to: string;
  termScope?: string;
  pane?: string;
  systemFile?: string;
  logFile?: string;
  rootConversationId?: string;
  transcriptPath?: string;
  lastDeliveredKey?: string;
};

function writeAtomicJson(file: string, data: unknown) {
  mkdirSync(dirname(file), { recursive: true });
  const tmp = `${file}.${process.pid}.${randomUUID().slice(0, 6)}.tmp`;
  writeFileSync(tmp, JSON.stringify(data, null, 2) + "\n");
  renameSync(tmp, file);
}

function readAgyMeta(file: string): AgyMeta | null {
  try {
    const m = JSON.parse(readFileSync(file, "utf8"));
    return m && typeof m === "object" ? m : null;
  } catch {
    return null;
  }
}

function resolveIntercomCli(): string | null {
  const home = homedir();
  const xdg = process.env.XDG_DATA_HOME?.trim();
  const candidates = [
    join(home, ".pi/agent/npm/node_modules/pi-intercom/cli.ts"),
    ...(xdg && existsSync(join(xdg, "omp")) ? [join(xdg, "omp/plugins/node_modules/pi-intercom/cli.ts")] : []),
    join(home, ".omp/plugins/node_modules/pi-intercom/cli.ts"),
  ];
  return candidates.find((p) => existsSync(p)) ?? null;
}

function runAgyHook(kind: string) {
  let raw = "";
  try { raw = readFileSync(0, "utf8"); } catch { /* stdin 已关闭 */ }
  const metaFile = process.env.SPAWN_SUBAGENT_META?.trim();
  if (!metaFile || !existsSync(metaFile)) {
    console.log("{}");
    return;
  }
  let input: any = {};
  try { input = raw.trim() ? JSON.parse(raw) : {}; } catch {
    console.log("{}");
    return;
  }
  const meta = readAgyMeta(metaFile);
  if (!meta) {
    console.log("{}");
    return;
  }

  if (kind === "session-start") {
    // 锁定首个会话为根会话：agy 内部若再派生子代理会继承环境变量，但 conversationId 不同，不能覆盖根会话或重复注入
    if (!meta.rootConversationId && typeof input.conversationId === "string" && input.conversationId) {
      meta.rootConversationId = input.conversationId;
      if (typeof input.transcriptPath === "string") meta.transcriptPath = input.transcriptPath;
      writeAtomicJson(metaFile, meta);
      if (meta.systemFile && existsSync(meta.systemFile)) {
        const sys = readFileSync(meta.systemFile, "utf8").trim();
        if (sys) {
          console.log(JSON.stringify({ injectSteps: [{ systemMessage: { systemMessage: sys } }] }));
          return;
        }
      }
    }
    console.log("{}");
    return;
  }

  if (kind === "stop") {
    if (
      !meta.rootConversationId
      || input.conversationId !== meta.rootConversationId
      || !input.fullyIdle
      || input.terminationReason === "USER_CANCELED"
    ) {
      console.log("{}");
      return;
    }
    const txCompact = typeof input.transcriptPath === "string" && input.transcriptPath
      ? input.transcriptPath
      : meta.transcriptPath;
    if (!txCompact) {
      console.log("{}");
      return;
    }
    // transcript.jsonl 会截断长字段，同目录 transcript_full.jsonl 保存完整正文
    const txFull = txCompact.replace(/transcript\.jsonl$/, "transcript_full.jsonl");
    const txFile = existsSync(txFull) ? txFull : txCompact;
    if (!existsSync(txFile)) {
      console.log("{}");
      return;
    }

    let lastUserStep = -1;
    let finalStep: { idx: number; content: string } | null = null;
    for (const line of readFileSync(txFile, "utf8").trim().split("\n")) {
      let ev: any;
      try { ev = JSON.parse(line); } catch { continue; }
      const idx = typeof ev?.step_index === "number" ? ev.step_index : -1;
      if (ev?.type === "USER_INPUT" && idx > lastUserStep) {
        lastUserStep = idx;
        finalStep = null;
      } else if (ev?.type === "PLANNER_RESPONSE" && idx > lastUserStep && typeof ev.content === "string" && ev.content.trim()) {
        finalStep = { idx, content: ev.content.trim() };
      }
    }

    let dedupKey: string;
    let body: string;
    if (finalStep) {
      dedupKey = `${meta.rootConversationId}:step:${finalStep.idx}`;
      body = input.terminationReason === "ERROR" && input.error
        ? `${finalStep.content}\n\n[AGY ERROR: ${String(input.error)}]`
        : finalStep.content;
    } else if (input.terminationReason && input.terminationReason !== "NO_TOOL_CALL") {
      dedupKey = `${meta.rootConversationId}:err:${lastUserStep}:${String(input.terminationReason)}`;
      body = `[STOPPED: ${String(input.terminationReason)}] ${String(input.error || "(no assistant response)")}`;
    } else {
      console.log("{}");
      return;
    }

    if (meta.lastDeliveredKey === dedupKey) {
      console.log("{}");
      return;
    }

    const cli = resolveIntercomCli();
    if (cli && meta.to) {
      try {
        execFileSync(process.execPath, [
          cli, "send", "--to", meta.to, "--name", meta.agentName, "--text", `[${meta.agentName}]\n${body}`,
        ], { stdio: "ignore" });
        meta.lastDeliveredKey = dedupKey;
        writeAtomicJson(metaFile, meta);
      } catch { /* 主会话已退出或 broker 不可达时不阻断 agy 退出 */ }
    }
    console.log("{}");
    return;
  }

  console.log("{}");
}

// ---------- main ----------
const [c0, c1, ...rest] = process.argv.slice(2);
if (c0 === "_agy-hook") {
  runAgyHook(c1 ?? "");
} else if (!c0 || c0 === "-h" || c0 === "--help") {
  usage();
} else if (c0 === "batch") {
  const args = process.argv.slice(3);
  const manifest = args.find((a) => !a.startsWith("--"));
  if (!manifest) {
    console.error("spawn-subagent: batch 需要 manifest 文件路径");
    process.exit(1);
  }
  await batch(manifest, args.includes("--json"));
} else if (c0 === "list") {
  const flags = process.argv.slice(3);
  listAgents({ verbose: flags.includes("-v"), json: flags.includes("--json") });
} else if (c0 === "--check") {
  checkHealthParser();
  checkTaskComposition();
  prepareEnv(config.exclude ?? []);
  console.log("健康门签名自检通过");
  console.log(`派生 settings.json 就绪: ${join(homedir(), ".pi", "agent-subagent", "settings.json")}`);
  console.log(`全局排除 exclude(subagent-config.json 统一生效): ${JSON.stringify(config.exclude ?? [])}\n`);
  listAgents();
} else if (c0 === "ps") {
  psAgents(process.argv.slice(3).includes("--json"));
} else if (c0 === "close") {
  if (!c1) {
    console.error("spawn-subagent: close 需要 id、--finished 或 --all");
    process.exit(1);
  }
  if (c1 === "--finished" || c1 === "--all") {
    closeAgents(c1 === "--all" ? "all" : "finished");
  } else {
    try {
      const term = termOrExit();
      term.close(c1);
      term.focusMain?.();
      console.log(`closed ${c1}`);
    } catch (e: any) {
      console.error(`spawn-subagent: 关闭失败（${cliError(e)}）: ${c1}`);
      process.exit(1);
    }
  }
} else if (c0 === "resume") {
  const sep = process.argv.indexOf("--");
  const task = sep >= 0 ? process.argv.slice(sep + 1).join(" ") : rest.join(" ");
  if (!c1 || !task.trim()) {
    usage();
    process.exit(1);
  }
  resume(c1, task);
} else {
  const sep = process.argv.indexOf("--");
  const task = sep >= 0 ? process.argv.slice(sep + 1).join(" ") : rest.join(" ");
  if (!c1 || !task.trim()) {
    usage();
    process.exit(1);
  }
  await spawn(c0, c1, task);
}