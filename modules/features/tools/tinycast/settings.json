{
  "general": {
    "launcherShortcut": "cmd+space",
    "showInMenuBar": true,
    "automaticallyCheckForUpdates": true,
    "popToRootSeconds": 0,
    "escapeKeyBehavior": "navigateBackOrClose",
    "autoSwitchInputSource": "com.apple.keylayout.ABC",
    "supportReminders": false,
    "language": "zh-Hans"
  },
  "appearance": {
    "theme": "system",
    "animations": true,
    "interfaceSize": "large",
    "compactMode": true,
    "compactBarCommands": [
      "command:clipboard-history",
      "command:search-emoji",
      "command:search-files",
      "command:search-quicklinks"
    ],
    "followCursorAcrossDisplays": true,
    "dragToReposition": false
  },
  "hyperKey": {
    "key": "none",
    "includesShift": true,
    "quickPress": "none",
    "secureInputCompatibility": false
  },
  "calculator": {
    "numberStyle": "system"
  },
  "search": {
    "showsSuggestions": true,
    "sensitivity": "medium"
  },
  "applications": {
    "enabled": true,
    "searchScopes": [
      "/Applications",
      "/Applications/Utilities",
      "/System/Applications",
      "/System/Applications/Utilities",
      "/System/Library/CoreServices/Applications",
      "/System/Volumes/Preboot/Cryptexes/App/System/Applications",
      "/System/Library/CoreServices/Finder.app",
      "~/Applications"
    ],
    "apps": {
      "com.apple.finder": {
        "shortcut": "option+f",
        "alias": null,
        "showInLauncher": true
      },
      "com.tencent.xinWeChat": {
        "shortcut": "option+w",
        "alias": null,
        "showInLauncher": true
      },
      "dev.zed.Zed": {
        "shortcut": "option+c",
        "alias": null,
        "showInLauncher": true
      },
      "net.kovidgoyal.kitty": {
        "shortcut": "option+shift+return",
        "alias": null,
        "showInLauncher": true
      }
    }
  },
  "systemSettings": {
    "enabled": true,
    "panes": {}
  },
  "systemActions": {
    "enabled": true,
    "actions": {}
  },
  "commands": {
    "builtInEnabled": true,
    "builtIn": {},
    "enabled": true,
    "showInLauncher": true
  },
  "quicklinks": {
    "enabled": true,
    "showInLauncher": true,
    "opensNewWindow": false,
    "passesSelectedText": false,
    "confirmsBeforeDelete": true,
    "commands": {}
  },
  "appleShortcuts": {
    "enabled": false
  },
  "ai": {
    "enabled": true,
    "webSearch": false,
    "choices": true,
    "expandsReasoning": false,
    "systemPrompt": "",
